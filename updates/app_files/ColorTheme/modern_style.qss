/* 
 * the PLUS Piping - Global Modern Stylesheet Template
 * Placeholders like {{bg-100}} will be replaced by ThemeManager at runtime.
 */

/* 기본 배경 및 텍스트 */
QMainWindow {
    background-color: {{bg-100}};
    color: {{text-100}};
    font-weight: normal;
}

ProjectExplorer {
    background-color: {{bg-200}};
    border-radius: 0px;
    border-right: 1px solid {{border-100}};
    color: {{text-100}};
    font-weight: normal;
}

/* 수직 스크롤바 본체 */
QScrollBar:vertical {
    border: none;
    background: rgba(148, 163, 184, 0.1);
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

/* 스크롤바 핸들 (움직이는 부분) */
QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.4);
    min-height: 20px;
    border-radius: 4px;
    margin: 2px;
}

/* 핸들 호버 효과 */
QScrollBar::handle:vertical:hover {
    background: rgba(148, 163, 184, 0.6);
}

/* 상하단 화살표 버튼 제거 */
QScrollBar::add-line:vertical, 
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 핸들 위아래 빈 공간(페이지 이동 영역) */
QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical {
    background: transparent;
}


#popup_container {
    background-color: rgba(7, 26, 26, 0.6);
    border: 2px solid {{border-400}};
    border-radius: 16px;
}

/* ============ Weather Detail Popup ============ */
.DetailCalIcon { color: #4dd0e1; font-family: "{{font-icon}}" !important; font-size: 14px; }
.DetailDate { color: #a0a0a0; font-size: 13px; font-weight: bold; letter-spacing: 1px; }

.DetailMainIcon { color: #4dd0e1; font-family: "{{font-icon}}" !important; font-size: 64px; }
.DetailMainTemp { color: #ffffff; font-size: 48px; font-weight: bold; }
.DetailDesc { color: #4dd0e1; font-size: 16px; font-weight: bold; margin-left: 85px; }

.DetailLocIcon { color: #a0a0a0; font-family: "{{font-icon}}" !important; font-size: 14px; }
.DetailLoc { color: #a0a0a0; font-size: 13px; }

.SiteBadge {
    background-color: rgba(77, 208, 225, 0.2);
    color: #4dd0e1;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: bold;
}

.StatTitle { color: #6e6e6e; font-size: 10px; font-weight: bold; }
.StatValue { color: #ffffff; font-size: 15px; font-weight: bold; }

.DetailDivider { background-color: rgba(255,255,255,0.05); max-height: 1px; }
.DetailHeader { color: #ffffff; font-size: 15px; font-weight: bold; letter-spacing: 1px; }

.NavArrow {
    background-color: #0d2a2a;
    color: #4dd0e1;
    border: none;
    border-radius: 8px;
    font-family: "{{font-icon}}" !important;
    font-size: 16px;
}
.NavArrow:hover {
    background-color: {{text-300}};
    color: {{primary-100}};
    border-color: {{primary-100}};
}

#pill_dot { background-color: #4dd0e1; border-radius: 2px; }
.WeatherPillsContainer { background-color: transparent; }
/* ============ Weather Detail Popup End ============ */

#workspace {
    background-color: {{bg-300}};
    color: {{text-100}};
    font-weight: normal;
    border-radius: 0px;
}

#container {
    background-color: {{bg-100}};
    color: {{text-100}};
    border-radius: 8px;
}

QFrame#explorer_wrapper {
    background-color: {{bg-300}};
    border-radius: 0px;
    color: {{text-100}};
    padding: 0px; 
    border-top: none;
    font-weight: normal;
}

QStatusBar {
    background-color: {{bg-200}};
    border-radius: 0px;
    color: {{text-100}};
    padding: 10px; 
    border-top: 1px solid {{border-100}};
    font-weight: normal;
}

QLabel { 
    background-color: transparent; 
    color: {{text-100}}; 
}

/* ============ PropertyEditDialog ============ */
QDialog#PropertyEditDialog, QDialog[class="PropertyEditDialog"] {
    background-color: transparent;
}

QFrame#PropertyEditDialogBackdrop, QFrame[class="PropertyEditDialogBackdrop"] {
    background-color: rgba(0, 0, 0, 150);
}

QFrame#PropertyEditDialogContainer, QFrame[class="PropertyEditDialogContainer"] {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

QFrame#PropertyEditDialogContainer, QFrame[class="PropertyEditDialogContent"] {
    background-color: {{bg-100}};
}

QFrame#PropertyEditDialogHeader, QFrame[class="PropertyEditDialogHeader"] {
    border-bottom: 1px solid {{border-100}};
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    background-color: {{bg-200}};
}

QFrame#PropertyEditDialogFooter, QFrame[class="PropertyEditDialogFooter"] {
    border-top: 1px solid {{border-100}};
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: {{bg-200}};
}

QLabel#PropertyEditDialogTitle, QLabel[class="PropertyEditDialogTitle"] {
    color: {{text-200}};
    font-size: 20px;
    font-weight: bold;
}

/* PropertyEditDialog section styling */
QFrame.PropertyEditDialogSection {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 10px;
    padding: 10px;
}

QPushButton.MarkerButton, QPushButton[class="MarkerButton"] {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-100}};
}
QPushButton.MarkerButton:hover, QPushButton[class="MarkerButton"]:hover {
    background-color: {{bg-400}};
}
QPushButton.MarkerButton:checked, QPushButton[class="MarkerButton"]:checked {
    background-color: rgba(92, 130, 157, 0.2);
    border: 2px solid {{primary-100}};
    color: {{text-200}};
}

QHeaderView::section {
    background-color: {{bg-300}};
    color: {{text-100}};
    padding: 6px;
    border: none;
    border-right: 1px solid {{bg-200}};
    border-bottom: 1px solid {{bg-200}};
    font-weight: bold;
}
/* ============ 리스트뷰 ============ */
QListWidget, QListView, QTreeView {
    color: {{text-200}};
    background-color: {{bg-200}};
    selection-background-color: {{primary-100}};
    border: 1px solid {{border-100}} !important;
    border-radius: 4px;
    padding: 1px;
    outline: none;
}

QListWidget::item, QListView::item, QTreeView::item {
    padding: 2px 6px;
    border-radius: 0px;
    margin: 0;
    border: none;
}

QListWidget::item:hover, QListView::item:hover, QTreeView::item:hover {
    background-color: {{bg-400}};
    color: {{text-100}};
}

QListWidget::item:selected, QListView::item:selected, QTreeView::item:selected {
    background-color: {{primary-100}};
    color: #ffffff;
}

QTreeView::branch:selected {
    background-color: {{primary-100}};
}

/* ============ 버튼 ============ */
QPushButton {
    background-color: {{bg-200}};
    color: {{text-100}};
    border: 2px solid transparent;
    border-radius: 5px;
    padding: 6px 12px;
    min-height: 4px;
    outline: none;
}

QPushButton:hover { background-color: {{bg-300}}; }
QPushButton:pressed { background-color: {{primary-100}}; color: #FFFFFF; }
QPushButton:focus { border: 2px solid {{primary-100}}; }
QPushButton:checked { background-color: {{accent-100}}; color: #FFFFFF; font-weight: bold; }
QPushButton:checked:hover { background-color: {{accent-100}}; opacity: 0.8; }

/* ============ SetupWizard ============ */
QWidget#SetupWizard {
    background-color: #14171F;
    border: none;
}

QWidget#SetupWizard QFrame#SetupPathCard {
    background-color: #1b1f2a;
    border: 1px solid #2a3142;
    border-radius: 10px;
}

QWidget#SetupWizard QProgressBar,
QWidget#SetupWizard QProgressBar#SetupProgressBar {
    border: 1px solid #2f3648;
    border-radius: 5px;
    background-color: #252a36;
    color: #d1d1d1;
    text-align: center;
}

QWidget#SetupWizard QProgressBar::chunk,
QWidget#SetupWizard QProgressBar#SetupProgressBar::chunk {
    background-color: #3498db;
    border-radius: 5px;
}

QTextEdit#LogView {
    background-color: #0d0f14;
    color: #d1d1d1;
    border: 1px solid #2a3142;
    border-radius: 8px;
    font-family: "Consolas", "NanumGothicCoding", "나눔고딕 코딩";
}

QLineEdit#PathEdit {
    background-color: #1a1f2a;
    color: #d1d1d1;
    border: 1px solid #2a3142;
    border-radius: 8px;
    padding: 8px;
}

QLineEdit#PathEdit:focus {
    border: 1px solid #3498db;
}

QPushButton#PrimaryButton {
    background-color: #3498db;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 700;
}

QPushButton#PrimaryButton:hover {
    background-color: #2b88c4;
}

QPushButton#PrimaryButton:pressed {
    background-color: #236e9f;
}
/* ============ SetupWizard End ============ */
QPushButton:disabled { background-color: {{bg-300}}; color: {{text-200}}; }

/* ============ 콤보박스 ============ */
QComboBox {
    font-size: 10px;
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    color: {{text-100}};
    border-radius: 5px;
    padding: 6px 8px;
    min-height: 28px;
}
QComboBox:hover { border: 1px solid {{primary-100}}; }
QComboBox:focus { border: 2px solid {{primary-100}}; padding: 5px 7px; }
QComboBox::drop-down { border: none; width: 30px; }
QComboBox::down-arrow { image: none; width: 12px; height: 12px; }

QComboBox QAbstractItemView {
    margin-top: 0px;
}

/* ============ PlusMultiHeaderTable & TableComboBox (Excel-style) ============ */
QFrame#mainTable, QFrame#frozenTable {
    border: none;
    background-color: transparent;
    outline: none;
}
QFrame#mainTable { background-color: {{bg-100}}; }
QFrame#frozenTable { background-color: {{bg-200}}; }

#frozenSeparator {
    background-color: {{primary-100}};
    min-width: 3px;
    border-left: 1px solid {{primary-100}}99;
    border-right: 1px solid {{primary-100}}44;
}

/* Header Labels */
QLabel[type="group"], QLabel[type="detail"], ClickableHeaderLabel[type="detail"] {
    background-color: {{bg-200}};
    color: {{text-300}}; /* Orange accent for headers */
    font-weight: 700;
    font-size: 10pt;
    border: none;
    border-right: 1px solid {{border-100}};
    padding: 2px;
}
QLabel[type="group"] { border-bottom: 1px solid {{border-100}}; }
QLabel[type="detail"], ClickableHeaderLabel[type="detail"] { border-bottom: 3px solid {{border-100}}; }
ClickableHeaderLabel[type="detail"]:hover {
    background-color: {{bg-400}};
    border-bottom: 3px solid {{primary-100}};
}

/* Table Specific ScrollBars */
QScrollBar#tableVerticalScrollBar:vertical, 
QScrollBar#tableHorizontalScrollBar:horizontal {
    background: {{bg-200}};
    border: 1px solid {{border-100}};
}
QScrollBar#tableVerticalScrollBar:vertical { width: 6px; border-top: none; border-bottom: none; border-right: none; }
QScrollBar#tableHorizontalScrollBar:horizontal { height: 6px; border-left: none; border-right: none; border-bottom: none; }

QScrollBar#tableVerticalScrollBar::handle:vertical,
QScrollBar#tableHorizontalScrollBar::handle:horizontal {
    background: {{primary-100}};
    border-radius: 3px;
    margin: 1px;
}
QScrollBar#tableVerticalScrollBar::handle:vertical:hover,
QScrollBar#tableHorizontalScrollBar::handle:horizontal:hover {
    background: {{primary-200}};
}

/* Table ComboBox Styling */
QComboBox[class="TableComboBox"] {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    border-radius: 0px;
    padding: 0px 6px;
    font-size: 10pt;
}

QComboBox[class="TableComboBox"]:hover, 
QComboBox[class="TableComboBox"]:focus {
    background-color: rgba(255, 255, 255, 0.05);
}

/* Row Selection State */
QComboBox[class="TableComboBox"][selected="true"] {
    background-color: {{primary-100}}33; /* Highlights the cell within the selected row */
    color: {{text-200}};
}

/* Data Interaction States */
QComboBox[class="TableComboBox"][aiUpdated="true"] {
    background-color: rgba(0, 133, 255, 0.12); /* Subtle glow for AI updated cells */
}

QComboBox[class="TableComboBox"]::drop-down {
    border: none;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background: transparent;
    width: 20px;
}

QComboBox[class="TableComboBox"]::down-arrow {
    image: none; /* We draw a custom chevron in PlusComboBox.paintEvent */
    width: 0px;
    height: 0px;
}

QComboBox[class="TableComboBox"] QAbstractItemView {
    background-color: {{bg-100}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    outline: none;
    font-size: 10pt;
    padding: 4px;
}

QComboBox[class="TableComboBox"] QAbstractItemView::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QComboBox[class="TableComboBox"] QAbstractItemView::item:selected {
    background-color: {{primary-100}};
    color: white;
}

QComboBox[class="TableComboBox"] QLineEdit {
    background: transparent;
    border: none;
    color: inherit;
    padding: 0px;
}

#plusTitleBar {
    background-color: {{bg-100}};
    border-bottom: 1px solid {{border-100}};
}

#logo_widget {
    background: transparent;
    border: none;
    border-radius: 0px;
    margin-left: 4px;
}

#search_frame {
    background-color: {{bg-200}};
    border: 1px solid {{border-200}};
    border-radius: 8px;
    padding: 2px 12px;
}

#search_edit {
    background-color: transparent;
    color: {{text-200}};
    border: none;
    outline: none;
    font-family: 'Noto Sans KR';
    font-size: 10pt;
}

#clear_search_btn {
    background: transparent;
    border: none;
    border-radius: 6px;
}
#clear_search_btn:hover { background-color: rgba(255, 255, 255, 0.08); }
#clear_search_btn QLabel { color: {{text-100}}; font-family: "{{font-icon}}" !important; font-size: 18px; }
#clear_search_btn:hover QLabel { color: #FFFFFF; }

/* Title Bar Context Buttons */
QPushButton[objectName^="title_btn_"] {
    background: transparent;
    color: {{text-200}};
    border: none;
    border-radius: 6px;
}
QPushButton[objectName^="title_btn_"]:hover { background-color: rgba(255, 255, 255, 0.1); }
QPushButton[objectName^="title_btn_"]:checked { background-color: rgba(0, 133, 255, 0.15); }

/* Internal Labels in context buttons */
QPushButton[objectName^="title_btn_"] QLabel { 
    color: {{text-200}}; 
    font-family: "{{font-icon}}" !important; 
    font-size: 18px; 
    background: transparent;
}

/* Helper specific button overrides */
QPushButton#title_btn_help QLabel, QPushButton#title_btn_setting QLabel {
    font-size: 18px;
}

/* ============ Nav Frame (Segmented Control) ============ */
#nav_frame {
    background-color: {{bg-300}};
    border: 1px solid {{border-200}};
    border-radius: 8px;
}

QPushButton.NavButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: {{text-200}};
    padding: 0px 6px;
}
QPushButton.NavButton:hover { background-color: rgba(255, 255, 255, 0.05); color: white; }
QPushButton.NavButton:checked { background-color: {{primary-100}}; color: white; }

QPushButton.NavButton QLabel {
    color: {{text-200}};
    font-family: 'Noto Sans KR';
    font-size: 11pt;
    font-weight: bold;
    background: transparent;
}
QPushButton.NavButton QLabel.Icon {
    color: {{text-200}};
    font-family: "{{font-icon}}" !important;
    font-size: 18px !important;
    margin-right: 8px;
    background: transparent;
}

/* Window Buttons (Traffic Lights) */
#win_btn_min, #win_btn_max, #win_btn_close {
    border-radius: 8px;
    border: none;
}
#win_btn_min { background-color: #febc2e; }
#win_btn_min:hover { background-color: #e1a116; }
#win_btn_max { background-color: #28c940; }
#win_btn_max:hover { background-color: #12a024; }
#win_btn_close { background-color: #ff5f57; }
#win_btn_close:hover { background-color: #e04845; }

/* ============ Icons ============ */
.Icon {
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
}

.Icon[active="true"] { color: white; }
.Icon[active="false"] { color: {{text-100}}; }

.Icon_18 {
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
}

.Icon_18[active="true"] { color: white; }
.Icon_18[active="false"] { color: {{text-100}}; }

.Icon_primary {
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
    color: {{primary-100}};
}

.Icon_primary[active="true"] { color: {{primary-100}}; }
.Icon_primary[active="false"] { color: {{text-100}}; }

#ActionButton, #ProjectExplorerIconButton, #ExplorerMoreBtn, #btn_home, #sync_refresh {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: {{text-200}};
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
    padding: 2px;
}

#ActionButton:hover, #ProjectExplorerIconButton:hover, #ExplorerMoreBtn:hover, #btn_home:hover, #sync_refresh:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
}

/* ============ Project Explorer ============ */
#MainContainer { 
    background-color: {{bg-100}}; 
    border: none;
}

#ExplorerPanel { 
    background-color: {{bg-400}}; 
    border: none;
}

#ExplorerHeader { 
    border: none;
    border-bottom: 1px solid {{border-100}};
}

#ExplorerScrollContent, #ExplorerScrollArea { 
    background-color: {{bg-300}};
    border: none;
}

#AppTitle { color: {{text-200}}; font-size: 20px; font-weight: bold; }
#AppSubTitle { color: {{text-100}}; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; }

/* ============ WeldJointLog ============ */
#WeldJointLog {
    background-color: {{bg-100}};
    color: {{text-100}};
}

#WeldJointLogHeader {
    background-color: {{bg-200}};
    border-bottom: 1px solid {{border-100}};
}

#WeldJointLogAccent {
    background-color: {{primary-100}};
    border-radius: 3px;
}

#WeldJointLogTitle {
    color: {{text-100}};
    font-weight: 700;
}

#WeldJointLogSubtitle {
    color: {{text-200}};
    font-size: 9px;
}

#WeldJointLogContainer {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
}

#WeldJointLogBtnState, #WeldJointLogBtnClose,
.WeldJointLogIconButton {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
    min-width: 32px;
    min-height: 32px;
}

#WeldJointLogBtnState:hover, #WeldJointLogBtnClose:hover,
.WeldJointLogIconButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: {{primary-100}};
}

.StatusMessage {
    color: {{text-100}};
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 13px;
}

.SummaryBadge {
    background-color: {{bg-200}};
    border: 1px solid {{border-200}};
    border-radius: 6px;
    padding: 0 10px;
}

.SummaryBadgeIndicator {
    background-color: {{primary-100}};
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

.SummaryBadgeLabel {
    color: {{text-200}};
    font-weight: 700;
}

.SummaryBadgeValue {
    color: {{text-100}};
    font-weight: 800;
}

#SearchBox {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: white;
    padding: 8px 12px;
    font-size: 13px;
}
#SearchBox:focus {
    border: 1px solid {{primary-100}};
}

#ActionToolbar {
    background-color: {{bg-200}};
    border-top: 1px solid {{border-100}};
}

#ActionLabel {
    color: {{text-100}};
    font-size: 9px;
    font-weight: 500;
}

#ActionButton[class="Danger"]:hover {
    background-color: rgba(248, 113, 113, 0.1);
    color: #f87171;
}

.ExplorerItemHeaderTitle {
    font-size: 13px;
    font-weight: 700;
}
.ExplorerItemHeaderTitle[active="true"] { color: {{text-300}}; }
.ExplorerItemHeaderTitle[active="false"] { color: {{text-200}}; }

.ExplorerItemTitle {
    font-size: 11px;
    font-weight: 500;
}
.ExplorerItemTitle[active="true"] { color: #FFFFFF; }
.ExplorerItemTitle[active="false"] { color: {{text-200}}; }

.ExplorerItemDesc {
    font-size: 11px;
}
.ExplorerItemDesc[active="true"] { color: rgba(255, 255, 255, 0.7); }
.ExplorerItemDesc[active="false"] { color: {{text-100}}; }

.ExplorerBadge {
    padding: 2px 4px;
    border-radius: 4px;
    font-size: 9px;
    font-weight: bold;
    color: white;
    qproperty-alignment: 'AlignCenter';
    min-height: 12px;
    min-width: 55px;
}
.ExplorerBadge[status="ongoing"] { background-color: {{primary-100}}; }
.ExplorerBadge[status="completed"] { background-color: {{green-100}}; }
.ExplorerBadge[status="onhold"] { background-color: {{yellow-100}}; }
.ExplorerBadge[status="cancelled"] { background-color: {{rose-100}}; }
.ExplorerBadge[status="contracted"] { background-color: #3b82f6; }
.ExplorerBadge[status="awaiting"] { background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.15); }
.ExplorerBadge[status="default"] { background-color: {{bg-300}}; }

#WorkOrderItem[active="true"] { 
    background-color: {{primary-100}}; 
    border-radius: 10px; 
}
#WorkOrderItem:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
}
#WorkOrderItem[active="true"]:hover {
    background-color: {{primary-100}};
}

#ProjectGroupFolderIcon { 
    font-family: "{{font-icon}}" !important; 
    font-size: 18px !important; }
#ProjectGroupFolderIcon[open="true"] { color: {{primary-100}}; }
#ProjectGroupFolderIcon[open="false"] { color: {{text-100}}; }

#ProjectGroupChevron { 
    font-family: "{{font-icon}}" !important; 
    font-size: 18px !important; 
    color: {{text-300}}; }

#ProjectGroupHeader[selected="true"] {
    border-left: 3px solid {{text-300}};
    padding-left: 8px;
}

#ProjectGroupHeader[parentActive="true"] {
    border-left: 3px solid rgba(255,255,255,0.2);
    padding-left: 8px;
}

#ExplorerIndentLine {
    border-left: 1.5px solid {{border-100}};
    margin-left: 14px;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* ============ Popup Menus ============ */
#MorePopupMenuContainer { background: transparent; }
#RoundedMenuFrame { background-color: #1e1e1e; border: 1px solid {{border-200}}; border-radius: 8px; }

.MenuActionButton {
    background-color: transparent;
    border: none;
    padding: 0px 16px;
}
.MenuActionButton:hover { background-color: rgba(255, 255, 255, 0.1); }
.MenuActionButton:hover QLabel { color: white; }

#MenuActionIcon { color: {{text-100}}; font-size: 18px; }
#MenuActionText { color: {{text-200}}; font-size: 12px; }

#MenuSeparator {
    background-color: {{border-100}};
    max-height: 1px;
    margin: 4px 16px;
}

/* ============ Plus Horizontal Navbar ============ */
#PlusHorizontalNavbar {
    background-color: {{bg-300}};
    border-bottom: 1px solid {{border-100}};
}

.nav_icon {
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
    color: {{text-100}};
}

.breadcrumb_text { color: {{text-300}}; font-family: 'Noto Sans KR'; font-size: 13px; margin: 0px 0px; }
.breadcrumb_active { color: {{text-200}}; font-family: 'Noto Sans KR'; font-size: 13px; font-weight: bold; margin: 0px 0px; }
.breadcrumb_sep { color: {{text-100}}; font-family: "{{font-icon}}" !important; font-size: 14px; margin: 0px 2px; }

/* ============ Weather Item ============ */

#main_weather_icon {
    color: #4dd0e1;
}


#weather_pill {
    background-color: rgba(10, 34, 34, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 35px;
}
#pill_time {
    color: #a0a0a0;
    font-size: 8pt;
    font-weight: bold;
}
#pill_icon {
    color: #4dd0e1;
}
#pill_temp {
    color: #ffffff;
}

#weather_widget {
    background-color: {{bg-100}}; 
    border-radius: 6px; /* Rounded corners for the strip */
    border: 1px solid {{border-100}};
}

#weather_item {
    background-color: transparent; 
    border-radius: 0px; 
}
#weather_item:hover {
    background-color: rgba(255, 255, 255, 0.05); 
}
#weather_item_active {
    background-color: {{primary-100}};
    border-radius: 4px;
}
#weather_sep {
    background-color: {{border-200"}};
    min-height: 20px;
    margin-top: 10px;
    margin-bottom: 10px;
}

QLabel[class="weather_date"] { color: {{text-400}}; font-size: 12px; font-weight: normal; }
QLabel[class="weather_date_active"] { color: {{text-300}} ; font-size: 12px; font-weight: bold; }
QLabel[class="weather_temp"] { color: {{text-100}}; font-size: 10px; font-weight: bold; }
QLabel[class="weather_temp_active"] { color: {{text-200}}; font-size: 10px; font-weight: bold; }
QLabel[class="weather_icon"] { color: {{text-300}}; font-family: "{{font-icon}}" !important; font-size: 20px; }
QLabel[class="weather_icon"][active="true"] { color: {{text-200}}; }
QLabel[class="weather_icon"][active="false"] { color: {{text-100}}; }

QLabel[class="weather_pop_drop"] { 
    color: #64B5F6; 
    font-family: "{{font-icon}}" !important; 
    font-size: 16px; 
    margin-right: 2px; 
}
QLabel[class="weather_pop_text"] { color: #90CAF9; font-size: 9px; font-weight: bold; }
QLabel[class="weather_temp_icon"] { 
    color:{{text-300}}; 
    font-family: "{{font-icon}}" !important; 
    font-size: 16px; 
    margin-right: 2px;
}

/* ============ Dashboard ============ */
.DashboardCard { background-color: {{bg-200}}; border: 1px solid {{border-100}}; border-radius: 8px; }
.DashboardTitle { color: {{text-100}}; font-weight: bold; font-size: 11px; }
.DashboardValue { color: {{text-200}}; font-weight: bold; font-size: 28px; }

/* ============ IsometricDrawingList ============ */
#IsometricDrawingList {
    background-color: {{bg-100}};
    border-left: 1px solid {{border-100}};
}

#DrawingListHeader {
    background-color: transparent;
    border-bottom: 1px solid {{border-100}};
}

#DrawingListTitleIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 20px;
    color: {{primary-100}};
}

#DrawingListTitleText {
    color: white;
    font-family: "plus_font_sans_bold";
    font-size: 14pt;
    font-weight: bold;
}

#DrawingListSearchContainer {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
}

#DrawingListSearchIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
    color: {{text-100}};
}

#DrawingListSearchInput {
    background: transparent;
    border: none;
    color: white;
    font-size: 10pt;
    padding: 0px;
}

#DrawingListScrollArea {
    background: transparent;
    border: none;
}

#DrawingListContainer {
    background: transparent;
}

#DrawingListFooter {
    background-color: rgba(18, 18, 18, 0.3);
    border-top: 1px solid {{border-100}};
}

QFrame[class="DrawingItem"], #DrawingItem {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}
QFrame[class="DrawingItem"][active="true"], #DrawingItem[active="true"] {
    background-color: rgba({{primary-100-rgb}}, 0.15); /* primary-100 60% opacity */
    border: 1px solid {{primary-100}};
}
QFrame[class="DrawingItem"]:hover, #DrawingItem:hover {
    background-color: rgba(255, 255, 255, 0.03);
}
QFrame[class="DrawingItem"][active="true"]:hover, #DrawingItem[active="true"]:hover {
    border-color: {{primary-100}};
}
QFrame[class="DrawingItem"][active="false"]:hover, #DrawingItem[active="false"]:hover {
    border-color: {{border-100}};
}

.DrawingListTitle { 
    font-family: "grotesk";
    font-size: 10pt; 
    font-weight: 600; 
    color: {{text-200}}; 
}
.DrawingListTitle[active="true"] { color: {{text-300}}; }

.DrawingListLine { 
    font-family: "plus_font_sans_500";
    font-size: 9pt; 
    color: {{text-200}}; 
}
.DrawingListLine[active="true"] { color: {{text-300}}; }

.StatusBadge {
    border-radius: 4px;
    padding: 2px 2px;
    font-size: 9px;
    font-weight: bold;
    text-transform: uppercase;
    border: 1px solid transparent;
    min-height: 12px;
}

.StatusBadge[status="loading"] { color: #94a3b8; background-color: rgba(148, 163, 184, 0.14); border-color: rgba(148, 163, 184, 0.26); }
.StatusBadge[status="pending"] { color: #ef4444; background-color: rgba(239, 68, 68, 0.14); border-color: rgba(239, 68, 68, 0.30); }
.StatusBadge[status="in-progress"] { color: #3b82f6; background-color: rgba(59, 130, 246, 0.14); border-color: rgba(59, 130, 246, 0.30); }
.StatusBadge[status="completed"] { color: #22c55e; background-color: rgba(34, 197, 94, 0.14); border-color: rgba(34, 197, 94, 0.28); }
.StatusBadge[status="file-not-found"] { color: #f59e0b; background-color: rgba(245, 158, 11, 0.16); border-color: rgba(245, 158, 11, 0.30); }

#EditingBadge {
    color: white;
    background-color: #ef4444;
    border: 1px solid #ef4444;
}

.RevisionBadge {
    border-radius: 4px;
    padding: 0px 2px;
    min-height: 14px;
    min-width: 20px;
    font-size: 8pt;
    font-weight: 600;
    background-color: transparent;
    border: 1px solid transparent;
    text-align: center;
}
.RevisionBadge[latest="true"] {
    color: {{primary-100}};
    font-weight: 700;
    background-color: rgba(92, 130, 157, 0.12);
    border-color: rgba(92, 130, 157, 0.35);
}
.RevisionBadge[latest="false"] {
    color: {{text-100}};
}
.RevisionBadge:hover {
    color: {{accent-100}};
}

.DrawingProgress {
    background-color: rgba(71, 85, 105, 0.45);
    border: none;
    border-radius: 1px;
}
.DrawingProgress::chunk {
    background-color: rgba(148, 163, 184, 0.25);
    border-radius: 1px;
}
.DrawingProgress[status="completed"]::chunk { background-color: #22c55e; }
.DrawingProgress[status="inprogress"]::chunk { background-color: #3b82f6; }
.DrawingProgress[status="pending"]::chunk { background-color: #ef4444; }

#FooterIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 12px;
    color: {{text-100}};
}

#FooterLabel {
    font-family: "plus_font_sans_500";
    font-size: 8pt;
    font-weight: 500;
    color: {{text-100}};
}
/* ============ Drawing Workspace & GraphicsView ============ */
#ZoomableGraphicsView {
    background-color: {{bg-100}};
    border: none;
}

#ZoomableGraphicsViewViewport {
    background-color: {{bg-100}};
}

/* Welding Dock Styling */
QDockWidget#WeldingDock {
    background-color: transparent;
    color: {{text-100}};
    border: none;
}

QDockWidget#WeldingDock > QWidget {
    background-color: {{bg-100}};
    border: none;
}

/* ============ Misc Components ============ */
#workspaceStatusWidget {
    background: transparent;
}

#lock_status_label.error {
    background-color: #f44336;
    color: white;
}

#lock_status_label.success {
    background-color: #4CAF50;
    color: white;
}

#lock_status_label.warning {
    background-color: #ff9800;
    color: white;
}

#request_release_btn {
    background-color: #ff9800;
    color: white;
    font-weight: bold;
    padding: 2px 10px;
    border-radius: 4px;
}
#request_release_btn:hover {
    background-color: #f57c00;
}
#pdf_thumbnail_list {
    border: none;
    border-right: 1px solid {{border-100}};
}

/* ============ IntegratedWeldingProcess ============ */
QDockWidget#WeldingDock > #integratedWeldingProcess {
    background-color: transparent;
    border-top: none;
    border-bottom: none;
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
    border-radius: 0px;
}

.StepSection {
    background-color: transparent;
    border: none;
}

.StepSection[isFloating="true"] .SectionSeparator {
    background-color: {{text-300}};
}

.StepBadge {
    color: #ffffff;
    background-color: {{primary-100}};
    font-weight: bold;
    font-size: 12px;
    padding: 4px 6px;
    border-radius: 4px;
}

.StepTitle {
    color: {{text-300}};
    font-weight: bold;
    font-size: 14px;
    padding-left: 4px;
    background: transparent;
}

.SectionSeparator {
    background-color: {{border-100}};
    border: none;
}

.FieldLabel {
    color: #ffffff; 
    font-weight: bold; 
    font-size: 12px; 
    border: none;
    background: transparent;
}

.WeldingHeader {
    background-color: {{bg-100}};
    border: none;
    border-bottom: 1px solid {{border-100}};
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.WeldingHeaderIcon {
    color: {{primary-100}};
    background: transparent;
    border: none;
}

.WeldingHeaderTitle {
    color: white;
    font-size: 14pt;
    font-weight: bold;
    border: none;
    background: transparent;
}

.WeldingHeaderBtn {
    background: transparent;
    font-weight: bold;
    font-size: 12px;
    border: 1px solid {{border-100}};
    border-radius: 4px;
    color: {{text-200}};
}

.WeldingHeaderBtn:hover {
    background-color: {{primary-100}};
    color: white;
}

.WeldingHeaderBtn:disabled {
    color: {{text-400}};
    border-color: {{border-200}};
}

.InfoFrame {
    background-color: transparent;
    border: 1px solid {{border-100}};
    border-radius: 4px;
}

#integratedWeldingProcess[isFloating="true"] .InfoFrame {
    border-color: {{border-400}};
}

.InfoLabel {
    color: {{text-300}};
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

.FooterFrame {
    background: transparent;
    border: none;
    border-top: 1px solid {{border-100}};
}

/* Input Fields inside IntegratedWeldingProcess */
#IntegratedWeldingProcess_InputField {
    background: rgba(148, 163, 184, 0.1);
    color: #ffffff;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 6px;
    padding: 3px 5px;
    font-size: 12px;
    min-width: 0px;
}

#IntegratedWeldingProcess_InputField:focus {
    border: 1px solid {{primary-100}};
    background: rgba(19, 127, 236, 0.05);
}

#IntegratedWeldingProcess_InputField[readOnly="true"] {
    background-color: #2a2b30;
    color: #8a8d95;
}

#IntegratedWeldingProcess_InputField[lockState="warning"] {
    color: #ff6b6b;
    background: rgba(255, 107, 107, 0.1);
    border: 1px solid rgba(255, 107, 107, 0.55);
}

#IntegratedWeldingProcess_InputField[lockState="warning"]:focus {
    border: 1px solid #ff6b6b;
    background: rgba(255, 107, 107, 0.14);
}

#IntegratedWeldingProcess_InputField:hover {
    border: 1px solid rgba(148, 163, 184, 0.4);
}

/* StandardToolbar & ToolbarButton */
.StandardToolbar {
    background: {{bg-400}};
    border-bottom: 1px solid {{border-100}};
}

.ToolbarGroupTitle {
    color: {{text-100}};
    font-size: 10px;
    font-weight: 600;
    padding-bottom: 2px;
}

.ToolbarButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: {{text-100}};
    padding: 4px;
}

.ToolbarButton:hover {
    background: {{bg-300}};
    border: 1px solid {{border-100}};
}

.ToolbarButton:pressed {
    background: {{accent-100}};
    color: #ffffff;
}

.ToolbarButton[checked="true"] {
    background: {{accent-100}};
    color: #ffffff;
}

.ToolbarButton:disabled {
    opacity: 0.5;
    color: {{text-400}};
}

/* ============ Plus Dashboard Page ============ */
.PlusDashboardPage, QWidget[class="PlusDashboardPage"] {
    background-color: {{bg-100}};
    border-top: none;
    border-bottom: none;
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
}

.DashboardHeader {
    background-color: {{bg-100}};
    border-bottom: 1px solid {{border-100}};
}

.DashboardTitleIcon {
    color: {{primary-100}}; 
    font-family: "{{font-icon}}" !important; 
    font-size: 24px; 
    background: transparent;
}

.DashboardTitleLabel {
    color: {{text-200}}; 
    font-size: 20px; 
    font-weight: bold;
    background: transparent;
}

.DashboardDateButton {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 8px 16px;
    color: {{text-200}};
    font-weight: bold;
    font-size: 12px;
}
.DashboardDateButton:hover {
    border: 1px solid {{primary-100}};
}

/* Dashboard Metric Cards */
.DashboardCard {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}
.DashboardCard[active="true"] {
    border: 2px solid {{primary-100}};
}

.DashboardMetricTitle {
    color: {{text-100}}; 
    font-weight: bold; 
    font-size: 11px;
    background: transparent;
}
.DashboardMetricValue {
    color: {{text-200}}; 
    font-weight: bold; 
    font-size: 28px;
    background: transparent;
}

/* Projects Overview ScrollBar */
.DashboardScrollArea, .ProjectConfigPage QScrollArea {
    background-color: transparent; 
    border: none;
}
.ProjectConfigPage QScrollArea QScrollBar::add-line:vertical, .ProjectConfigPage QScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Chart Legends & Small Labels */
.DashboardLegendDot { font-size: 12px; background: transparent; }
.DashboardLegendLabel { color: {{text-200}}; font-size: 12px; font-weight: bold; background: transparent; }
.DashboardSubLabel { color: {{text-100}}; font-size: 10px; font-weight: bold; text-transform: uppercase; background: transparent; }

/* Status Badges */
.DashboardProjectBadge {
    font-weight: bold;
    font-size: 9px;
    padding: 2px 6px;
    border-radius: 4px;
}
.DashboardProjectBadge[status="on-track"] { color: #10B981; background-color: rgba(16, 185, 129, 0.15); }
.DashboardProjectBadge[status="active"]   { color: {{primary-100}}; background-color: rgba(0, 133, 255, 0.15); }
.DashboardProjectBadge[status="at-risk"]  { color: #EAB308; background-color: rgba(234, 179, 8, 0.15); }

/* Urgent Alerts */
.UrgentAlertFrame {
    border-left: 4px solid #F43F5E;
    background-color: rgba(244, 63, 94, 0.12);
}
.UrgentAlertFrame[tone="yellow"] {
    border-left-color: #EAB308;
    background-color: rgba(234, 179, 8, 0.12);
}
.UrgentAlertTitle { color: #F43F5E; font-weight: bold; font-size: 12px; background: transparent; border: none; }
.UrgentAlertFrame[tone="yellow"] .UrgentAlertTitle { color: #EAB308; }
.UrgentAlertSubtitle { color: {{text-100}}; font-size: 10px; background: transparent; border: none; }

/* Progress Bars */
.DashboardProgressBar {
    background-color: rgba(148, 163, 184, 0.2); 
    border-radius: 2px; 
    border: none;
}
.DashboardProgressBar::chunk {
    background-color: {{primary-100}};
    border-radius: 2px;
}

/* Tables */
.DashboardTable {
    background-color: transparent; 
    border: none; 
    color: {{text-200}}; 
    gridline-color: transparent;
}
.DashboardTable QHeaderView::section {
    background-color: rgba(148, 163, 184, 0.1); 
    color: {{text-100}}; 
    font-weight: bold; 
    border: none; 
    border-bottom: 1px solid {{border-100}}; 
    padding: 8px;
}
.DashboardTable::item {
    border-bottom: 1px solid {{border-100}}; 
    padding: 8px;
}

.DashboardTableBtnPrimary {
    background-color: {{primary-100}}; 
    color: white; 
    border: none; 
    border-radius: 4px; 
    padding: 6px 12px; 
    font-weight: bold; 
    font-size: 10px;
}
.DashboardTableBtnPrimary:hover {
    background-color: #38bdf8;
}

.DashboardTableBtnSecondary {
    background-color: rgba(148, 163, 184, 0.2); 
    color: {{text-200}}; 
    border: none; 
    border-radius: 4px; 
    padding: 6px 12px; 
    font-weight: bold; 
    font-size: 10px;
}
.DashboardTableBtnSecondary:hover {
    background-color: rgba(148, 163, 184, 0.4);
}

.DashboardTableBtnDanger {
    background-color: #F43F5E; 
    color: white; 
    border: none; 
    border-radius: 4px; 
    padding: 6px 12px; 
    font-weight: bold; 
    font-size: 10px;
}
.DashboardTableBtnDanger:hover {
    background-color: #f43f5e;
}

/* ============ Project Config Page ============ */
.PlusDashboardPage, .ProjectConfigPage,
QWidget[class="PlusDashboardPage"], QWidget[class="ProjectConfigPage"] {
    background-color: {{bg-100}};
    border-top: none;
    border-bottom: none;
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
    padding: 0px;
}

.ConfigHeader {
    background-color: {{bg-100}};
    border: none;
    border-bottom: 1px solid {{border-100}};
}

.ConfigSection {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.ConfigSectionIcon {
    color: {{text-200}};
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
    font-weight: bold;
    background: transparent;
}

.ConfigSectionTitle {
    color: white;
    font-weight: bold;
    font-size: 12pt;
    text-transform: uppercase;
    background: transparent;
}

.ConfigBreadcrumbLabel {
    color: {{text-100}};
    font-size: 10pt;
    font-weight: bold;
    background: transparent;
}

.ConfigStandardSpec {
    color: {{text-100}};
    font-size: 10pt;
    font-weight: bold;
    background: transparent;
    border: none;
    border-bottom: 1px solid {{border-100}};
}

.ConfigBreadcrumbValue {
    color: {{text-200}};
    font-size: 12pt;
    font-weight: bold;
    background: transparent;
}

.ConfigDivider {
    background-color: {{border-100}};
}

.ConfigDimSelectorContainer {
    background-color: {{bg-100}};
    border-radius: 6px;
}

.ConfigDimButton {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 10pt;
}
.ConfigDimButton:checked {
    background-color: {{primary-100}};
    color: white;
}
.ConfigDimButton:hover:!checked {
    background-color: rgba(148, 163, 184, 0.1);
}

.ConfigActionSave {
    background-color: {{accent-100}};
    border: none;
    border-radius: 4px;
}
.ConfigActionSave:hover {
    opacity: 0.8;
}

.ConfigActionReset {
    background-color: #222;
    color: {{text-200}};
    border: 1px solid {{primary-100}};
    border-radius: 4px;
    padding: 0 16px;
}

.ConfigColorButton {
    border: 1px solid {{border-100}};
    border-radius: 4px;
    color: {{text-200}};
    font-family: '{{font-monospace}}';
    background-color: {{bg-100}};
    padding: 4px;
}

.ConfigHexLabel {
    color: #666;
    font-size: 9pt;
    background: transparent;
}

.ConfigInfoBox {
    background-color: rgba(92, 130, 157, 0.05);
    border: 1px solid rgba(92, 130, 157, 0.2);
    border-radius: 8px;
}

.ConfigInfoIcon {
    color: {{primary-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
    background: transparent;
    border: none;
}

.ConfigInfoText {
    background-color: transparent;
    color: {{text-100}};
    font-size: 11px;
    border: none;
}

.ConfigSpecialItemFrame {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
}

/* --- SpoolNamingWidget --- */

.SpoolNamingWidget {
    background-color: transparent;
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.SpoolNamingTitleIcon {
    background-color: transparent;
    color: {{primary-100}};
}

.SpoolNamingTitle {
    background-color: transparent; 
    color: white; 
    font-weight: bold; 
    font-size: 12pt; 
    letter-spacing: 0.5px;
}

.SpoolNamingSubHeader {
    color: {{text-100}}; 
    font-weight: bold; 
    font-size: 8.5pt; 
    background: transparent; 
    letter-spacing: 0.3px;
}

.DraggableBadge {
    background-color: #1a1a1c;
    border: 1px solid {{border-100}};
    border-radius: 4px;
}

.DraggableBadge:hover {
    background-color: #252528;
    border: 1px solid {{primary-100}};
}

.DraggableBadgeLabel {
    color: {{text-200}}; 
    font-weight: bold; 
    border: none; 
    background: transparent; 
    font-size: 10pt;
}

.DroppedBadge {
    background-color: rgba(92, 130, 157, 0.15);
    border: 1px solid {{primary-100}};
    border-radius: 4px;
    padding-top: 2px;
}

.DroppedBadge:hover {
    background-color: rgba(92, 130, 157, 0.25);
}

.DroppedBadgeLabel {
    color: {{text-200}}; 
    font-weight: bold; 
    border: none; 
    background: transparent; 
    font-size: 10pt;
}

.DroppedBadgeRemoveBtn {
    color: {{text-200}};
    background: transparent;
    border: none;
    font-size: 8pt;
    font-weight: bold;
    padding: 0px;
}

.DroppedBadgeRemoveBtn:hover {
    color: #ff5555;
}

.NamingDropArea {
    background-color: transparent;
    border: 1px dashed #333336;
    border-radius: 4px;
}

.NamingDropArea[active="true"] {
    background-color: rgba(92, 130, 157, 0.05);
    border: 1px dashed {{primary-100}};
}

.NamingDropAreaPlaceholder {
    color: {{text-100}}; 
    font-style: italic; 
    border: none; 
    background: transparent; 
    font-size: 9pt;
}

.NamingPreviewFrame {
    background-color: #0d0d0f;
    border: 1px solid {{border-100}};
    border-radius: 6px;
}

.NamingPreviewTitle {
    color: {{text-100}}; 
    font-weight: bold; 
    font-size: 8.5pt; 
    border: none; 
    background: transparent;
}

.NamingPreviewRefreshBtn {
    color: rgba(92, 130, 157, 0.7); 
    background: transparent; 
    border: none;
}

.NamingPreviewRefreshBtn:hover { 
    color: {{primary-100}}; 
}

.NamingPreviewText {
    color: white; 
    font-weight: bold; 
    font-size: 18pt; 
    border: none; 
    background: transparent;
}


/* --- QualityReportNamingWidget --- */

.QualityNamingWidget {
    background-color: transparent;
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.QualityNamingTitleIcon {
    background-color: transparent;
    color: {{primary-100}};
}

.QualityNamingTitle {
    background-color: transparent; 
    color: white; 
    font-weight: bold; 
    font-size: 12pt; 
    letter-spacing: 0.5px;
}

.QualityNamingInput, .QualityNamingCombo {
    background-color: #1a1a1c;
    border: 1px solid {{border-100}};
    border-radius: 4px;
    color: {{text-200}};
    padding: 4px 8px;
    min-height: 28px;
}

.QualityNamingCombo::drop-down {
    border: none;
    width: 20px;
}

.QualityNamingCombo::down-arrow {
    image: none;
}

.ITPPanel {
    background-color: {{bg-100}}; 
    border: 1px solid {{border-100}}; 
    border-radius: 8px;
}

.ITPPanelHeader {
    border-bottom: 1px solid {{border-100}};
}

.ITPPanelTitleIcon {
    background-color: transparent; 
    color: {{primary-100}}; 
    border: none;
}

.ITPPanelTitleText {
    background-color: transparent; 
    color: white; 
    font-weight: bold; 
    font-size: 12pt; 
    border: none;
}

.ITPPanelActionButton {
    background-color: transparent; 
    border-radius: 4px; 
    border: 1px solid {{border-100}};
}

.ITPPanelActionButton:hover {
    background-color: {{border-100}};
}

.ITPPanelActionIcon {
    color: {{text-100}}; 
    border: none; 
    background: transparent;
}

.ITPPanelFilterButton {
    background-color: {{bg-200}}; 
    color: {{text-100}}; 
    font-weight: 600; 
    font-size: 13px; 
    border: 1px solid {{border-100}}; 
    border-radius: 4px; 
    padding: 8px;
}

.ITPPanelFilterButton:hover {
    background-color: {{border-100}};
}

.ITPPanelFilterButton:checked {
    background-color: {{primary-100}}; 
    color: white; 
    border-color: {{primary-100}};
}

.ITPPanelAddButton {
    background-color: transparent; 
    border: 1px solid {{border-100}}; 
    border-radius: 4px;
}

.ITPPanelAddButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.ITPPanelAddIcon, .ITPPanelAddText {
    color: {{text-100}}; 
    border: none; 
    background: transparent;
}

.ITPPanelAddButton:hover .ITPPanelAddText {
    color: white;
}

.ITPPanelTableHeader {
    background-color: {{bg-300}}; 
    border-bottom: 1px solid {{border-100}};
}

.ITPPanelTableHeaderLabel {
    font-weight: bold; 
    font-size: 13px; 
    color: {{text-100}}; 
    text-transform: uppercase; 
    border: none;
}

.ITPRow {
    background-color: transparent;
    border-bottom: 1px solid {{border-100}}80;
}

.ITPRow:hover {
    background-color: rgba(51, 141, 255, 0.1);
}

.ITPRow[selected="true"] {
    background-color: rgba(51, 141, 255, 0.3);
}

.ITPRowCodeInput {
    color: white; 
    background: transparent; 
    border: none;
    border-bottom: 2px solid transparent; 
    padding: 4px;
}

.ITPRowCodeInput:focus {
    border-radius: 0px; 
    border-bottom: 2px solid {{accent-100}};
}

.ITPRowDescLabel {
    color: white; 
    background: transparent; 
    border: none; 
    padding: 4px 12px;
}

.ITPRowKeywordLabel {
    color: {{text-100}}; 
    background: transparent; 
    border: none; 
    padding: 4px 12px;
}

.ITPRowDeleteBtn {
    background-color: transparent; 
    border-radius: 4px; 
    border: none;
}

.ITPRowDeleteBtn:hover {
    background-color: rgba(255, 0, 0, 0.15);
}

.ITPRowDeleteIcon {
    color: {{text-100}}; 
    background: transparent; 
    border: none;
}

.ITPPanelFooter {
    background-color: #0a0a0a; 
    border-top: 1px solid {{border-100}}; 
    border-bottom-left-radius: 8px; 
    border-bottom-right-radius: 8px;
}

.ITPPanelStatusDot {
    background-color: #22c55e; 
    border-radius: 4px; 
    border: none;
}

.ITPPanelFooterLabel {
    color: {{text-100}}; 
    border: none;
}

.ITPPanelScrollArea {
    background-color: transparent; 
    font-size: 12px;
    border: none;
}

.ITPPanelScrollContent {
    background-color: transparent; 
    font-size: 12px;
    border: none;
}

/* --- PlusColorPicker --- */

.ColorPickerFrame {
    background-color: #2C2C2E;
    border: 1px solid #3A3A3C;
    border-radius: 16px;
    color: #FFFFFF;
}

.ColorPickerHeaderIcon {
    color: #FFFFFF;
    font-size: 16px;
    background: transparent;
    border: none;
}

.ColorPickerTitle {
    font-weight: bold;
    font-size: 15px;
    color: #FFFFFF;
    border: none;
    background: transparent;
}

.ColorPickerCloseBtn {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-size: 12px;
    font-weight: bold;
}

.ColorPickerCloseBtn:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.ColorSwatchGrid {
    background-color: #1C1C1E;
    border-radius: 0px;
    border: none;
}

.ColorSwatchTile {
    border: none;
}

.ColorAlphaSlider {
    background: transparent;
    border: none;
}

.ColorAlphaPercent {
    background: #ffffff;
    color: #111111;
    border-radius: 12px;
    padding: 0px;
    font-weight: 700;
}

.ColorFavBtn {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
}

.ColorFavBtn:hover {
    border: 1px solid rgba(255, 255, 255, 0.5);
}

.ColorPreview {
    border: none;
    border-radius: 8px;
}

/* --- LayerListPanel --- */

.LayerListPanel {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 0px;
}

.LayerListPanel[floating="true"] {
    background-color: rgba(18, 18, 18, 0.40); /* 40% alpha */
}

.LayerListScrollArea {
    border: none; 
    background: transparent;
}

.LayerPanelHeader {
    background-color: {{bg-100}}; 
    border: none;
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
}

.LayerPanelHeader[floating="true"] {
    background-color: rgba(18, 18, 18, 0.85); /* 85% alpha */
}

.LayerPanelTitle {
    color: white; 
    font-weight: bold; 
    border: none; 
    background: transparent;
}

.LayerPanelMoreButton {
    color: #6b7280; 
    border: none; 
    background: transparent; 
    padding: 0;
}

.LayerPanelActionButton {
    background-color: transparent;
    border: 1px solid #374151;
    border-radius: 4px;
    color: {{text-200}};
}

.LayerPanelActionButton:hover {
    background-color: #1E1E1E;
    border-color: #4b5563;
}

.LayerPanelActionButton[primary="true"] {
    background-color: rgba(51, 119, 255, 0.1);
    border: 1px solid rgba(51, 119, 255, 0.4);
    color: {{primary-100}};
}

.LayerPanelActionButton[primary="true"]:hover {
    background-color: {{primary-100}};
    border-color: {{primary-200}};
    color: white;
}

.LayerPanelActionButton QLabel {
    background: transparent;
    border: none;
    color: {{text-200}};
}

.LayerPanelCategoryTitle {
    color: #6b7280;
    font-weight: bold;
    padding: 0px 12px 2px 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    background: transparent;
}

.LayerPanelFooter {
    background-color: #151515; 
    border: none; 
    border-top: 1px solid {{border-100}};
}

.LayerPanelFooterLabel {
    color: #4b5563; 
    border: none; 
    background: transparent;
}

.LayerPanelStatusDot {
    background-color: rgba(34, 197, 94, 0.2); 
    border: 1px solid {{primary-100}}; 
    border-radius: 4px;
}

/* --- LayerItemWidget --- */

.LayerItem {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
}

.LayerItem:hover {
    background-color: #1E1E1E;
    border: 1px solid #4b5563;
}

.LayerItem[selected="true"] {
    background-color: rgba(51, 119, 255, 0.1);
    border-left: 3px solid {{primary-100}};
    border-top: 1px solid rgba(51, 119, 255, 0.3);
    border-right: 1px solid rgba(51, 119, 255, 0.3);
    border-bottom: 1px solid rgba(51, 119, 255, 0.3);
}

.LayerItemIconButton {
    color: #6b7280;
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
}

.LayerItemIconButton:hover { 
    background: rgba(255, 255, 255, 0.08); 
    color: white; 
}

.LayerItemIconButton[active="true"] {
    color: {{primary-100}};
}

.LayerItemTypeIcon {
    color: {{text-100}};
    background: transparent;
    border: none;
}

.LayerItemTypeIcon[user="true"] {
    color: #eab308;
}

.LayerItem[selected="true"] .LayerItemTypeIcon {
    color: {{primary-100}};
}

.LayerItemNameLabel {
    color: {{text-200}};
    background: transparent;
    border: none;
}

.LayerItem[selected="true"] .LayerItemNameLabel {
    color: white;
    font-weight: bold;
}

.LayerItemNameInput {
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0px;
    color: {{text-200}};
    font-weight: 500;
    padding: 2px 0;
}

.LayerItemNameInput:hover { 
    border-bottom: 1px solid #4b5563; 
}

.LayerItemNameInput:focus { 
    border-bottom: 1px solid {{primary-100}}; 
}

.LayerItemIndexTag {
    color: {{text-100}};
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    padding: 1px 4px;
}

.LayerItem[selected="true"] .LayerItemIndexTag {
    color: {{primary-100}};
    background-color: rgba(51, 119, 255, 0.1);
    border: 1px solid rgba(51, 119, 255, 0.2);
}

/* --- InspSubItemWidget --- */

.InspSubPanel {
    background-color: transparent;
    border: none;
}

.InspSubItem:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.InspSubItemViewButton {
    color: #6b7280;
    background: transparent;
    border: none;
    padding: 0px;
    text-transform: none;
}

.InspSubItemViewButton:hover { 
    color: white; 
}

.InspSubItemViewButton[active="true"] {
    color: {{primary-100}};
}

.InspSubItemNameButton {
    color: {{text-100}};
    text-align: left;
    background: transparent;
    border: none;
    padding-left: 4px;
}

.InspSubItemNameButton:checked {
    color: white;
    font-weight: bold;
}

.InspSubItemNameButton:hover { 
    color: white; 
}

/* --- DrawingInfoSidePanel --- */

.DrawingInfoPanel {
    background-color: {{bg-200}};
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
}

.DrawingInfoPanel[read_only="true"] {
    background-color: {{bg-300}};
}

.DrawingInfoPanelHeader {
    border-bottom: 1px solid {{border-100}};
    background-color: {{bg-200}};
}

.DrawingInfoIconBg {
    background-color: transparent;
    border: none;
}

.DrawingInfoIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 20px;
    color: {{primary-100}};
    background-color: transparent;
}

.DrawingInfoTitle {
    font-family: "{{font-sans-bold}}";
    color: {{text-200}};
    font-weight: bold;
    font-size: 14pt;
    background-color: transparent;
}

.DrawingInfoScrollArea {
    background: transparent;
    border: none;
}

.DrawingInfoContent {
    background-color: {{bg-200}};
}

.DrawingInfoInputLabel {
    font-family: "{{font-sans-bold}}";
    font-size: 10px;
    font-weight: bold;
    color: {{text-200}};
    text-transform: uppercase;
    background: transparent;
}

.DrawingInfoInputLabel[highlight="true"] {
    color: {{primary-100}};
}

.DrawingInfoToggleBtn {
    background-color: rgba(51, 119, 255, 0.05); /* 5% primary-100 */
    border: 1px solid rgba(51, 119, 255, 0.2); /* 20% primary-100 */
    border-radius: 6px;
    height: 36px;
    font-size: 13px;
}

.DrawingInfoToggleBtn:hover {
    background-color: rgba(51, 119, 255, 0.1); /* 10% primary-100 */
}

.DrawingInfoToggleBtn:checked {
    background-color: rgba(51, 119, 255, 0.15); /* 15% primary-100 */
}

.DrawingInfoToggleText {
    font-family: "{{font-sans-bold}}";
    font-size: 15px;
    font-weight: bold;
    color: {{text-300}};
    background: transparent;
    letter-spacing: 1px;
}

.DrawingInfoToggleIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 20px;
    color: {{text-300}};
    background: transparent;
}

.DrawingInfoSectionNum {
    font-family: "{{font-sans-bold}}";
    font-size: 12px;
    font-weight: 900;
    color: rgba(51, 119, 255, 0.6); /* 60% primary-100 */
    background: transparent;
}

.DrawingInfoSectionTitle {
    font-family: "{{font-sans-bold}}";
    font-size: 12px;
    font-weight: bold;
    color: {{text-200}};
    text-transform: uppercase;
    background: transparent;
}

.DrawingInfoSectionDivider {
    background-color: rgba(255, 255, 255, 0.05);
}

.DrawingInfoSwitchLabel {
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    background: transparent;
}

.DrawingInfoFooter {
    background-color: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

/* ============ IntegratedWeldLogView ============ */

.WeldLogTopCard {
    background-color: {{bg-300}};
    border-bottom: 1px solid {{border-100}};
}

.WeldLogTitle {
    color: {{text-200}};
    font-size: 20px;
    font-weight: 700;
}

.WeldLogStatusLabel {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    color: #FF9D56; /* text-orange fallback */
    padding: 6px 12px;
    border-radius: 8px;
    font-weight: 700;
}

.WeldLogExportButton {
    background-color: {{primary-100}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 10px;
    padding: 7px 16px 7px 12px;
    font-weight: 700;
    min-width: 136px;
}
.WeldLogExportButton:hover {
    background-color: {{primary-200}};
}
.WeldLogExportButton:pressed {
    background-color: {{primary-200}};
    padding-top: 8px;
    padding-bottom: 6px;
}
.WeldLogExportButton:disabled {
    background-color: {{bg-200}};
    color: {{text-100}};
}

.WeldLogTableFrame {
    background-color: {{bg-100}};
}

/* IntegratedWeldLogView - ProgressBar (StatusBar) */
QProgressBar#IntegratedWeldLogExportProgress {
    background-color: {{bg-200}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    text-align: center;
    padding: 1px;
}
QProgressBar#IntegratedWeldLogExportProgress::chunk {
    background-color: {{primary-100}};
    border-radius: 4px;
}

/* IntegratedWeldLogView - Table Internal Styles */
#mainTable, #frozenTable { 
    border: none; 
    background-color: transparent;
    color: {{text-100}};
    font-size: 11px;
}

#mainTable {
    background-color: {{bg-100}};
}

#frozenTable {
    background-color: {{bg-200}};
}

#frozenSeparator {
    background-color: {{primary-100}};
    min-width: 3px;
    border-left: 1px solid #7cc2ff;
    border-right: 1px solid #0b3c66;
}

QLabel[type="group"], QLabel[type="detail"], ClickableHeaderLabel[type="detail"] {
    background-color: {{bg-200}};
    color: #FF9D56; /* text-orange fallback */
    font-weight: 700;
    font-size: 11px;
    border: none;
    border-right: 1px solid {{border-100}};
    padding: 0px;
    margin: 0px;
}
QLabel[type="group"] { 
    border-bottom: 1px solid {{border-100}}; 
}

QLabel[type="detail"], ClickableHeaderLabel[type="detail"] {
    border-bottom: 3px solid {{border-100}};
}

/* ============ WeldJointEditor ============ */

.WeldJointEditorContainer {
    background-color: {{bg-100}};
    border-radius: 12px;
    border: 1px solid {{border-100}};
}

.WeldJointEditorHeader {
    background-color: {{bg-100}};
    border-bottom: 1px solid {{border-100}};
}

.WeldJointEditorTitle {
    color: {{text-200}};
    font-size: 14px;
    font-weight: bold;
    border: none;
}

.WeldJointEditorScrollArea {
    background: transparent;
    border: none;
}

.WeldJointEditorSectionTitle {
    color: {{text-300}};
    background: rgba(19, 127, 236, 0.08);
    font-weight: bold;
    padding: 10px 14px;
    font-size: 14px;
    border-left: 4px solid {{primary-100}};
    border-radius: 2px;
    margin-top: 12px;
    margin-bottom: 4px;
}

.WeldJointEditorRowLabel {
    color: #ffffff;
    font-weight: bold;
    font-size: 11px;
    border: none;
}

.WeldJointEditorValueLabel {
    color: #ffffff;
    font-style: italic;
    font-size: 12px;
    border: none;
    font-weight: normal;
}

.WeldJointEditorInput {
    background: rgba(148, 163, 184, 0.1);
    font-size: 12px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 6px;
    padding: 6px 6px;
    color: #ffffff;
    min-width: 0px;
}
.WeldJointEditorInput:focus {
    border: 1px solid {{primary-100|#137fec}};
    background: rgba(19, 127, 236, 0.05);
}
.WeldJointEditorInput:hover {
    border: 1px solid rgba(148, 163, 184, 0.4);
}

.WeldJointEditorReadOnlyInput {
    background: rgba(148, 163, 184, 0.05);
    color: #94a3b8;
}

.WeldJointEditorCombo {
    background: rgba(148, 163, 184, 0.1);
    color: #ffffff;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
.WeldJointEditorCombo:hover {
    border: 1px solid rgba(148, 163, 184, 0.4);
}
.WeldJointEditorCombo::drop-down {
    border: none;
    width: 24px;
}
.WeldJointEditorCombo::down-arrow {
    image: none;
}
.WeldJointEditorCombo QAbstractItemView {
    background-color: #1e293b;
    color: #ffffff;
    selection-background-color: {{primary-100|#137fec}};
    outline: none;
    border: 1px solid #334155;
}

.WeldJointEditorFooter {
    background-color: {{bg-100}};
    border-top: 1px solid {{border-100}};
}

.WeldJointEditorHint {
    color: {{text-300|#FF9D56}};
    font-size: 13px;
    border: none;
    background: transparent;
}

.WeldJointEditorCancelBtn {
    background: transparent;
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
}
.WeldJointEditorCancelBtn:hover {
    background: rgba(255, 255, 255, 0.05);
}

.WeldJointEditorSaveBtn {
    background: {{primary-100|#137fec}};
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
}
.WeldJointEditorSaveBtn:hover {
    background: {{primary-200|#0f62b8}};
}


/* ============ DataMigrationForm (Web) ============ */

.DataMigrationFormWrapper {
    background: transparent;
}

.DataMigrationFormContainer {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 20px;
}

/* ============ LoginDialog ============ */

.LoginDialogWidget {
    background: transparent;
}

.LoginDialogContainer {
    background-color: transparent;
    border: none;
}

.LoginDialogLeft {
    background-color: #000000;
    border-radius: 0px;
}


.LoginFieldLabel {
    color: {{text-200}};
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    padding-right: 2px;
}
.LoginDialogRight {
    background-color: rgba({{bg-100-rgb}}, 0.61);
    border-radius: 0px;
}

.LoginDialogTitle {
    color: {{text-100}};
    font-weight: bold;
    font-size: 28px;
    border: none;
    background: transparent;
}

.LoginDialogDesc {
    color: {{text-200}};
    font-size: 14px;
    border: none;
    background: transparent;
}

.DialogInput {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 6px 6px;
    color: {{text-100}};
    font-size: 13px;
    selection-background-color: {{primary-100}};
}

.DialogInput:focus {
    border: 1px solid {{primary-100}};
    background-color: {{bg-300}};
    color: white;
}

.DialogBtnPrimary {
    background-color: {{primary-100}};
    color: white;
    border: none;
    border-radius: 0px;
    font-weight: bold;
    font-size: 14px;
    min-height: 40px;
    padding: 0 16px;
}

.DialogBtnPrimary:hover {
    background-color: {{primary-200}};
}

.DialogBtnPrimary:pressed {
    background-color: {{primary-300}};
    padding: 0 16px;
    margin: 0;
}

.DialogBtnSecondary {
    background-color: transparent;
    color: {{text-100}};
    border: 1px solid {{primary-100}};
    border-radius: 0px;
    font-weight: bold;
    font-size: 14px;
    min-height: 40px;
    padding: 0 16px;
}

.DialogBtnSecondary:hover {
    background-color: {{bg-200}};
}

.DialogBtnSecondary:pressed {
    padding: 0 16px;
    margin: 0;
}

.DialogBtnClose {
    background-color: {{bg-200}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    border-radius: 0px;
    font-size: 14px;
    padding: 0;
    font-weight: bold;
}

QPushButton#btnCloseX {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    margin: 0;
    border-radius: 0px;
}

.DialogBtnClose:hover {
    background-color: #ef4444;
    color: {{text-200}};
    border: 1px solid #ef4444;
}

.DialogBtnClose:pressed {
    color: {{text-200}};
    padding: 2px 2px;
    margin: 0;
}

.LoginDialogStatus {
    font-size: 11px;
    background: transparent;
}

.LoginDialogStatus[state="success"] {
    color: #10b981;
}

.LoginDialogStatus[state="error"] {
    color: #ef4444;
}

.LoginDialogStatus[state="info"] {
    color: {{primary-100}};
}

.CopyBtn {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 4px;
}

.CopyBtn:hover {
    background-color: {{bg-300}};
    border: 1px solid {{primary-100}};
}

.DialogCheckbox {
    color: {{text-100}};
    font-size: 13px;
    padding-left: 2px;
}


/* ============ Common Dialog Styles ============ */

.PlusDialogWidget {
    background: transparent;
}

.PlusDialogContainer {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

.PlusDialogHeader {
    background-color: {{bg-300}};
    border-radius: 0px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid {{border-100}};
}

.PlusDialogTitle {
    color: {{text-100}};
    font-size: 14px;
    font-weight: bold;
    border: none;
    background: transparent;
}

.PlusDialogBody {
    border: none;
    background: transparent;
}

.PlusDialogText {
    color: {{text-200}};
    font-size: 14px;
    border: none;
    background: transparent;
}

.PlusDialogIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 36px;
    border: none;
    background: transparent;
}

.PlusDialogIcon[type="info"] { color: {{primary-100}}; }
.PlusDialogIcon[type="warning"] { color: #F59E0B; }
.PlusDialogIcon[type="critical"] { color: #EF4444; }
.PlusDialogIcon[type="question"] { color: {{primary-100}}; }

.PlusDialogFooter {
    border-radius: 0px;
    border-top: 1px solid {{border-100}};
    background: {{bg-100}};
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.PlusDialogInput {
    background-color: rgba(255, 255, 255, 0.05);
    color: white;
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 8px;
    font-size: 14px;
}

.PlusDialogInput:focus {
    border: 1px solid {{primary-100}};
}

/* QSpinBox specific in PlusDialog */
QSpinBox.PlusDialogInput::up-button, 
QSpinBox.PlusDialogInput::down-button {
    width: 20px;
    border: none;
    background: transparent;
}

/* ============ PlusSnakeBar ============ */

.PlusSnakeBarWidget {
    background: transparent;
}

.PlusSnakeBarContainer {
    background: {{bg-100}};
    color: {{text-200}};
    border-radius: 12px;
}

.PlusSnakeBarTitle {
    color: {{text-200}};
    font-weight: bold;
}

.PlusSnakeBarLabel {
    color: {{text-200}};
}

.PlusSnakeBarCloseIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
    color: {{text-200}};
    background: transparent;
    border: none;
}

/* ============ PlusDrawingToolbar ============ */

.DrawingToolbarContainer {
    background: transparent;
}

.ToolbarSeparator {
    background-color: transparent;
    border: none;
}

.ToolbarSeparatorLine {
    background-color: {{border-100}};
    border: none;
}

.ShapeSelectButton {
    background-color: transparent;
    border: none;
}

.ShapeSelectButtonCaption {
    color: {{text-100}};
    background-color: transparent;
    border: none;
}

.ShapeSelectButtonCaption[unfocused="true"] {
    color: rgba(255, 255, 255, 0.6);
}

.ShapeSelectButtonSeparator {
    background-color: {{border-100}};
    border: none;
}

.ShapeSelectButtonSeparator[unfocused="true"] {
    background-color: rgba({{border-100-rgb}}, 0.6);
}

.ToolbarWeldNoEdit {
    background-color: transparent;
    border: none;
}


.ToolbarWeldNoEditFrame {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.ToolbarWeldNoEditFrame[focus="true"] {
    border: 1px solid {{accent-100}};
}

.ToolbarWeldNoEditSpinBox {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    padding: 1px;
    margin: 0px;
}

/* Hide spinbox buttons as they are replaced by custom buttons */
.ToolbarWeldNoEditSpinBox::up-button, 
.ToolbarWeldNoEditSpinBox::down-button {
    width: 0px;
}

.ToolbarWeldNoEditButton {
    background-color: {{bg-100}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    border-radius: 3px;
    font-weight: bold;
    font-size: 10pt;
    padding: 2px;
}

.ToolbarWeldNoEditButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid {{accent-100}};
}

.ToolbarWeldNoEditButton:pressed {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid {{accent-100}};
}

.ToolbarWeldNoEditPrefix {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    padding: 0px;
    margin: 0px;
}

/* Prefix ComboBox special styling */
QComboBox.ToolbarWeldNoEditPrefix {
    padding-right: 0px;
}

QComboBox.ToolbarWeldNoEditPrefix::drop-down {
    width: 0;
    border: none;
}

QComboBox.ToolbarWeldNoEditPrefix::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

QComboBox.ToolbarWeldNoEditPrefix QAbstractItemView {
    background-color: {{bg-100}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    selection-background-color: {{primary-100}};
    min-width: 200px;
}

/* ============ ToolbarSpinEdit ============ */

.ToolbarSpinEdit {
    background-color: transparent;
    border: none;
}

.ToolbarSpinEditFrame {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.ToolbarSpinEditFrame[focus="true"] {
    border: 1px solid {{accent-100}};
}

.ToolbarSpinEditFrame[unfocused="true"] {
    background-color: rgba({{bg-200-rgb}}, 0.6);
    border: 1px solid rgba({{border-100-rgb}}, 0.6);
}

.ToolbarSpinEditSpinBox {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    padding: 4px;
    margin: 0px;
}

.ToolbarSpinEditSpinBox[unfocused="true"] {
    color: rgba(255, 255, 255, 0.6);
}

/* Hide spinbox buttons */
.ToolbarSpinEditSpinBox::up-button, 
.ToolbarSpinEditSpinBox::down-button {
    width: 0px;
}

.ToolbarSpinEditButton {
    background-color: {{bg-100}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    border-radius: 3px;
    font-weight: bold;
    font-size: 10pt;
    padding: 2px;
}

.ToolbarSpinEditButton[unfocused="true"] {
    background-color: rgba({{bg-100-rgb}}, 0.6);
    color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba({{border-100-rgb}}, 0.6);
}

.ToolbarSpinEditButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid {{accent-100}};
}

.ToolbarSpinEditButton:pressed {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid {{accent-100}};
}

/* ============ PlusBasicWidget components ============ */

.PlusBasicLabel {
    color: {{text-100}};
    background-color: transparent;
    border: none;
}

.PlusBasicLabel[unfocused="true"] {
    color: rgba(255, 255, 255, 0.6);
}

.PlusBasicSeparatorContainer {
    background-color: transparent;
    border: none;
}

.PlusBasicSeparatorContainer[unfocused="true"] {
    background-color: rgba({{bg-100-rgb}}, 0.6);
}

.PlusBasicSeparator {
    background-color: {{border-100}};
    border: none;
}

.PlusBasicSeparator[unfocused="true"] {
    background-color: rgba({{border-100-rgb}}, 0.6);
}

/* ============ PlusCanvasToolbar ============ */

.PlusCanvasToolbar {
    background-color: {{bg-200}};
    border-left: 1px solid {{border-100}};
    width: 32px;
}

.CanvasToolbarSeparator {
    background-color: #555555;
}

.IconFontButton {
    background-color: transparent;
    color: {{text-100}};
    font-family: "{{font-icon}}";
    border-radius: 4px;
    border: none;
    outline: none;
    padding: 0px;
    margin: 0px;
    min-width: 32px;
    min-height: 32px;
}

.IconFontButton:hover {
    background-color: #3a3a3e;
}

.IconFontButton:pressed {
    background-color: {{bg-300}};
    padding-top: 2px;
    padding-left: 2px;
}

.IconFontButton:checked {
    background-color: rgba({{primary-100-rgb}}, 0.25);
    border: 1px solid {{primary-100}};
    color: {{primary-100}};
}

.ShapeToolButton {
    background-color: transparent;
    border-radius: 8px;
    border: none;
    outline: none;
    min-height: 48px;
}

.ShapeToolButton:hover {
    background-color: #3a3a3e;
}

.ShapeToolButton:pressed {
    background-color: {{bg-300}};
    padding-top: 2px;
    padding-left: 2px;
}

.ShapeToolButton:checked {
    background-color: rgba({{primary-100-rgb}}, 0.25);
    border: 1px solid {{primary-100}};
}

.ShapeToolButtonIcon {
    font-family: "{{font-icon}}";
    font-size: 20px;
    color: {{text-100}};
    background-color: transparent;
}

.ShapeToolButtonLabel {
    font-family: "{{font-sans}}";
    font-size: 12px !important;
    color: {{text-200}};
    background-color: transparent;
}

.ShapeToolButton:checked .ShapeToolButtonLabel {
    color: {{text-100}};
}

.FloatingShapeToolbar {
    background-color: transparent;
    border: none;
}

.FloatingShapeToolbarContainer {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.CanvasScaleLabel {
    color: white;
    font-size: 8px;
    font-weight: bold;
    background-color: transparent;
}

/* DatePicker */
.DatePickerButton {
    background-color: transparent;
    color: #ffffff;
    padding: 6px 10px;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 6px;
    font-family: "{{font-sans}}";
    font-size: 12px;
    text-align: left;
}

/* ============ Floating Shadow Container Zeroing ============ */
#ShadowContainer {
    background-color: rgba(0, 0, 0, 0) !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0px !important;
    margin: 0px !important;
    padding: 0px !important;
}

.DatePickerButton:hover {
    border: 1px solid rgba(148, 163, 184, 0.5);
    background-color: rgba(255, 255, 255, 0.05);
}

.DatePickerButton:pressed {
    border: 1px solid {{accent-100}};
    background-color: rgba(19, 127, 236, 0.1);
}

.CalendarPopup {
    background-color: transparent;
    border: none;
}

.CalendarContent {
    background-color: {{bg-100}};
    border-radius: 10px;
}

.CalendarHeader {
    background-color: transparent;
}

.CalendarYearLabel {
    color: {{text-100}};
    padding-right: 6px;
    background-color: transparent;
}

.CalendarMonthLabel {
    color: {{text-100}};
    background-color: transparent;
}

.CalendarTodayButton {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    padding: 2px 6px;
}

.CalendarTodayButton:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.CalendarNavButton {
    color: {{text-100}};
    background-color: transparent;
    border: none;
    padding: 2px;
}

.CalendarNavButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.CalendarHelpContainer {
    background-color: transparent;
    border: none;
}

.CalendarHelpIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
    color: {{text-200}};
    border: none;
    background-color: transparent;
}

.CalendarHelpLabel {
    color: {{text-200}};
    font-family: "{{font-sans}}";
    font-size: 9pt;
    border: none;
    background-color: transparent;
}

/* Custom Calendar Base Styling */
QCalendarWidget.CustomCalendar {
    background: transparent;
    color: {{text-100}};
    border: none;
    font-size: 9pt;
}

QCalendarWidget.CustomCalendar QAbstractItemView:enabled {
    background-color: {{bg-100}};
    color: {{text-100}};
    selection-background-color: #ffffff;
    selection-color: #222222;
}

QCalendarWidget.CustomCalendar QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

QCalendarWidget.CustomCalendar QAbstractItemView::item {
    min-width: 40px;
    min-height: 34px;
    margin: 2px;
    padding: 2px;
    text-align: center;
    border-radius: 18px;
    font-size: 9pt;
}

QCalendarWidget.CustomCalendar QHeaderView::section { 
    color: {{text-200}}; 
    font-size: 8pt; 
    min-width: 40px;
    background-color: transparent;
    border: none;
}

QCalendarWidget.CustomCalendar QToolButton {
    font-size: 8pt;
}

QCalendarWidget.CustomCalendar QPushButton {
    font-size: 8pt;
}

/* Process Widgets (BackDropProgress, WaitingProcess) */
.ProcessBrand {
    font-family: "{{font-sans}}";
    font-size: 12px;
    font-weight: normal;
    letter-spacing: 5px;
    color: {{text-100}};
    background: transparent;
    text-transform: uppercase;
}

.ProcessTitle {
    font-family: "{{font-sans}}";
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #ffffff;
    background: transparent;
}

.ProcessStatusText {
    font-family: "{{font-sans}}";
    font-size: 40px;
    font-weight: 900;
    color: #ffffff;
    background: transparent;
}

.ProcessStatusText[state="error"] {
    color: #ff5252;
    font-size: 28px;
}

.ProcessSubText {
    font-family: "{{font-sans}}";
    font-size: 10px;
    letter-spacing: 2px;
    color: #00e5ff;
    background: transparent;
}

.ProcessSubText[state="error"] {
    color: #ff5252;
}

.ProcessBar {
    background-color: #1e293b;
    border: none;
    border-radius: 3px;
}

.ProcessBar::chunk {
    background-color: #00e5ff;
    border-radius: 3px;
}

.ProcessLogConsole {
    background-color: rgba(0, 0, 0, 160);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 6px;
}

.ProcessLogHeaderTitle {
    font-family: "{{font-gothic}}";
    font-size: 11px;
    color: #64748b;
    font-weight: bold;
    background: transparent;
}

.ProcessLogHeaderStatus {
    font-family: "{{font-gothic}}";
    font-size: 11px;
    color: #00e5ff;
    font-weight: bold;
    background: transparent;
}

.ProcessLogHeaderStatus[state="done"] {
    color: #4ade80;
}

.ProcessLogHeaderStatus[state="failed"] {
    color: #ff5252;
}

.ProcessLogSep {
    background-color: rgba(255, 255, 255, 0.08);
    border: none;
}

.ProcessLogScroll {
    background: transparent;
}

.ProcessLogRowDot {
    background-color: #00e5ff;
    border-radius: 3px;
    border: none;
}

.ProcessLogRowDot[state="pulse"] {
    background-color: #334155;
}

.ProcessLogRowText {
    font-family: "{{font-sans}}";
    font-size: 10pt;
    color: rgba(0, 229, 255, 0.7);
    border: none;
    background: transparent;
}

.ProcessLogRowText[state="pulse"] {
    font-size: 11px;
    color: #475569;
}

.ProcessLogRowStatus {
    font-family: "{{font-sans}}";
    font-size: 10pt;
    color: #ffffff;
    font-weight: bold;
    border: none;
    background: transparent;
}

.ProcessLogRowStatus[state="active"] {
    color: #00e5ff;
}

.ProcessLogRowStatus[state="error"] {
    color: #ff5252;
}

.ProcessActionButton {
    border-radius: 22px;
    font-weight: bold;
    min-height: 45px;
    font-family: "{{font-sans}}";
    font-size: 11pt;
}

.ProcessActionButton[type="main"] {
    background-color: rgba(0, 229, 255, 0.12);
    border: 1px solid #00e5ff;
    color: #00e5ff;
}

.ProcessActionButton[type="main"]:hover {
    background-color: #00e5ff;
    color: #121212;
}

.ProcessActionButton[type="secondary"] {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: {{text-200}};
}

.ProcessActionButton[type="secondary"]:hover {
    background-color: rgba(0, 229, 255, 0.1);
    border-color: #00e5ff;
    color: #00e5ff;
}

.BackDropFooterLine {
    background-color: rgba(255, 255, 255, 0.15);
    border: none;
}

/* RevisionBackdrop */
.RevisionBackdrop {
    qproperty-overlay_color: rgba(0, 0, 0, 180);
    qproperty-text_color: #ffffff;
    qproperty-notice_color: rgba(255, 255, 255, 180);
}

/* ============ TabManager & DrawingTabs ============ */
#tabContainer {
    background-color: {{bg-300}};
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
    /* 만약 하단까지 필요하시면 아래 추가 */
    /* border-bottom: 1px solid {{border-100}}; */
}

QTabWidget#DrawingTabWidget {
    background: {{bg-300}};
    border: none !important;
    margin: 0px;
    padding: 0px;
}

QTabWidget#DrawingTabWidget::pane {
    background: {{bg-300}};
    border: none !important;
    border-top: 1px solid {{border-100}};
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
    top: -1px;
    margin-right: 0px;
    padding: 0px;
}

QTabBar {
    left: 2px;
    right: 2px;
}

QTabWidget#DrawingTabWidget QTabBar::tab {
    background: {{bg-300}};
    border: none;
    border-right: 1px solid {{border-100}};
    border-bottom: 1px solid {{border-100}};
    min-height: 25px;
    min-width: 60px;
    padding: 4px 15px;
    margin-left: 1px;
    margin-right: 0px;
    color: {{text-100}};
}

QTabWidget#DrawingTabWidget QTabBar::tab[isDirty="true"] {
    border-bottom: 3px solid {{text-300}};
}

QTabWidget#DrawingTabWidget QTabBar::tab:selected {
    background: {{bg-100}};
    border-bottom: 1px solid {{border-100}};
    color: {{primary-100}};
}

QTabWidget#DrawingTabWidget QTabBar::tab:selected[isDirty="true"] {
    border-bottom: 3px solid {{text-300}};
}

QTabWidget#DrawingTabWidget QTabBar::tab:hover:!selected {
    background: {{bg-200}};
}


QTabWidget#DrawingTabWidget QTabBar::close-button {
    image: none;
    width: 0px;
    height: 0px;
}

.TabCloseButton {
    color: {{text-100}};
    background: transparent;
    border-radius: 2px;
    padding: 0px;
    margin: 0px;
    font-family: "{{font-icon}}" !important;
    font-size: 11px;
}

.TabCloseButton:hover {
    background: {{bg-300}};
    color: {{text-200}};
}

.TabCloseButton[pressed="true"] {
    background: {{primary-100}};
    color: white;
}

.TabStatusIndicator {
    background: transparent;
    padding: 0px;
    margin: 0px;
    font-family: "{{font-sans}}";
    font-size: 12pt;
    font-weight: bold;
}

.TabStatusIndicator[status="running"] { color: #ef4444; }
.TabStatusIndicator[status="ready"]   { color: #ef4444; }
.TabStatusIndicator[status="hidden"]  { color: transparent; }

.TabContextMenuFrame {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 10px;
}

.TabContextMenuButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px 14px;
    text-align: left;
    color: {{text-200}};
    font-size: 12px;
    min-height: 36px;
    max-height: 36px;
}

.TabContextMenuButton:hover {
    background: {{primary-100}};
    color: {{text-200}};
    font-weight: 600;
}

.TabContextMenuButton:pressed {
    background: {{primary-100}};
    color: {{text-200}};
    font-weight: 700;
}

.TabContextMenuButton:disabled {
    background: transparent;
    color: {{text-100}};
}

#TabContextPopupMenu {
    background: transparent;
    border: none;
}

/* ============ QGraphicsView ============ */

QGraphicsView {
    border: none !important;
    border-radius: 0px !important; /* 둥근 모서리 제거 */
    background-color: {{bg-100}};
    outline: none;
}


/* ============ ShapeSelectButton ============ */
.ShapeSelectButtonContainer {
    background-color: transparent;
    border: none;
}

.ShapeSelectButtonIconArea {
    background-color: {{bg-100}};
    border: none;
    border-radius: 0px;
}

.ShapeSelectButtonIconArea:hover {
    background-color: rgba(45, 45, 45, 178); /* Fallback for MOUSEOVER_OPACITY 0.7 */
}

/* Checked state */
.ShapeSelectButtonIconArea[active="true"] {
    background-color: {{accent-100}};
}

.ShapeSelectButtonArrowArea {
    background-color: {{bg-200}};
    border: none;
}

.ShapeSelectSeparatorContainer {
    background-color: transparent;
}

.ShapeSelectSeparatorLine {
    background-color: {{gray-medium}};
    border: none;
}

.ShapeSelectSeparatorLine[unfocused="true"] {
    background-color: rgba(127, 127, 127, 153); /* 0.6 opacity fallback */
}

.ShapeSelectButtonCaption {
    color: {{text-100}};
    background-color: transparent;
    border: none;
}

.ShapeSelectButtonCaption[unfocused="true"] {
    color: rgba(255, 255, 255, 153); /* 0.6 opacity fallback */
}

/* ShapeSelectPopupMenu */
.ShapeSelectPopupMenu {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
}

/* --- ToolbarWeldNoEdit Styles --- */
QWidget[class="ToolbarWeldNoEdit"] {
    background-color: transparent;
    border: none;
}

QFrame[class="ToolbarWeldNoEditFrame"] {
    background-color: #14171F; /* bg-100 */
    border: 1px solid #333947; /* bg-300 */
    border-radius: 8px;
}

QFrame[class="ToolbarWeldNoEditFrame"][focus="true"] {
    border: 1px solid #3ED973; /* green-medium */
}

QFrame[class="ToolbarWeldNoEditFrame"][unfocused="true"] {
    opacity: 0.6;
}

QSpinBox[class="ToolbarWeldNoEditSpinBox"] {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    padding: 1px;
    margin: 0px;
    font-size: 11pt;
}

QSpinBox[class="ToolbarWeldNoEditSpinBox"]::up-button, 
QSpinBox[class="ToolbarWeldNoEditSpinBox"]::down-button {
    width: 0px;
}

QLabel[class="ToolbarWeldNoEditPrefix"] {
    border: none;
    background: transparent;
    color: #9e9e9e; /* text-200 */
    font-size: 11pt;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QComboBox[class="ToolbarWeldNoEditPrefix"] {
    border: none;
    background: transparent;
    color: #9e9e9e; /* text-200 */
    font-size: 11pt;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QComboBox[class="ToolbarWeldNoEditPrefix"]::drop-down { width: 0; border: none; }
QComboBox[class="ToolbarWeldNoEditPrefix"]::down-arrow { image: none; width: 0; height: 0; }                                   
QComboBox[class="ToolbarWeldNoEditPrefix"] QAbstractItemView {
    background-color: #14171F;
    border: 1px solid #333947;
    border-radius: 4px;
    min-width: 150px;
}

QPushButton[class="ToolbarWeldNoEditButton"] {
    background-color: #1c212b; /* bg-200 */
    color: #9e9e9e;
    border: 1px solid #333947;
    border-radius: 2px;
    font-weight: bold;
    font-size: 10pt;
}

QPushButton[class="ToolbarWeldNoEditButton"]:hover {
    background-color: rgba(62, 217, 115, 0.2);
    border: 1px solid #3ED973;
    color: #FFFFFF;
}

QPushButton[class="ToolbarWeldNoEditButton"]:pressed {
    background-color: rgba(62, 217, 115, 0.4);
    border: 1px solid #3ED973;
}

/* ============ InsertStampWidget ============ */
.InsertStampWidget {
    background: transparent;
    border: none;
}

QFrame#StampMainContainer {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

.StampHeader {
    background-color: rgba(0,0,0,0.2);
    border: none;
    border-bottom: 1px solid {{border-100}};
}

.StampHeaderIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 20px;
    color: {{accent-100}};
    border: none;
}

.StampHeaderTitle {
    font-family: "{{font-sans-bold}}";
    font-size: 12px;
    font-weight: bold;
    color: {{text-200}};
    letter-spacing: 1px;
    border: none;
}

.StampActionsFrame {
    background-color: rgba(0,0,0,0.1);
    border: none;
    border-bottom: 1px solid {{border-100}};
}

.StampActionBtn {
    background-color: #2A2A2A;
    border: 1px solid #444444;
    border-radius: 4px;
}

.StampActionBtn:hover {
    background-color: #353535;
}

.StampActionIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 16px;
    color: white;
    border: none;
}

.StampActionLabel {
    font-family: "{{font-sans}}";
    font-size: 11px;
    color: white;
    border: none;
}

.StampScrollArea {
    border: none;
    background: transparent;
}

.StampScrollWidget {
    background: transparent;
}

.StampSectionTitle {
    font-family: "{{font-sans-bold}}";
    font-size: 10px;
    font-weight: bold;
    color: {{text-100}};
    letter-spacing: 1.5px;
    border: none;
    margin-bottom: 5px;
}

.StampPreviewItem {
    background-color: #FFFFFF;
    border: 2px solid {{border-100}};
    border-radius: 4px;
}

.StampPreviewItem:hover {
    border-color: {{accent-100}};
    background-color: #F8F8F8;
}

.StampFooter {
    background-color: rgba(0,0,0,0.2);
    border: none;
    border-top: 1px solid {{border-100}};
}

.StampFooterTip {
    font-family: "{{font-sans}}";
    font-size: 10px;
    color: {{text-100}};
    border: none;
}

.StampEmptyLabel {
    color: {{text-100}};
    font-size: 11px;
}

/* ============ FloatingTextToolbar Figma Style ============ */
#FloatingTextToolbarContainer {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    padding: 0px 0px;
}

#FloatingTextToolbarContainer QFrame {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
}

#FloatingTextToolbarContainer QLabel {
    color: {{text-200}};
    background-color: transparent;
    border: none;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

.FloatingGrip {
    color: {{text-100}};
    background-color: transparent;
    font-size: 24px;
    padding-left: 4px;
}

.FloatingCapsule {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 17px; /* For height 34px */
    padding: 1px 4px;
    color: {{text-200}};
    font-size: 12px;
}

.FloatingCapsule QAbstractItemView {
    background-color: {{bg-200}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    selection-background-color: {{primary-100}};
    outline: none;
    padding: 2px;
}

.FloatingCapsule QAbstractItemView::item {
    height: 28px;
    padding: 4px;
}

.FloatingCapsule QAbstractItemView::item:selected {
    background-color: {{primary-100}};
    border: 1px solid {{border-100}};
    color: {{text-200}};
}

.FloatingCapsule:hover {
    background-color: #323238;
    border-color: {{accent-100}};
}

.SegmentedControl {
    background-color: {{bg-100}};
    border-radius: 8px;
    padding: 0px;
    border: none;
}

.SegmentedButton {
    background-color: {{bg-100}};
    border: none;
    border-radius: 8px;
    color: {{text-100}};
    min-width: 24px;
    min-height: 24px;
    font-family: {{font-icon}};
    font-size: 14px;
}

.SegmentedButton:hover {
    background-color: #3a3a3e;
    color: {{text-200}};
}

.SegmentedButton:checked {
    background-color: {{accent-100}};
    color: {{text-300}};
}

.FloatingSlider::groove:horizontal {
    border: none;
    height: 2px;
    background: {{border-100}};
    margin: 0px;
    border-radius: 1px;
}

.FloatingSlider::handle:horizontal {
    background: {{accent-100}};
    border: 2px solid {{border-100}};
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

.FloatingSlider::handle:horizontal:hover {
    background: {{text-300}};
}

.DigitalValue {
    background-color: #2a2a2e;
    border-radius: 4px;
    color: {{accent-100}};
    font-size: 12px;
    font-weight: bold;
    padding: 1px 2px;
    min-width: 32px;
}

.FloatingSeparator {
    background-color: {{border-100}};
    width: 1px;
    max-width: 1px;
    margin: 2px 2px; 
}

.ColorIcon {
    border-radius: 12px;
    border: 2px solid #444448;
}

.FloatingModernLabel {
    color: {{text-200}};
    background-color: transparent;
    border: none;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

/* ============ ProjectEditForm & Sub-widgets ============ */
.ProjectEditFormContainer {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

.ProjectEditFormHeader {
    background-color: rgba(15, 35, 35, 0.3);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

.HeaderIconBox {
    background-color: rgba(0, 224, 224, 0.2);
    border-radius: 8px;
}

.HeaderTitle {
    color: {{text-200}};
    font-size: 20px;
    font-weight: bold;
}

.HeaderSubtitle {
    color: {{text-100}};
    font-size: 12px;
}

.HeaderCloseBtn {
    background: transparent;
    border: none;
    color: {{text-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
}
.HeaderCloseBtn:hover {
    color: {{text-200}};
}

.HeaderLine, .FooterLine {
    background-color: {{border-100}};
    max-height: 1px;
}

.InfoBox {
    background-color: rgba(0, 224, 224, 0.05);
    border: 1px solid rgba(0, 224, 224, 0.1);
    border-radius: 8px;
}

.InfoText {
    color: {{text-100}};
    font-size: 11px;
}

.ProjectEditFormFooter {
    background-color: rgba(15, 35, 35, 0.3);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.CancelButton {
    background-color: transparent;
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-100}};
    font-size: 14px;
    font-weight: bold;
}
.CancelButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.SaveButton {
    background-color: {{primary-100}};
    border: none;
    border-radius: 8px;
}
.SaveButton:hover {
    background-color: {{primary-200}};
}

.FieldLabel {
    color: {{text-200}};
    font-size: 12px;
    font-weight: bold;
    padding: 0px 0px 5px 0px;
    text-transform: uppercase;
}

/* Modern Widgets Classes */
.ModernLineEditInner {
    background-color: rgba(15, 35, 35, 0.5);
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-200}};
}
.ModernLineEditInner[state="focus"] {
    border: 2px solid {{primary-100}};
    background-color: rgba(15, 35, 35, 0.8);
}

.ModernLineEditIcon {
    background: transparent;
    color: {{text-200}};
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
    border: none;
}

.ModernLineEditBox {
    background-color: transparent;
    border: none;
    color: {{text-200}};
    selection-color: {{text-200}};
    selection-background-color: {{primary-100}};
    font-size: 14px;
}
.ModernLineEditBox::placeholder {
    color: {{text-100}};
}

.ModernDateEdit {
    background-color: rgba(15, 35, 35, 0.5);
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-200}};
    padding: 0 16px;
    font-size: 14px;
}
.ModernDateEdit:focus {
    border: 2px solid {{primary-100}};
    background-color: rgba(15, 35, 35, 0.8);
}
.ModernDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px;
    border-top-right-radius: 3px; 
    border-bottom-right-radius: 3px;
    background-image: none; 
}

.ModernTextEdit {
    background-color: rgba(15, 35, 35, 0.5);
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-200}};
}
.ModernTextEdit[state="focus"] {
    border: 2px solid {{primary-100}};
    background-color: rgba(15, 35, 35, 0.8);
}

.ModernTextEditor {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: {{text-200}};
    padding: 14px;
    font-size: 14px;
}
.ModernTextEditor::placeholder {
    color: {{text-100}};
}

.ModernDatePickerButton {
    background-color: rgba(15, 35, 35, 0.5);
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-200}};
    padding: 0;
}
.ModernDatePickerButton[state="focus"] {
    border: 2px solid {{primary-100}};
    background-color: rgba(15, 35, 35, 0.8);
}
.ModernDatePickerButton:hover {
    border: 1px solid {{primary-100}};
}

.DatePickerText {
    background: transparent;
    border: none;
    color: {{text-200}};
    font-size: 14px;
    padding: 0;
}

.DatePickerIcon {
    background: transparent;
    border: none;
    color: {{text-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 16px;
}

.SaveButtonText {
    font-weight: 900;
    color: white;
    font-size: 14px;
    background: transparent;
}

/* OrderEditForm Styles */
.OrderFormContainer {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

.OrderFormHeader {
    border: none;
    background-color: {{bg-200}};
}

.OrderFormIconBg {
    background-color: rgba(0, 224, 224, 0.2);
    border-radius: 8px;
}

.OrderFormTitle {
    color: {{text-200}};
    font-family: "{{font-sans}}";
    font-size: 18px;
    font-weight: bold;
    border: none;
}

.OrderFormSubtitle {
    color: {{text-100}};
    font-family: "{{font-sans}}";
    font-size: 12px;
    border: none;
}

.OrderFormProjectText {
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 16px;
    font-weight: bold;
    border: none;
}

.OrderFormScrollArea {
    background: transparent;
    border: none;
}

.OrderFormScrollArea QWidget {
    background: transparent;
}

.AccordionSection {
    background-color: rgba(41, 52, 56, 0.2); 
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

.AccordionHeader {
    border: none;
    background: transparent;
}

.AccordionTitle {
    color: {{text-200}};
    font-family: "{{font-sans}}";
    font-size: 16px;
    font-weight: bold;
    border: none;
}

.AccordionArrow {
    color: {{text-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
    border: none;
}

.AccordionContent {
    background: transparent;
}

.AccordionSeparator {
    background-color: {{border-100}};
    border: none;
}

.SectionHeaderIcon {
    color: {{primary-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 16px;
    border: none;
}

.SectionHeaderTitle {
    color: {{text-100}};
    font-family: "{{font-sans}}";
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.FieldLabel {
    color: {{text-100}};
    font-family: "{{font-sans}}";
    font-size: 12px;
    font-weight: 600;
}

.InfoBox {
    background-color: rgba(0, 224, 224, 0.05);
    border: 1px solid rgba(0, 224, 224, 0.1);
    border-radius: 8px;
}

.InfoBoxText {
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 12px;
}

.OrderFormFooter {
    border: none;
    background-color: {{bg-200}};
}

.OrderCancelButton {
    background-color: transparent;
    color: {{text-100}};
    font-family: "{{font-sans}}";
    font-size: 14px;
    font-weight: bold;
    border-radius: 8px;
}

.OrderCancelButton:hover {
    background-color: rgba(17, 29, 33, 0.5);
    color: {{text-200}};
}

.OrderSaveButton {
    background-color: {{primary-100}};
    border: none;
    border-radius: 8px;
}

.OrderSaveButton:hover {
    background-color: {{primary-200}};
}

.OrderSaveButton:pressed {
    background-color: {{primary-300}};
}

.OrderSaveButtonText {
    background-color: transparent;
    color: white;
    font-family: "{{font-sans}}";
    font-size: 14px;
    font-weight: bold;
    border: none;
}

.OrderSaveButtonIcon {
    background-color: transparent;
    color: white;
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
    border: none;
}

/* ============ WelderListForm (용접사 현황 양식) ============ */
#WelderListContainer {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

#WelderListSidebar {
    background-color: {{bg-100}};
    border-right: 1px solid {{border-100}};
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

#WelderListSidebarHeader {
    background-color: {{bg-100}};
    border: none;
    border-radius: 0px;
    border-bottom: 1px solid {{border-100}}; 
    border-top-left-radius: 12px;
}

#WelderListSidebarFooter {
    background-color: rgba(30, 30, 30, 0.3);
    border: none;
    border-top: 1px solid {{border-100}};
    border-radius: 0px;
    border-bottom-left-radius: 12px;
}

#WelderListMainArea {
    background-color: {{bg-100}};
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* Sidebar Search */
#WelderListSearchInput {
    background-color: {{bg-200}};
    border: none;
    border-radius: 8px;
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 14px;
}
#WelderListSearchInput:focus {
    border: 1px solid {{primary-100}};
}

#WelderListSearchIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 20px;
    color: {{text-100}};
    background: transparent;
    border: none;
}

#WelderListSidebarIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
    color: {{primary-100}};
    background: transparent;
    border: none;
}

#WelderListSidebarTitle {
    font-family: "{{font-sans}}";
    font-size: 18px;
    font-weight: 700;
    color: {{text-100}};
    background: transparent;
    border: none;
    padding-left: 4px;
}

/* Welder List Item */
WelderItemWidget {
    background-color: transparent;
    border-radius: 0px;
    border-bottom: 1px solid {{border-100}};
    border-left: 4px solid transparent;
}
WelderItemWidget:hover {
    background-color: {{bg-300}};
}
WelderItemWidget[active="true"] {
    background-color: {{bg-200}};
    border-left: 4px solid {{primary-100}};
}

WelderItemWidget QLabel#WelderID {
    font-family: "{{font-sans}}";
    font-size: 12px;
    font-weight: 500;
    color: {{text-100}};
    border: none;
    background: transparent;
}

WelderItemWidget QLabel#WelderName {
    font-family: "{{font-sans}}";
    font-size: 16px;
    font-weight: 600;
    color: #E0E0E0;
    border: none;
    background: transparent;
}
WelderItemWidget[active="true"] QLabel#WelderName {
    color: {{text-300}};
}

WelderItemWidget QLabel#WelderChevron {
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
    color: {{text-100}};
    border: none;
    background: transparent;
}

QPushButton#WelderFormAddBtn {
    background-color: rgba(69, 142, 142, 0.15);
    border: 1px dashed {{primary-100}};
    border-radius: 12px;
}

QPushButton#WelderFormAddBtn:hover {
    background-color: rgba(69, 142, 142, 0.25);
    border: 1px solid {{primary-100}};
}

QPushButton#WelderFormAddBtn QLabel {
    color: {{primary-100}} !important;
    background: transparent;
    border: none;
    font-family: "{{font-sans}}";
    font-size: 16px;
    font-weight: 700;
}

QPushButton#WelderFormAddBtn QLabel[class="Icon"] {
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
}

QPushButton.WelderAssignBtn {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 13px;
    font-weight: 600;
}
QPushButton.WelderAssignBtn:hover {
    background-color: {{primary-100}};
    color: white;
    border: none;
}

/* Form Layout */
#WelderFormHeader {
    border-top-right-radius: 12px;
    border-bottom: 1px solid {{border-100}};
    padding-bottom: 16px;
}

#WelderStatusTag {
    background-color: rgba(34, 115, 195, 0.2);
    color: {{primary-100}};
    font-family: "{{font-sans}}";
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 12px;
    border: none;
}

#WelderFormTitleInput {
    background: transparent;
    border: none;
    border-radius: 0px;
    border-bottom: 1px solid transparent;
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 40px;
    font-weight: 700;
    padding-top: 15px;
    padding-bottom: 2px;
}
#WelderFormTitleInput[sub="true"] {
    color: {{text-100}};
    font-size: 24px;
    font-weight: normal;
}
#WelderFormTitleInput[skill="true"] {
    color: {{text-100}};
    font-size: 20px;
    font-weight: normal;
}
#WelderFormTitleInput:focus:!readOnly {
    border-bottom: 1px solid {{primary-100}};
}

#WelderCloseBtn {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    border-radius: 4px;
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
    padding-bottom: 2px;
}
#WelderCloseBtn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: {{text-300}};
}

/* Sections */
QLabel.WelderSectionHeader {
    font-family: "{{font-sans}}";
    font-size: 14px;
    font-weight: 700;
    color: {{text-100}};
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
}

QLabel.WelderSectionIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 14px;
    color: {{text-100}};
    border: none;
}

QFrame.WelderInfoCard {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

/* Photo Widget */
WelderPhotoWidget {
    background-color: {{bg-200}};
    border: 1px solid transparent;
    border-radius: 12px;
}
WelderPhotoWidget[editMode="true"] {
    border: 2px dashed {{primary-100}};
}

WelderPhotoWidget QLabel#PhotoIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 36px;
    color: {{text-100}};
    border: none;
}

WelderPhotoWidget QPushButton#RotateBtn {
    background-color: rgba(0, 0, 0, 0.6);
    color: white;
    border-radius: 15px;
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0px;
    margin: 0px;
}
WelderPhotoWidget QPushButton#RotateBtn:hover {
    background-color: {{primary-100}};
    border: 1px solid {{primary-100}};
}

/* Resume Widget */
WelderResumeWidget {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

WelderResumeWidget QLabel#ResumeIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 32px;
    color: #3B82F6; 
    padding: 10px;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 8px;
}

WelderResumeWidget QLabel#ResumeName { 
    color: {{text-300}}; 
    font-weight: 700; 
    font-size: 16px; 
    border: none; 
}
WelderResumeWidget QLabel#ResumeDesc { 
    color: {{text-100}}; 
    font-size: 14px; 
    border: none; 
}
WelderResumeWidget QLabel#ResumeAction {
    font-family: "{{font-icon}}" !important;
    font-size: 24px;
    color: {{text-100}};
}
WelderResumeWidget[editMode="true"] QLabel#ResumeAction {
    color: {{primary-100}};
}

/* Timeline/Fields */
WelderEditableField QLabel.WelderFieldTitle {
    color: {{text-100}};
    font-size: 14px;
    border: none;
}

/* Styled for View Mode by default */
WelderEditableField QLineEdit.WelderFieldValue {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 16px;
    font-weight: 500;
    text-align: right;
    padding: 0;
}

/* Edit Mode border if not readOnly */
WelderEditableField QLineEdit.WelderFieldValue:focus:!readOnly {
    border-bottom: 1px solid {{primary-100}};
}

TimelineItemWidget QLabel.TimelineTitle {
    color: {{text-100}};
    font-weight: 700;
    font-size: 13px;
    border: none;
}

TimelineItemWidget QLabel.TimelineBadge {
    background-color: rgba(249, 115, 22, 0.1);
    color: #FB923C;
    font-family: "{{font-sans}}";
    font-weight: 700;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 4px;
    border: none;
}

/* DatePicker Inside Timeline */
ModernDatePicker QLabel#DatePickerText {
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 14px;
    background: transparent;
    border: none;
}
ModernDatePicker[editMode="true"] QLabel#DatePickerText {
    font-weight: bold;
}

ModernDatePicker QLabel#DatePickerIcon {
    color: {{text-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 18px;
    background: transparent;
    border: none;
}

ModernDatePicker QPushButton {
    background-color: rgba(15, 35, 35, 0.5);
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-200}};
}
ModernDatePicker QPushButton:hover {
    border: 1px solid {{primary-100}};
}
ModernDatePicker QPushButton:focus {
    border: 2px solid {{primary-100}};
}

/* Action Buttons in Header */
QPushButton.WelderFormBtn {
    border-radius: 8px;
    font-family: "{{font-sans}}";
    font-size: 14px;
    font-weight: 600;
    padding-bottom: 2px;
}

QPushButton.WelderFormBtn[class*="Primary"] { 
    background-color: {{primary-100}}; 
    color: white; 
    border: none; 
}
QPushButton.WelderFormBtn[class*="Primary"]:hover { 
    background-color: {{primary-200}}; 
}

QPushButton.WelderFormBtn[class*="Danger"] { 
    background-color: transparent; 
    color: #EF4444; 
    border: none; 
}
QPushButton.WelderFormBtn[class*="Danger"]:hover { 
    background-color: rgba(239, 68, 68, 0.1); 
}

QPushButton.WelderFormBtn[class*="Secondary"] { 
    background-color: {{bg-200}}; 
    color: {{text-200}}; 
    border: 1px solid {{border-100}}; 
}
QPushButton.WelderFormBtn[class*="Secondary"]:hover { 
    background-color: {{border-100}}; 
}
