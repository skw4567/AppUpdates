# Dark Theme Color Scheme
# 10가지 색 계열 × 3단계 시스템

# Primary Colors (UI 기본 색상)
primary-100:#0085ff;
primary-200:#69b4ff;
primary-300:#e0ffff;

# Accent Colors (강조 색상)
accent-100:#006fff;
accent-200:#e1ffff;

# Text Colors (텍스트 색상)
text-100:#9e9e9e;
text-200:#FFFFFF;
text-300:#FF9D56;


# Background Colors (배경 색상)
bg-100:#1A1F2B;
bg-200:#1a242d;
bg-300:#14171F;
bg-400:#292e3b;


# SVG Icon Colors (아이콘 색상)
svg-icon-100:#FFFFFF;
svg-icon-200:#9e9e9e;

# Border Colors (테두리 색상)
border-100:#3b4754;
border-200:#3a3a3a;
border-300:#4a4a4a;
border-400:#ffffff;

# Red Colors (빨강 - 경고/에러)
red-light:#E63946;
red-medium:#DC143C;
red-dark:#991B1B;

# Orange Colors (주황 - 주의)
orange-light:#E8843A;
orange-medium:#D97706;
orange-dark:#92400E;

# Yellow Colors (노랑 - 진행)
yellow-light:#CA8A04;
yellow-medium:#B8860B;
yellow-dark:#78350F;

# Green Colors (녹색 - 완료/성공)
green-light:#4B9D6F;
green-medium:#16A34A;
green-dark:#15803D;

# Cyan Colors (청록 - 정보)
cyan-light:#4B8E9F;
cyan-medium:#0891B2;
cyan-dark:#155E75;

# Blue Colors (파랑 - 대기/정보)
blue-light:#4F7BA7;
blue-medium:#2563EB;
blue-dark:#1E40AF;

# Purple Colors (보라 - 검토)
purple-light:#8B5CF6;
purple-medium:#7C3AED;
purple-dark:#5B21B6;

# Magenta Colors (마젠타 - 특수)
magenta-light:#D946A6;
magenta-medium:#C2185B;
magenta-dark:#880E4F;

# Brown Colors (갈색 - 보류)
brown-light:#A16207;
brown-medium:#92400E;
brown-dark:#5A2E0A;

# Gray Colors (회색 - 비활성)
gray-light:#9CA3AF;
gray-medium:#6B7280;
gray-dark:#374151;
