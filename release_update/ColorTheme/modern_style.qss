/* 
 * the PLUS Piping - Global Modern Stylesheet Template
 * Placeholders like {{bg-100}} will be replaced by ThemeManager at runtime.
 */

/* 기본 배경 및 텍스트 */
QMainWindow {
    background-color: {{bg-100}};
    color: {{text-100}};
    font-weight: normal;
}

/* 1. 수직 & 수평 스크롤바 본체 공통 설정 */
QScrollBar:vertical, QScrollBar:horizontal,
QScrollArea QScrollBar:vertical, QScrollArea QScrollBar:horizontal,
QAbstractScrollArea QScrollBar:vertical, QAbstractScrollArea QScrollBar:horizontal,
QGraphicsView QScrollBar:vertical, QGraphicsView QScrollBar:horizontal {
    border: none;
    background: {{bg-300}};
    margin: 0px;
    border-radius: 4px;
}

QScrollBar:vertical, QScrollArea QScrollBar:vertical, QAbstractScrollArea QScrollBar:vertical, QGraphicsView QScrollBar:vertical { width: 8px; }
QScrollBar:horizontal, QScrollArea QScrollBar:horizontal, QAbstractScrollArea QScrollBar:horizontal, QGraphicsView QScrollBar:horizontal { height: 8px; }

/* 2. 스크롤바 핸들 (움직이는 부분) */
QScrollBar::handle:vertical, QScrollBar::handle:horizontal,
QScrollArea QScrollBar::handle:vertical, QScrollArea QScrollBar::handle:horizontal,
QAbstractScrollArea QScrollBar::handle:vertical, QAbstractScrollArea QScrollBar::handle:horizontal,
QGraphicsView QScrollBar::handle:vertical, QGraphicsView QScrollBar::handle:horizontal {
    background: {{primary-100}};
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical, QScrollArea QScrollBar::handle:vertical, QAbstractScrollArea QScrollBar::handle:vertical, QGraphicsView QScrollBar::handle:vertical { min-height: 20px; }
QScrollBar::handle:horizontal, QScrollArea QScrollBar::handle:horizontal, QAbstractScrollArea QScrollBar::handle:horizontal, QGraphicsView QScrollBar::handle:horizontal { min-width: 20px; }

/* 3. 핸들 호버 효과 */
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover,
QScrollArea QScrollBar::handle:vertical:hover, QScrollArea QScrollBar::handle:horizontal:hover,
QAbstractScrollArea QScrollBar::handle:vertical:hover, QAbstractScrollArea QScrollBar::handle:horizontal:hover,
QGraphicsView QScrollBar::handle:vertical:hover, QGraphicsView QScrollBar::handle:horizontal:hover {
    background: {{primary-200}};
}


/* 4. 화살표 버튼 제거 */
QScrollBar::add-line, QScrollBar::sub-line,
QScrollArea QScrollBar::add-line, QScrollArea QScrollBar::sub-line,
QAbstractScrollArea QScrollBar::add-line, QAbstractScrollArea QScrollBar::sub-line,
QGraphicsView QScrollBar::add-line, QGraphicsView QScrollBar::sub-line {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

/* 5. 배경 (페이지 이동 영역) */
QScrollBar::add-page, QScrollBar::sub-page,
QScrollArea QScrollBar::add-page, QScrollArea QScrollBar::sub-page,
QAbstractScrollArea QScrollBar::add-page, QAbstractScrollArea QScrollBar::sub-page,
QGraphicsView QScrollBar::add-page, QGraphicsView QScrollBar::sub-page {
    background: transparent;
}

QSplitter {
    background-color: {{bg-100}};
    border: none;
}

QSplitter::handle {
    background-color: {{bg-100}};
    border: none;
}

QSplitter::handle:horizontal:hover,
QSplitter::handle:horizontal:pressed {
    background-color: {{primary-100}};
}

.FieldLabel {
    background: transparent;
    color: {{text-200}};
    font-size: 9pt;
    font-weight: 600;
    padding-right: 2px;
}

.PlusTitleBar {
    background-color: {{bg-200}};
    border-bottom: 1px solid {{border-100}};
}

QStatusBar {
    background-color: {{bg-200}};
    border-radius: 0px;
    color: {{text-100}};
    padding: 10px; 
    border-top: 1px solid {{border-100}};
    font-weight: normal;
}

QStatusBar[statusState="error"] {
    color: #ff5252;
}

QStatusBar[statusState="success"] {
    color: #4caf50;
}

QLabel { 
    background-color: transparent; 
    color: {{text-100}}; 
}

/* ============ Public Transparent Dialor Styles ============ */
.TransparentShadowDialog {
    background-color: transparent;
}


/* ============ Public Widget Styles ============ */
.DockPanel {
    background-color: {{bg-100}} !important;
    border-left: 1px solid {{border-100}} !important;
    border-right: 1px solid {{border-100}} !important;
    border-top: none !important;
    border-bottom: none !important;
}

.PageWidgetContainer {
    background-color: {{bg-300}};
    border: none;
    border-radius: 0px;
}

.PageWidgetContainer[border="right"] {
    border: none;
    border-right: 1px solid {{border-100}};
}

.PageWidgetContainer[border="left"] {
    border: none;
    border-left: 1px solid {{border-100}};
}

.PageWidgetContainer[border="right_left"] {
    border: none;
    border-right: 1px solid {{border-100}};
    border-left: 1px solid {{border-100}};
}

.PageWidgetHeader {
    background-color: {{bg-200}};
    border-bottom: 1px solid {{border-100}};
}

.PageWidgetFooter {
    background-color: {{bg-200}};
    border-top: 1px solid {{border-100}};
}

.SearchInput {
    background: transparent;
    border: none;
    color: white;
    font-size: 10pt;
    padding: 0px;
}

.PageWidgetScrollArea {
    background: transparent;
    border: none;
}

.PageWidgetScrollContent {
    background-color: {{bg-100}};
    border: none;
}


.GalleryItem {
    background-color: transparent;
    border: 0px;
    border-radius: 0px;
}

.GalleryItem[hover="true"] {
    border: 1px solid {{primary-100}};
}

.GalleryItem[selected="true"] {
    border: 2px solid {{primary-100}};
}

QLabel#OverlayLabel {
    background-color: rgba(0, 0, 0, 180);
    color: {{text-200}};
    font-size: 8pt;
    padding: 0px;
}


/* ============ Dialog Styles ============ */
.OpacityPopupContainer {
    background-color: {{bg-300_op60}};
    border: 2px solid {{border-100}};
    border-radius: 16px;
}

/* ============ Public Button Styles ============ */

.ButtonPrimary {
    background-color: {{primary-100}}; 
    color: white; 
    border: none; 
    border-radius: 4px; 
    padding: 6px 12px; 
    font-weight: bold; 
    font-size: 9pt;
}
.ButtonPrimary:hover {
    background-color: {{primary-200}};
}
.ButtonPrimary:pressed {
    background-color: {{primary-200_op20}};
}

.ButtonSecondary {
    background-color: {{bg-300_op20}}; 
    color: {{text-200}}; 
    border: none; 
    border-radius: 4px; 
    padding: 6px 12px; 
    font-weight: bold; 
    font-size: 9pt;
}
.ButtonSecondary:hover {
    background-color: {{bg-200_op40}};
}
.ButtonSecondary:pressed {
    padding: 0 16px;
    margin: 0;
}

.ButtonDanger {
    background-color: #F43F5E; 
    color: white; 
    border: none; 
    border-radius: 4px; 
    padding: 6px 12px; 
    font-weight: bold; 
    font-size: 9pt;
}
.ButtonDanger:hover {
    background-color: #f43f5e;
}

.WelderListFormInput[mode="view"] {
    background-color: transparent;
    border: none;
    color: {{text-100}};
}

.WelderListFormInput[mode="edit"] {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid {{primary-100}};
    color: {{text-100}};
}

QProgressBar[status="success"]::chunk {
    background-color: #1FA55B;
}

.DialogBtnPrimary {
    background-color: {{primary-100}};
    color: white;
    border: none;
    border-radius: 0px;
    font-weight: bold;
    font-size: 10pt;
    min-height: 36px;
    padding: 0 16px;
}

.DialogBtnPrimary:hover {
    background-color: {{primary-200}};
}

.DialogBtnPrimary:pressed {
    background-color: {{primary-200_op20}};
    padding: 0 16px;
    margin: 0;
}

.DialogBtnSecondary {
    background-color: transparent;
    color: {{text-100}};
    border: 1px solid {{primary-100}};
    border-radius: 0px;
    font-weight: bold;
    font-size: 10pt;
    min-height: 36px;
    padding: 0 16px;
}

.DialogBtnSecondary:hover {
    background-color: {{bg-100}};
}

.DialogBtnSecondary:pressed {
    padding: 0 16px;
    margin: 0;
}

.DialogBtnDanger {
    background-color: #F43F5E; 
    color: white; 
    border: none; 
    border-radius: 4px; 
    padding: 6px 12px; 
    font-weight: bold; 
    font-size: 8pt;
}
.DialogBtnDanger:hover {
    background-color: #f43f5e;
}


.DialogBtnClose {
    background-color: {{bg-200}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    border-radius: 0px;
    font-size: 10pt;
    padding: 0;
    font-weight: bold;
}

.DialogBtnClose:hover {
    background-color: #ef4444;
    color: {{text-200}};
    border: 1px solid #ef4444;
}

.DialogBtnClose:pressed {
    color: {{text-200}};
    padding: 2px 2px;
    margin: 0;
}
/* ============ End Public Button Styles ============ */

/* =============== 아이콘만 가진 버튼 정의 ===============*/

.IconButton16 {
    background-color: transparent;
    color: {{svg-icon-100}};
    border: none;
    border-radius: 4px;
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
    min-width: 32px;
    min-height: 32px;
}

.IconButton16:hover {
    background-color: {{bg-300}};
    color: {{svg-icon-200}};
}

.IconButton16:checked {
    /* 기존 hover보다 더 명확하게 구분되도록 약간 더 밝은 배경색과 하이라이트 컬러 지정 */
    background-color: {{bg-300}}; 
    color: {{svg-icon-300}}; /* 또는 원하시는 강조 테마 컬러 변수 주입 */
}

/* [신규 추가] 2. Checked 상태인 버튼 위에 마우스가 올라갔을 때의 피드백 스타일 */
.IconButton16:checked:hover {
    background-color: {{bg-300}};
    color: {{svg-icon-300_op80}};
}
/* ============= 아이콘만 가진 버튼 정의 종료 ============*/


/* ============ Icons ============ */
.Icon {
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
}

.Icon[active="true"] { color: {{text-200}}; }
.Icon[active="false"] { color: {{text-100}}; }

.Icon_18 {
    background: transparent;
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
}
.Icon_18[active="true"] { color: {{text-200}}; }
.Icon_18[active="false"] { color: {{text-100}}; }

.IconText {
    background: transparent;
    font-size: 9pt;
}
.IconText[active="true"] { color: {{text-200}}; }
.IconText[active="false"] { color: {{text-100}}; }


.Icon_primary {
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
    color: {{primary-100}};
}

.Icon_primary[active="true"] { color: {{primary-100}}; }
.Icon_primary[active="false"] { color: {{text-100}}; }

.PanelIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 14pt;
    color: {{primary-100}};
}

.PanelIcon[active="true"] { color: {{primary-100}}; }
.PanelIcon[active="false"] { color: {{text-100}}; }

.PanelSubIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 11pt;
    color: {{text-200}};
}

.PanelSubIcon[active="true"] { color: {{primary-100}}; }
.PanelSubIcon[active="false"] { color: {{text-200}}; }


/* ============ End Icons Styles ============ */


/* ============ Weather Detail Popup ============ */
.DetailCalIcon { color: {{primary-200}}; font-family: "{{font-icon}}" !important; font-size: 12pt; }
.DetailDate { color: {{text-100}}; font-size: 11pt; font-weight: bold; letter-spacing: 1px; }

.DetailMainIcon { color: {{primary-200}}; font-family: "{{font-icon}}" !important; font-size: 62pt; }
.DetailMainTemp { color: {{text-200}}; font-size: 46pt; font-weight: bold; }
.DetailDesc { color: {{primary-200}}; font-size: 14pt; font-weight: bold; margin-left: 85px; }

.DetailLocIcon { color: {{text-100}}; font-family: "{{font-icon}}" !important; font-size: 12pt; }
.DetailLoc { color: {{text-100}}; font-size: 11pt; }

.SiteBadge {
    background-color: rgba(77, 208, 225, 0.2);
    color: {{primary-200}};
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 9pt;
    font-weight: bold;
}

.StatTitle { color: {{text-100}}; font-size: 8pt; font-weight: bold; }
.StatValue { color: {{text-200}}; font-size: 13pt; font-weight: bold; }

.DetailDivider { background-color: rgba(255,255,255,0.05); max-height: 1px; }
.DetailHeader { color: {{text-200}}; font-size: 13pt; font-weight: bold; letter-spacing: 1px; }

.NavArrow {
    background-color: {{bg-300}};
    color: {{primary-200}};
    border: none;
    border-radius: 8px;
    font-family: "{{font-icon}}" !important;
    font-size: 14pt;
}
.NavArrow:hover {
    background-color: {{text-300}};
    color: {{primary-100}};
    border-color: {{primary-100}};
}

.WeatherPillsContainer { background-color: transparent; }
/* ============ Weather Detail Popup End ============ */

.WorkspaceTaans {
    background-color: transparent;
    color: {{text-100}};
    font-weight: normal;
    border-radius: 0px;
}


.Workspace {
    background-color: {{bg-300}};
    color: {{text-100}};
    font-weight: normal;
    border-radius: 0px;
}

.Container {
    background-color: {{bg-100}};
    color: {{text-100}};
    border-radius: 8px;
}

.DialogBackdrop {
    background-color: rgba(0, 0, 0, 150);
}

.DialogContainer {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

.DialogHeader {
    background-color: {{bg-200}};
    border-bottom: 1px solid {{border-100}};
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

.DialogContent {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
}

.DialogContentRect {
    background-color: {{bg-300}};
    border: none;
    border-radius: 0px;
}


.DialogFooter {
    background-color: {{bg-200}};
    border-top: 1px solid {{border-100}};
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.DialogTitle {
    color: {{text-200}};
    font-size: 18pt;
    font-weight: bold;
}

.HeaderIconBox {
    background-color: rgba(0, 224, 224, 0.2);
    border-radius: 8px;
}

.HeaderTitle {
    color: {{text-200}};
    font-size: 18pt;
    font-weight: bold;
}

.HeaderSubtitle {
    color: {{text-100}};
    font-size: 10pt;
}

.PrintPreeviewThumbnail {
    background-color: {{bg-300}};
    border: none;
    border-right: 1px solid {{border-100}};
    border-radius: 0px;
    border-bottom-left-radius: 12px;
}

.PrintPreeviewScrollContent {
    background-color: transparent;
}


/* PropertyEditDialog section styling */
.PropertyEditorPanelSection {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 5px;
    padding: 10px;
}

.PropertyEditPreview {
    background: transparent; 
    border: 2px dashed #5c6b7d; 
    border-radius: 5px;
}

.PropertySlider { 
    border: none; 
    height: 32px; 
    background: transparent; 
}

.PropertySlider::groove:horizontal {
    height: 4px; 
    background: {{border-100}}; 
    border-radius: 2px; 
}

.PropertySlider::handle:horizontal {
    width: 16px; 
    height: 16px; 
    background: {{primary-100}}; 
    border-radius: 8px; 
    margin: -6px 0; 
    border: none; 
}


QPushButton.MarkerButton, QPushButton[class="MarkerButton"] {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-100}};
}
QPushButton.MarkerButton:hover, QPushButton[class="MarkerButton"]:hover {
    background-color: {{bg-400}};
}
QPushButton.MarkerButton:checked, QPushButton[class="MarkerButton"]:checked {
    background-color: rgba(92, 130, 157, 0.2);
    border: 2px solid {{primary-100}};
    color: {{text-200}};
}

QHeaderView::section {
    background-color: {{bg-300}};
    color: {{text-100}};
    padding: 6px;
    border: none;
    border-right: 1px solid {{bg-200}};
    border-bottom: 1px solid {{bg-200}};
    font-weight: bold;
}

/* ============ PlusMultiHeaderTable & TableComboBox (Excel-style) ============ */
QFrame#mainTable, QFrame#frozenTable {
    border: none;
    background-color: transparent;
    outline: none;
}
QFrame#mainTable { background-color: {{bg-100}}; }
QFrame#frozenTable { background-color: {{bg-200}}; }

#frozenSeparator {
    background-color: {{primary-100}};
    min-width: 3px;
    border-left: 1px solid {{primary-100}}99;
    border-right: 1px solid {{primary-100}}44;
}

/* Header Labels */
QLabel[type="group"], QLabel[type="detail"], ClickableHeaderLabel[type="detail"] {
    background-color: {{bg-200}};
    color: {{text-300}}; /* Orange accent for headers */
    font-weight: 700;
    font-size: 10pt;
    border: none;
    border-right: 1px solid {{border-100}};
    padding: 2px;
}
QLabel[type="group"] { border-bottom: 1px solid {{border-100}}; }
QLabel[type="detail"], ClickableHeaderLabel[type="detail"] { border-bottom: 3px solid {{border-100}}; }
ClickableHeaderLabel[type="detail"]:hover {
    background-color: {{bg-400}};
    border-bottom: 3px solid {{primary-100}};
}

PlusComboBox {
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 1px 18px 1px 10px;
    min-height: 32px;
    background-color: transparent;
    color: {{text-100}};
}
PlusComboBox:hover, PlusComboBox:focus {
    border-color: {{primary-100}};
}
PlusComboBox::drop-down {
    border: none;
    background: transparent;
    width: 24px;
}
PlusComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border: none;
}

PlusComboBox QAbstractItemView {
    background-color: {{border-100}};
    color: {{text-100}};
    border-radius: 4px;
    background-clip: padding-box;
    outline: none;
    font-size: 10pt;
    padding: 0px;
    margin: 1px;
}

PlusComboBox QAbstractItemView::item {
    background-color: {{bg-100}};
    padding: 6px 10px;
    border-radius: 0px;
    margin: 0px;
}

PlusComboBox QAbstractItemView::item:selected {
    background-color: {{primary-100}};
    color: {{text-200}};
}

/* Table ComboBox Styling */
.TableComboBox {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    border-radius: 0px;
    padding: 0px 6px;
    font-size: 10pt;
}

.TableComboBox:hover, 
.TableComboBox:focus {
    background-color: rgba(255, 255, 255, 0.05);
}

/* Row Selection State */
.TableComboBox[selected="true"] {
    background-color: {{primary-100}}33; /* Highlights the cell within the selected row */
    color: {{text-200}};
}

/* Data Interaction States */
.TableComboBox[aiUpdated="true"] {
    background-color: rgba(0, 133, 255, 0.12); /* Subtle glow for AI updated cells */
}

.TableComboBox::drop-down {
    border: none;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background: transparent;
    width: 20px;
}

.TableComboBox::down-arrow {
    image: none; /* We draw a custom chevron in PlusComboBox.paintEvent */
    width: 0px;
    height: 0px;
}

.TableComboBox QAbstractItemView {
    background-color: {{bg-100}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    outline: none;
    font-size: 10pt;
    padding: 4px;
}

.TableComboBox QAbstractItemView::item {
    padding: 6px 8px;
    border-radius: 4px;
}

.TableComboBox QAbstractItemView::item:selected {
    background-color: {{primary-100}};
    color: white;
}

.TableComboBox QLineEdit {
    background: transparent;
    border: none;
    color: inherit;
    padding: 0px;
}

.plusTitleBar {
    background-color: {{bg-100}};
    border-bottom: 1px solid {{border-100}};
}

.logoWidget {
    background: transparent;
    border: none;
    border-radius: 0px;
    margin-left: 4px;
}

.TitleSearchFrame {
    background-color: {{bg-200}};
    border: 1px solid {{border-200}};
    border-radius: 8px;
    padding: 2px 12px;
}

.TitleSearchEdit {
    background-color: transparent;
    color: {{text-200}};
    border: none;
    outline: none;
    font-family: 'Noto Sans KR';
    font-size: 10pt;
}

.ClearSearchButton {
    background: transparent;
    border: none;
    border-radius: 6px;
}
.ClearSearchButton:hover { background-color: rgba(255, 255, 255, 0.08); }
.ClearSearchButton QLabel { color: {{text-100}}; font-family: "{{font-icon}}" !important; font-size: 16pt; }
.ClearSearchButton:hover QLabel { color: #FFFFFF; }

/* ============ Nav Frame (Segmented Control) ============ */
.NavButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: {{text-200}};
    padding: 0px 6px;
}
.NavButton:hover { background-color: {{primary-100_op60}}; color: {{text-200}}; }
.NavButton:checked { background-color: {{primary-100}}; color: {{text-200}}; }

.NavButton QLabel {
    color: {{text-200}};
    font-family: 'Noto Sans KR';
    font-size: 10pt;
    font-weight: bold;
    background: transparent;
}
.NavButton QLabel.Icon {
    color: {{text-200}};
    font-family: "{{font-icon}}" !important;
    font-size: 14pt !important;
    margin-right: 8px;
    background: transparent;
}


/* Window Buttons (Traffic Lights) */
.win_btn_min, .win_btn_max, .win_btn_close {
    border-radius: 10px;
    border: none;
    alignment: center;
    font-size: 9pt;
}
.win_btn_min { background-color: #febc2e; }
.win_btn_min:hover { background-color: #e1a116; }
.win_btn_max { background-color: #28c940; }
.win_btn_max:hover { background-color: #12a024; }
.win_btn_close { background-color: #ff5f57; }
.win_btn_close:hover { background-color: #e04845; }

.ExplorerMoreBtn, .HomeButton, .SyncRefresh {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: {{text-200}};
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
    padding: 2px;
}

.ExplorerMoreBtn:hover, .HomeButton:hover, .SyncRefresh:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
}

.PageTitle { color: {{text-200}}; font-size: 16pt; font-weight: bold; }
.PanelTitle { color: {{text-200}}; font-size: 11pt; font-weight: bold; }
.PageSubTitle { color: {{text-100}}; font-size: 9pt; font-weight: 600; letter-spacing: 0.5px; }
.PanelSubTitle { color: {{text-200}}; font-size: 9pt; font-weight: bold; }

.PageCrumbLabel { color: {{text-100}}; font-size: 10pt; font-weight: 600; letter-spacing: 0.5px; }
.PageCrumbValue { color: {{text-300}}; font-size: 9pt; font-weight: 600; letter-spacing: 0.5px; }

.ConfigDivider {
    background-color: {{border-100}};
}


/* ============ Project Explorer ============ */
.ProjectExplorer {
    background-color: {{bg-200}};
    border-radius: 0px;
    border-right: 1px solid {{border-100}};
    color: {{text-100}};
    font-weight: normal;
}

/* ============ WeldJointLog ============ */
#WeldJointLog {
    background-color: {{bg-100}};
    color: {{text-100}};
}

#WeldJointLogHeader {
    background-color: {{bg-200}};
    border-bottom: 1px solid {{border-100}};
}

#WeldJointLogAccent {
    background-color: {{primary-100}};
    border-radius: 3px;
}

#WeldJointLogTitle {
    color: {{text-100}};
    font-weight: 700;
}

#WeldJointLogSubtitle {
    color: {{text-200}};
    font-size: 7pt;
}

#WeldJointLogContainer {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
}

.StatusMessage {
    color: {{text-100}};
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 13px;
}

.SummaryBadge {
    background-color: {{bg-200}};
    border: 1px solid {{border-200}};
    border-radius: 6px;
    padding: 0 10px;
}


.SummaryBadgeIndicator {
    background-color: {{primary-100}};
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

.SummaryBadgeLabel {
    color: {{text-200}};
    font-weight: 700;
}

.SummaryBadgeValue {
    color: {{text-100}};
    font-weight: 800;
}

.SearchBox {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: white;
    padding: 8px 12px;
    font-size: 9pt;
}
.SearchBox:focus {
    border: 1px solid {{primary-100}};
}

/* ============ Project Explorer Compact Toolbar ============ */
.ProjectToolBarContainer {
    background-color: #25282E;
    border-top: 1px solid #353B48;
    padding: 10px;
}

.ProjectToolBarContainer QPushButton {
    background-color: {{bg-200}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 0px;
    padding: 8px 10px;
    text-align: left;
    font-size: 10pt;
    font-weight: 600;
}

.ProjectToolBarContainer QPushButton:hover {
    background-color: {{bg-300}};
    border: 1px solid {{primary-200}};
}

.ProjectToolBarContainer QPushButton:hover #ProjectToolbarIcon,
.ProjectToolBarContainer QPushButton:hover #ProjectToolbarText {
    color: {{text-100}};
}

.ProjectToolBarContainer QPushButton:disabled #ProjectToolbarIcon,
.ProjectToolBarContainer QPushButton:disabled #ProjectToolbarText {
    color: {{text-100}};
}

.TreeItemHeaderTitle {
    font-size: 10pt;
    font-weight: 700;
}
.TreeItemHeaderTitle[active="true"] { color: {{text-300}}; }
.TreeItemHeaderTitle[active="false"] { color: {{text-200}}; }

.TreeItemTitle {
    font-size: 9pt;
    font-weight: 500;
}
.TreeItemTitle[active="true"] { color: {{text-200}}; }
.TreeItemTitle[active="false"] { color: {{text-100}}; }

.TreeItemDesc {
    font-size: 9pt;
}
.TreeItemDesc[active="true"] { color: {{text-200_op70}}; }
.TreeItemDesc[active="false"] { color: {{text-100}}; }

.TreeItemBadge {
    padding: 2px 4px;
    border-radius: 4px;
    font-size: 7pt;
    font-weight: bold;
    color: white;
    qproperty-alignment: 'AlignCenter';
    min-height: 12px;
    min-width: 55px;
}
.TreeItemBadge[status="ongoing"] { background-color: {{primary-100}}; }
.TreeItemBadge[status="completed"] { background-color: {{green-100}}; }
.TreeItemBadge[status="onhold"] { background-color: {{yellow-100}}; }
.TreeItemBadge[status="cancelled"] { background-color: {{rose-100}}; }
.TreeItemBadge[status="contracted"] { background-color: #3b82f6; }
.TreeItemBadge[status="awaiting"] { background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.15); }
.ExplorerBadge[status="default"] { background-color: {{bg-300}}; }

QFrame.ListFrameItem, .ListFrameItem, QFrame[class="ListFrameItem"], [class="ListFrameItem"], IsometricDrawingItem { 
    background-color: {{bg-300}}; 
    color: {{text-100}};
}

QFrame.ListFrameItem[active="true"], .ListFrameItem[active="true"], QFrame[class="ListFrameItem"][active="true"], [class="ListFrameItem"][active="true"], IsometricDrawingItem[active="true"] { 
    background-color: {{primary-100_op15}}; 
    border: 1px solid {{primary-100_op80}};
    border-radius: 4px; 
}
QFrame.ListFrameItem[active="false"], .ListFrameItem[active="false"], QFrame[class="ListFrameItem"][active="false"], [class="ListFrameItem"][active="false"], IsometricDrawingItem[active="false"] { 
    background-color: {{bg-300}}; 
}
QFrame.ListFrameItem[active="false"]:hover, .ListFrameItem[active="false"]:hover, QFrame[class="ListFrameItem"][active="false"]:hover, [class="ListFrameItem"][active="false"]:hover, IsometricDrawingItem[active="false"]:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid {{primary-100_op60}};
    border-radius: 4px;
}

QFrame.ListFrameItem[active="true"]:hover, .ListFrameItem[active="true"]:hover, QFrame[class="ListFrameItem"][active="true"]:hover, [class="ListFrameItem"][active="true"]:hover, IsometricDrawingItem[active="true"]:hover {
    background-color: {{primary-100_op05}};
    border: 1px solid {{primary-100_op80}};
}

.ProjectGroupFolderIcon { 
    font-family: "{{font-icon}}" !important; 
    font-size: 16pt !important; }
.ProjectGroupFolderIcon[open="true"] { color: {{primary-100}}; }
.ProjectGroupFolderIcon[open="false"] { color: {{text-100}}; }

.ProjectGroupChevron { 
    font-family: "{{font-icon}}" !important; 
    font-size: 16pt !important; 
    color: {{text-300}}; }

.ProjectGroupHeader[selected="true"] {
    border-left: 3px solid {{text-300}};
    padding-left: 8px;
}

.ProjectGroupHeader[parentActive="true"] {
    border-left: 3px solid {{text-200_op20}};
    padding-left: 8px;
}

.ExplorerIndentLine {
    border-left: 1.5px solid {{border-100}};
    margin-left: 14px;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* ============ Popup Menus ============ */
.MorePopupMenu { background: transparent; }

.MenuActionButton {
    background-color: transparent;
    border: none;
    padding: 0px 24px;
}
.MenuActionButton:hover { background-color: {{text-200_op10}}; }
.MenuActionButton:hover QLabel { color: {{text-200}}; }

.RoundedMenuFrame { 
    background-color: {{bg-200}}; 
    border: 1px solid {{border-200}}; 
    border-radius: 8px; 
}

.MenuActionText { color: {{text-200}}; font-size: 10pt; }

.MenuSeparator {
    background-color: {{border-100}};
    max-height: 1px;
    margin: 4px 16px;
}

/* ============ Plus Horizontal Navbar ============ */
.PlusHorizontalNavbar {
    background-color: {{bg-300}};
    border-bottom: 1px solid {{border-100}};
}

.nav_icon {
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
    color: {{text-100}};
}

.breadcrumb_text { 
    color: {{text-300}}; 
    font-family: 'Noto Sans KR'; 
    font-size: 10pt; 
    margin: 0px 0px; 
}
.breadcrumb_active { 
    color: {{text-200}}; 
    font-family: 'Noto Sans KR'; 
    font-size: 10pt; 
    font-weight: bold; 
    margin: 0px 0px; 
}
.breadcrumb_sep { 
    color: {{text-100}}; 
    font-family: "{{font-icon}}" !important; 
    font-size: 10pt; 
    margin: 0px 2px; 
}

/* ============ Horizontal Navbar Weather/Status Stylings ============ */
.navbar_sync_icon {
    font-family: "{{font-icon}}" !important;
    font-size: 13pt;
    color: {{text-200}};
}
.navbar_sync_text {
    font-family: 'Noto Sans KR';
    font-size: 9pt;
    color: {{text-200}};
}

.navbar_temp_icon {
    font-family: "{{font-icon}}" !important;
    font-size: 13pt;
    color: {{text-300}};
}
.navbar_temp_text {
    font-family: 'Noto Sans KR';
    font-size: 9pt;
    color: {{text-300}};
}

.navbar_humid_icon {
    font-family: "{{font-icon}}" !important;
    font-size: 13pt;
    color: {{primary-100}};
}
.navbar_humid_text {
    font-family: 'Noto Sans KR';
    font-size: 9pt;
    color: {{primary-100}};
}

/* ============ Weather Item ============ */
#main_weather_icon {
    color: #4dd0e1;
}
#weather_pill {
    background-color: rgba(10, 34, 34, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 35px;
}
#pill_time {
    color: #a0a0a0;
    font-size: 8pt;
    font-weight: bold;
}
#pill_icon {
    font-size: 18pt;
    color: #4dd0e1;
}
#pill_temp {
    color: #ffffff;
}
#weather_widget {
    background-color: {{bg-100}}; 
    border-radius: 6px; /* Rounded corners for the strip */
    border: 1px solid {{border-100}};
}

#weather_item {
    background-color: transparent; 
    border-radius: 0px; 
}
#weather_item:hover {
    background-color: rgba(255, 255, 255, 0.05); 
}
#weather_item_active {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid {{primary-100}};
    border-radius: 4px;
}
#weather_sep {
    background-color: {{border-200}};
    min-height: 20px;
    margin-top: 10px;
    margin-bottom: 10px;
}

QLabel[class="weather_date"] { 
    color: {{text-300}}; 
    font-size: 10pt; 
    font-weight: normal; 
}

QLabel[class="weather_date_active"] { 
    color: {{text-300}}; 
    font-size: 10pt;
    font-weight: bold;
}

QLabel[class="weather_temp"] { 
    color: {{text-100}}; 
    font-size: 7pt; 
    font-weight: bold;
}

QLabel[class="weather_temp_active"] { 
    color: {{text-200}}; 
    font-size: 8pt; 
    font-weight: bold; 
}

QLabel[class="weather_icon"] {
    color: {{text-300}};
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
}

QLabel[class="weather_icon"][active="true"] { 
    color: {{text-200}}; 
}

QLabel[class="weather_icon"][active="false"] { 
    color: {{text-100}}; 
}

QLabel[class="weather_pop_drop"] { 
    color: #64B5F6; 
    font-family: "{{font-icon}}" !important; 
    font-size: 12pt; 
    margin-right: 2px; 
}
QLabel[class="weather_pop_text"] { 
    color: #90CAF9; 
    font-size: 7pt; 
    font-weight: bold; 
}

QLabel[class="weather_temp_icon"] { 
    color:{{text-300}}; 
    font-family: "{{font-icon}}" !important; 
    font-size: 12pt; 
    margin-right: 2px;
}

/* ============ IsometricDrawingList ============ */
.DrawingListTitle { 
    font-family: "grotesk";
    font-size: 10pt; 
    font-weight: 600; 
    color: {{text-200}}; 
}
.DrawingListTitle[active="true"] { color: {{text-300}}; }

.DrawingListLine { 
    font-family: "plus_font_sans_500";
    font-size: 9pt; 
    color: {{text-200}}; 
}
.DrawingListLine[active="true"] { color: {{text-300}}; }

/* Badge Styles */
.StatusBadge {
    border-radius: 4px;
    padding: 2px 2px;
    font-size: 7pt;
    font-weight: bold;
    text-transform: uppercase;
    border: 1px solid transparent;
    min-height: 12px;
}

.StatusBadge[status="loading"] { color: #94a3b8; background-color: rgba(148, 163, 184, 0.14); border-color: rgba(148, 163, 184, 0.26); }
.StatusBadge[status="pending"] { color: #ef4444; background-color: rgba(239, 68, 68, 0.14); border-color: rgba(239, 68, 68, 0.30); }
.StatusBadge[status="in-progress"] { color: #3b82f6; background-color: rgba(59, 130, 246, 0.14); border-color: rgba(59, 130, 246, 0.30); }
.StatusBadge[status="inprogress"] { color: #3b82f6; background-color: rgba(59, 130, 246, 0.14); border-color: rgba(59, 130, 246, 0.30); }
.StatusBadge[status="completed"] { color: #22c55e; background-color: rgba(34, 197, 94, 0.14); border-color: rgba(34, 197, 94, 0.28); }
.StatusBadge[status="file-not-found"] { color: #f59e0b; background-color: rgba(245, 158, 11, 0.16); border-color: rgba(245, 158, 11, 0.30); }
.StatusBadge[status="filenotfound"] { color: #f59e0b; background-color: rgba(245, 158, 11, 0.16); border-color: rgba(245, 158, 11, 0.30); }

.RevisionBadge {
    border-radius: 4px;
    padding: 0px 2px;
    min-height: 14px;
    min-width: 20px;
    font-size: 8pt;
    font-weight: 600;
    background-color: transparent;
    border: 1px solid transparent;
    text-align: center;
}
.RevisionBadge[latest="true"] {
    color: {{primary-100}};
    font-weight: 700;
    background-color: rgba(92, 130, 157, 0.12);
    border-color: rgba(92, 130, 157, 0.35);
}
.RevisionBadge[latest="false"] {
    color: {{text-100}};
}
.RevisionBadge:hover {
    color: {{accent-100}};
}

/* ============ Drawing Progress Bar ============ */

.DrawingProgress {
    background-color: rgba(71, 85, 105, 0.45);
    border: none;
    border-radius: 1px;
}
.DrawingProgress::chunk {
    background-color: rgba(148, 163, 184, 0.25);
    border-radius: 1px;
}
.DrawingProgress[status="completed"]::chunk { background-color: #22c55e; }
.DrawingProgress[status="inprogress"]::chunk { background-color: #3b82f6; }
.DrawingProgress[status="pending"]::chunk { background-color: #ef4444; }

.FooterIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 10pt;
    color: {{text-100}};
}

.FooterLabel {
    font-family: "{{font-grotesk}}";
    font-size: 8pt;
    font-weight: 500;
    color: {{text-100}};
}
/* ============ Drawing Workspace & GraphicsView ============ */
#ZoomableGraphicsView {
    background-color: {{bg-100}};
    border: none;
}

/* Welding Dock Styling */
QDockWidget#WeldingDock {
    background-color: transparent;
    color: {{text-100}};
    border: none;
}

QDockWidget#WeldingDock > QWidget {
    background-color: {{bg-100}};
    border: none;
}

/* ============ Misc Components ============ */
#workspaceStatusWidget {
    background: transparent;
}

#lock_status_label.error {
    background-color: #f44336;
    color: white;
}

#lock_status_label.success {
    background-color: #4CAF50;
    color: white;
}

#lock_status_label.warning {
    background-color: #ff9800;
    color: white;
}

#request_release_btn {
    background-color: #ff9800;
    color: white;
    font-weight: bold;
    padding: 2px 10px;
    border-radius: 4px;
}
#request_release_btn:hover {
    background-color: #f57c00;
}
#pdf_thumbnail_list {
    border: none;
    border-right: 1px solid {{border-100}};
}

/* ============ IntegratedWeldingProcess ============ */

.StepSection {
    background-color: transparent;
    border: none;
}

.StepSection[isFloating="true"] .SectionSeparator {
    background-color: {{text-300}};
}

.StepBadge {
    color: {{text-200}};
    background-color: {{primary-100}};
    font-weight: bold;
    font-size: 9pt;
    padding: 4px 6px;
    border-radius: 4px;
}

.StepTitle {
    color: {{text-300}};
    font-weight: bold;
    font-size: 9pt;
    padding-left: 4px;
    background: transparent;
}

.SectionSeparator {
    background-color: {{border-100}};
    border: none;
}

.FieldLabelWeldingProcess {
    color: {{text-100}}; 
    font-weight: bold; 
    font-size: 9pt; 
    border: none;
    background: transparent;
}

.WeldingHeader {
    background-color: {{bg-100}};
    border: none;
    border-bottom: 1px solid {{border-100}};
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.WeldingHeaderIcon {
    color: {{primary-100}};
    background: transparent;
    border: none;
}

.WeldingHeaderTitle {
    color: white;
    font-size: 14pt;
    font-weight: bold;
    border: none;
    background: transparent;
}

.WeldingHeaderBtn {
    background: transparent;
    font-weight: bold;
    font-size: 9pt;
    border: 1px solid {{border-100}};
    border-radius: 4px;
    color: {{text-200}};
}

.WeldingHeaderBtn:hover {
    background-color: {{primary-100}};
    color: {{text-200}};
}

.WeldingHeaderBtn:checked, 
QPushButton[class="WeldingHeaderBtn"]:checked {
    background-color: {{primary-100}} !important;
    border: 1px solid {{primary-100}} !important;
    color: {{text-200}} !important;
}

.WeldingHeaderBtn:disabled {
    color: {{text-100}};
    border-color: {{border-200}};
}

.InfoFrame {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
}

#integratedWeldingProcess[isFloating="true"] .InfoFrame {
    border-color: {{border-100}};
}

.InfoLabel {
    color: {{text-300}};
    font-size: 10pt;
    font-weight: bold;
    background: transparent;
}

.FooterFrame {
    background: transparent;
    border: none;
    border-top: 1px solid {{border-100}};
}

/* Input Fields inside IntegratedWeldingProcess */
#IntegratedWeldingProcess_InputField {
    background: rgba(148, 163, 184, 0.1);
    color: #ffffff;
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 6px;
    padding: 3px 5px;
    font-size: 9pt;
    min-width: 0px;
}

#IntegratedWeldingProcess_InputField:focus {
    border: 1px solid {{primary-100}};
    background: rgba(19, 127, 236, 0.05);
}

#IntegratedWeldingProcess_InputField[readOnly="true"] {
    background-color: #2a2b30;
    color: #8a8d95;
}

#IntegratedWeldingProcess_InputField[lockState="warning"] {
    color: #ff6b6b;
    background: rgba(255, 107, 107, 0.1);
    border: 1px solid rgba(255, 107, 107, 0.55);
}

#IntegratedWeldingProcess_InputField[lockState="warning"]:focus {
    border: 1px solid #ff6b6b;
    background: rgba(255, 107, 107, 0.14);
}

#IntegratedWeldingProcess_InputField:hover {
    border: 1px solid rgba(148, 163, 184, 0.4);
}

/* StandardToolbar & ToolbarButton */
.StandardToolbar {
    background: {{bg-400}};
    border-bottom: 1px solid {{border-100}};
}

.ToolbarGroupTitle {
    color: {{text-200}};
    font-size: 8pt;
    font-weight: 600;
    padding-bottom: 2px;
}

.ToolbarButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: {{text-200}};
    padding: 4px;
}

.ToolbarButton:hover {
    background: {{bg-300}};
    border: 1px solid {{border-100}};
}

.ToolbarButton:pressed {
    background: {{accent-100}};
    color: #ffffff;
}

.ToolbarButton[checked="true"] {
    background: {{accent-100}};
    color: #ffffff;
}

.ToolbarButton:disabled {
    opacity: 0.5;
    color: {{text-100}};
}

#ToolbarSeparator {
    background-color: {{border-100}};
    border: none;
    margin-top: 10px;
    margin-bottom: 10px;
}

.Icon {
    font-family: "{{font-icon}}";
}

/* ============ ConstDrawingList ============ */
.DrawingItemWidget {
    background-color: {{bg-200}};
    border-radius: 8px;
    border: 1px solid {{border-100}};
}

.DrawingItemWidget:hover {
    background-color: {{bg-300}};
    border: 1px solid {{primary-100}};
}

.DrawingItemStatus {
    border-radius: 11px;
    font-weight: bold;
    font-size: 8pt;
    background-color: {{bg-300}};
    color: {{text-300}};
}

.DrawingItemStatus[status="completed"] {
    background-color: rgba(34, 197, 94, 0.2);
    color: #22c55e;
}

.DrawingItemStatus[status="pending"] {
    background-color: rgba(239, 68, 68, 0.2);
    color: #ef4444;
}

.DrawingItemStatus[status="in-progress"] {
    background-color: rgba(59, 130, 246, 0.2);
    color: #3b82f6;
}

.DrawingItemStatus[status="file-not-found"] {
    background-color: rgba(245, 158, 11, 0.2);
    color: #f59e0b;
}

/* ============ Plus Dashboard Page ============ */

.DashboardDateButton {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 8px 16px;
    color: {{text-200}};
    font-weight: bold;
    font-size: 10pt;
}
.DashboardDateButton:hover {
    border: 1px solid {{primary-100}};
}

/* Dashboard Metric Cards */
.DashboardCard {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}
.DashboardCard[active="true"] {
    border: 2px solid {{primary-100}};
}

.DashboardMetricTitle {
    color: {{text-100}}; 
    font-weight: bold; 
    font-size: 9pt;
    background: transparent;
}
.DashboardThumbnailCard {
    background-color: rgba(255, 255, 255, 0.04);
    border: none;
    border-radius: 10px;
}
.DashboardThumbnailImage {
    background-color: #ffffff;
    border-radius: 10px;
}
.DashboardMetricValue {
    color: {{text-200}}; 
    font-weight: bold; 
    font-size: 24pt;
    background: transparent;
}



/* Chart Legends & Small Labels */
.DashboardLegendDot { font-size: 10pt; background: transparent; }
.DashboardLegendDot[legendTone="last-year"] { color: {{border-100}}; }
.DashboardLegendDot[legendTone="this-year"] { color: {{primary-100}}; }
.DashboardLegendDot[legendTone="nde-pending"] { color: {{border-100}}; }
.DashboardLegendDot[legendTone="nde-cleared"] { color: #10B981; }
.DashboardLegendDot[legendTone="nde-repair"] { color: #F43F5E; }
.DashboardLegendLabel { color: {{text-200}}; font-size: 10pt; font-weight: bold; background: transparent; }
.DashboardSubLabel { color: {{text-100}}; font-size: 8pt; font-weight: bold; text-transform: uppercase; background: transparent; }

/* Status Badges */
.DashboardProjectBadge {
    font-weight: bold;
    font-size: 7pt;
    padding: 2px 6px;
    border-radius: 4px;
}
.DashboardProjectBadge[status="on-track"] { color: #10B981; background-color: rgba(16, 185, 129, 0.15); }
.DashboardProjectBadge[status="active"]   { color: {{primary-100}}; background-color: rgba(0, 133, 255, 0.15); }
.DashboardProjectBadge[status="at-risk"]  { color: #EAB308; background-color: rgba(234, 179, 8, 0.15); }

/* Urgent Alerts */
.UrgentAlertFrame {
    border-left: 4px solid #F43F5E;
    background-color: rgba(244, 63, 94, 0.12);
}
.UrgentAlertFrame[tone="yellow"] {
    border-left-color: #EAB308;
    background-color: rgba(234, 179, 8, 0.12);
}
.UrgentAlertTitle { color: #F43F5E; font-weight: bold; font-size: 10pt; background: transparent; border: none; }
.UrgentAlertFrame[tone="yellow"] .UrgentAlertTitle { color: #EAB308; }
.UrgentAlertSubtitle { color: {{text-100}}; font-size: 8pt; background: transparent; border: none; }

/* Progress Bars */
.DashboardProgressBar {
    background-color: rgba(148, 163, 184, 0.2); 
    border-radius: 2px; 
    border: none;
}
.DashboardProgressBar::chunk {
    background-color: {{primary-100}};
    border-radius: 2px;
}

.DashboardDrawingsGallery {
    background-color: {{bg-300}}; 
    border: none; 
    color: {{text-200}}; 
}


/* Tables */
.DashboardTable {
    background-color: transparent; 
    border: none; 
    color: {{text-200}}; 
    gridline-color: transparent;
}
.DashboardTable QHeaderView::section {
    background-color: rgba(148, 163, 184, 0.1); 
    color: {{text-100}}; 
    font-weight: bold; 
    border: none; 
    border-bottom: 1px solid {{border-100}}; 
    padding: 8px;
}
.DashboardTable::item {
    border-bottom: 1px solid {{border-100}}; 
    padding: 8px;
}


/* ============ Empty State Overlay ============ */
#EmptyStateOverlay {
    background-color: transparent;
    border: none;
}

#EmptyStateOverlay[hasData="true"] {
    background-color: transparent;
}

#EmptyStateOverlay[hasData="false"] {
    background-color: transparent;
}

#EmptyStateContainer {
    background-color: #1A1C1E;
    border: 1px solid #2D3139;
    border-radius: 15px;
    min-width: 500px;
    min-height: 400px;
    max-width: 600px;
    padding: 20px;
}

#EmptyStateContainer[hasData="false"] {
    background-color: #1A1C1E;
}

#EmptyStateIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 62pt;
    line-height: 1;
    color: #4A4D54;
    background: transparent;
    padding: 20px 0;
}

#EmptyTitle {
    font-size: 16pt;
    font-weight: bold;
    color: #E1E2E5;
    background: transparent;
    margin-top: 4px;
    margin-bottom: 8px;
}

#EmptyDesc {
    font-size: 11pt;
    color: #8B909A;
    background: transparent;
    line-height: 150%;
    margin-bottom: 10px;
}

#new_project_btn {
    background-color: {{primary-100}};
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-size: 11pt;
    font-weight: bold;
    min-width: 180px;
    min-height: 40px;
    margin-top: 8px;
}
#new_project_btn:hover {
    background-color: {{accent-100}};
}

#load_sample_btn {
    background-color: transparent;
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
    padding: 10px 24px;
    font-size: 11pt;
    min-width: 160px;
    min-height: 40px;
    margin-top: 8px;
}
#load_sample_btn:hover {
    border-color: {{primary-100}};
    color: {{primary-100}};
}

/* ============ Explorer Empty State ============ */
#ExplorerEmptyState {
    background-color: transparent;
}

#ExplorerEmptyStateTitle {
    font-size: 11pt;
    font-weight: bold;
    color: {{text-200}};
    background: transparent;
}

#ExplorerEmptyStateDesc {
    font-size: 9pt;
    color: {{text-100}};
    background: transparent;
}

#ExplorerEmptyStateBtn {
    background-color: rgba({{primary-100-rgb}}, 0.15);
    color: {{primary-100}};
    border: 1px solid rgba({{primary-100-rgb}}, 0.3);
    border-radius: 5px;
    padding: 6px 16px;
    font-size: 10pt;
    font-weight: bold;
    min-height: 32px;
}
#ExplorerEmptyStateBtn:hover {
    background-color: rgba({{primary-100-rgb}}, 0.28);
}

/* ============ Skeleton Loader ============ */
#SkeletonLoader {
    background: transparent;
}

#SkeletonRow {
    background-color: rgba(148, 163, 184, 0.12);
    border-radius: 6px;
}
#SkeletonRow[phase="0"] {
    background-color: rgba(148, 163, 184, 0.12);
}
#SkeletonRow[phase="1"] {
    background-color: rgba(148, 163, 184, 0.20);
}
#SkeletonRow[phase="2"] {
    background-color: rgba(148, 163, 184, 0.08);
}

/* ============ Project Config Page ============ */
.PlusDashboardPage, .ProjectConfigPage,
QWidget[class="PlusDashboardPage"], QWidget[class="ProjectConfigPage"] {
    background-color: {{bg-100}};
    border-top: none;
    border-bottom: none;
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
    padding: 0px;
}

#ProjectConfigCenterWidget {
    background-color: {{bg-100}};
}

.ConfigHeader,
#ProjectConfigHeader {
    background-color: {{bg-100}};
    border: none;
    border-bottom: 1px solid {{border-100}};
}

.ConfigSection {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.ConfigSectionIcon {
    color: {{text-200}};
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
    font-weight: bold;
    background: transparent;
}

.ConfigSectionTitle {
    color: white;
    font-weight: bold;
    font-size: 12pt;
    text-transform: uppercase;
    background: transparent;
}

.ConfigStandardSpec {
    color: {{text-100}};
    font-size: 10pt;
    font-weight: bold;
    background: transparent;
    border: none;
    border-bottom: 1px solid {{border-100}};
}


.ConfigDimSelectorContainer {
    background-color: {{bg-100}};
    border-radius: 6px;
}

.ConfigDimButton {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 10pt;
}
.ConfigDimButton:checked {
    background-color: {{primary-100}};
    color: white;
}

.ConfigDimButton:hover:!checked {
    background-color: rgba(148, 163, 184, 0.1);
}


.ConfigActionReset {
    background-color: #222;
    color: {{text-200}};
    border: 1px solid {{primary-100}};
    border-radius: 4px;
    padding: 0 16px;
}

.ConfigColorButton {
    border: 1px solid {{border-100}};
    border-radius: 4px;
    color: {{text-200}};
    font-family: '{{font-monospace}}';
    background-color: transparent;
    padding: 4px;
}

.ColorButtonFace {
    background-color: qproperty-face_color;
    border: none;
    border-radius: 3px;
}

.ConfigHexLabel {
    color: {{text-100}};
    font-size: 9pt;
    background: transparent;
}

.ConfigInfoBox {
    background-color: rgba(92, 130, 157, 0.05);
    border: 1px solid rgba(92, 130, 157, 0.2);
    border-radius: 8px;
}

.ConfigInfoIcon {
    color: {{primary-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
    background: transparent;
    border: none;
}

.ConfigInfoText {
    background-color: transparent;
    color: {{text-100}};
    font-size: 9pt;
    border: none;
}

.ConfigColorItemFrame {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
}

/* --- SpoolNamingWidget --- */

.SpoolNamingWidget {
    background-color: transparent;
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.SpoolNamingTitleIcon {
    background-color: transparent;
    color: {{primary-100}};
}

.SpoolNamingTitle {
    background-color: transparent; 
    color: white; 
    font-weight: bold; 
    font-size: 12pt; 
    letter-spacing: 0.5px;
}

.SpoolNamingSubHeader {
    color: {{text-100}}; 
    font-weight: bold; 
    font-size: 8.5pt; 
    background: transparent; 
    letter-spacing: 0.3px;
}

.DraggableBadge {
    background-color: #1a1a1c;
    border: 1px solid {{border-100}};
    border-radius: 4px;
}

.DraggableBadge:hover {
    background-color: #252528;
    border: 1px solid {{primary-100}};
}

.DraggableBadgeLabel {
    color: {{text-200}}; 
    font-weight: bold; 
    border: none; 
    background: transparent; 
    font-size: 10pt;
}

.DroppedBadge {
    background-color: rgba(92, 130, 157, 0.15);
    border: 1px solid {{primary-100}};
    border-radius: 4px;
    padding-top: 2px;
}

.DroppedBadge:hover {
    background-color: rgba(92, 130, 157, 0.25);
}

.DroppedBadgeLabel {
    color: {{text-200}}; 
    font-weight: bold; 
    border: none; 
    background: transparent; 
    font-size: 10pt;
}

.DroppedBadgeRemoveBtn {
    color: {{text-200}};
    background: transparent;
    border: none;
    font-size: 8pt;
    font-weight: bold;
    padding: 0px;
}

.DroppedBadgeRemoveBtn:hover {
    color: #ff5555;
}

.NamingDropArea {
    background-color: transparent;
    border: 1px dashed #333336;
    border-radius: 4px;
}

.NamingDropArea[active="true"] {
    background-color: rgba(92, 130, 157, 0.05);
    border: 1px dashed {{primary-100}};
}

.NamingDropAreaPlaceholder {
    color: {{text-100}}; 
    font-style: italic; 
    border: none; 
    background: transparent; 
    font-size: 9pt;
}

.NamingPreviewFrame {
    background-color: #0d0d0f;
    border: 1px solid {{border-100}};
    border-radius: 6px;
}

.NamingPreviewTitle {
    color: {{text-100}}; 
    font-weight: bold; 
    font-size: 8.5pt; 
    border: none; 
    background: transparent;
}

.NamingPreviewRefreshBtn {
    color: rgba(92, 130, 157, 0.7); 
    background: transparent; 
    border: none;
}

.NamingPreviewRefreshBtn:hover { 
    color: {{primary-100}}; 
}

.NamingPreviewText {
    color: white; 
    font-weight: bold; 
    font-size: 18pt; 
    border: none; 
    background: transparent;
}


/* --- QualityReportNamingWidget --- */

.QualityNamingWidget {
    background-color: transparent;
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.QualityNamingTitleIcon {
    background-color: transparent;
    color: {{primary-100}};
}

.QualityNamingTitle {
    background-color: transparent; 
    color: white; 
    font-weight: bold; 
    font-size: 12pt; 
    letter-spacing: 0.5px;
}

.QualityNamingInput, .QualityNamingCombo {
    background-color: #1a1a1c;
    border: 1px solid {{border-100}};
    border-radius: 4px;
    color: {{text-200}};
    padding: 4px 8px;
    min-height: 28px;
}

.QualityNamingCombo::drop-down {
    border: none;
    width: 20px;
}

.QualityNamingCombo::down-arrow {
    image: none;
}

.ITPPanel {
    background-color: {{bg-100}}; 
    border: 1px solid {{border-100}}; 
    border-radius: 8px;
}

.ITPPanelHeader {
    border-bottom: 1px solid {{border-100}};
}

.ITPPanelTitleIcon {
    background-color: transparent; 
    color: {{primary-100}}; 
    border: none;
}

.ITPPanelTitleText {
    background-color: transparent; 
    color: white; 
    font-weight: bold; 
    font-size: 12pt; 
    border: none;
}

.ITPPanelActionButton {
    background-color: transparent; 
    border-radius: 4px; 
    border: 1px solid {{border-100}};
}

.ITPPanelActionButton:hover {
    background-color: {{border-100}};
}

.ITPPanelActionIcon {
    color: {{text-100}}; 
    border: none; 
    background: transparent;
}

.ITPPanelFilterButton {
    background-color: {{bg-200}}; 
    color: {{text-100}}; 
    font-weight: 600; 
    font-size: 11pt; 
    border: 1px solid {{border-100}}; 
    border-radius: 4px; 
    padding: 8px;
}

.ITPPanelFilterButton:hover {
    background-color: {{border-100}};
}

.ITPPanelFilterButton:checked {
    background-color: {{primary-100}}; 
    color: white; 
    border-color: {{primary-100}};
}

.ITPPanelAddButton {
    background-color: transparent; 
    border: 1px solid {{border-100}}; 
    border-radius: 4px;
}

.ITPPanelAddButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.ITPPanelAddIcon, .ITPPanelAddText {
    color: {{text-100}}; 
    border: none; 
    background: transparent;
}

.ITPPanelAddButton:hover .ITPPanelAddText {
    color: white;
}

.ITPPanelTableHeader {
    background-color: {{bg-300}}; 
    border-bottom: 1px solid {{border-100}};
}

.ITPPanelTableHeaderLabel {
    font-weight: bold; 
    font-size: 11pt; 
    color: {{text-100}}; 
    text-transform: uppercase; 
    border: none;
}

QFrame#ITPRow,
.ITPRow {
    background-color: transparent;
    border-bottom: 1px solid {{border-100}}80;
}

QFrame#ITPRow:hover,
.ITPRow:hover {
    background-color: rgba(51, 141, 255, 0.1);
}

QFrame#ITPRow[selected="true"],
.ITPRow[selected="true"] {
    background-color: rgba(51, 141, 255, 0.3);
}

.ITPRowNDEContainer {
    background-color: transparent;
    border: none;
}

.ITPRowCodeInput {
    color: white; 
    background: transparent; 
    border: none;
    border-bottom: 2px solid transparent; 
    padding: 4px;
}

.ITPRowCodeInput:focus {
    border-radius: 0px; 
    border-bottom: 2px solid {{accent-100}};
}

.ITPRowDescLabel {
    color: white; 
    background: transparent; 
    border: none; 
    padding: 4px 12px;
}

.ITPRowKeywordLabel {
    color: {{text-100}}; 
    background: transparent; 
    border: none; 
    padding: 4px 12px;
}

.ITPRowDeleteBtn {
    background-color: transparent; 
    border-radius: 4px; 
    border: none;
}

.ITPRowDeleteBtn:hover {
    background-color: rgba(255, 0, 0, 0.15);
}

.ITPRowDeleteIcon {
    color: {{text-100}}; 
    background: transparent; 
    border: none;
}

.ITPPanelFooter {
    background-color: #0a0a0a; 
    border-top: 1px solid {{border-100}}; 
    border-bottom-left-radius: 8px; 
    border-bottom-right-radius: 8px;
}

.ITPPanelStatusDot {
    background-color: #22c55e; 
    border-radius: 4px; 
    border: none;
}

.ITPPanelFooterLabel {
    color: {{text-100}}; 
    border: none;
}

.ITPPanelScrollArea {
    background-color: transparent; 
    font-size: 10pt;
    border: none;
}

#ITPPanelScrollViewport {
    background-color: transparent;
    border: none;
}

QWidget#ITPPanelScrollContent,
.ITPPanelScrollContent {
    background-color: transparent; 
    font-size: 10pt;
    border: none;
}

/* --- PlusColorPicker --- */

.ColorPickerElement {
    background: transparent;
    color: #FFFFFF;
}

.ColorPickerFrame {
    background-color: #2C2C2E;
    border: 1px solid #3A3A3C;
    border-radius: 16px;
    color: #FFFFFF;
}

.ColorPickerHeaderIcon {
    color: #FFFFFF;
    font-size: 14pt;
    background: transparent;
    border: none;
}

.ColorPickerTitle {
    font-weight: bold;
    font-size: 13pt;
    color: #FFFFFF;
    border: none;
    background: transparent;
}

.ColorPickerCloseBtn {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-size: 10pt;
    font-weight: bold;
}

.ColorPickerCloseBtn:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.ColorSwatchGrid {
    background-color: #1C1C1E;
    border-radius: 0px;
    border: none;
}

.ColorSwatchTile {
    background-color: transparent;
    qproperty-swatch_color: #000000;
    border: none;
}

.ColorSwatch {
    background-color: transparent;
    qproperty-swatch_color: #000000;
    border: none;
}

.ColorAlphaSlider {
    background: transparent;
    border: none;
}

.ColorAlphaPercent {
    background: #ffffff;
    color: #111111;
    border-radius: 12px;
    padding: 0px;
    font-weight: 700;
}

.ColorFavBtn {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
}

.ColorFavBtn:hover {
    border: 1px solid rgba(255, 255, 255, 0.5);
}

.CircularColorIndicator {
    background-color: transparent;
    border-radius: 15px;
    border: 1px solid {{border-100}};
}

.ColorPreview {
    background-color: qproperty-face_color;
    border: none;
    border-radius: 8px;
}

.CircularColorIndicator {
    background-color: qproperty-face_color;
}

/* --- LayerListPanel --- */

.LayerListPanel {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 0px;
}

.LayerListPanel[floating="true"] {
    background-color: rgba(18, 18, 18, 0.40); /* 40% alpha */
}

.LayerListScrollArea {
    border: none; 
    background: transparent;
}

#LayerListScrollViewport,
#LayerListScrollContent,
.LayerListScrollContent {
    border: none;
    background: transparent;
}

.LayerPanelHeader {
    background-color: {{bg-100}}; 
    border: none;
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
}

.LayerPanelHeader[floating="true"] {
    background-color: rgba(18, 18, 18, 0.85); /* 85% alpha */
}

.LayerPanelTitle {
    color: white; 
    font-weight: bold; 
    border: none; 
    background: transparent;
}

.LayerPanelMoreButton {
    color: #6b7280; 
    border: none; 
    background: transparent; 
    padding: 0;
}

.LayerPanelActionButton {
    background-color: transparent;
    border: 1px solid #374151;
    border-radius: 4px;
    color: {{text-200}};
}

.LayerPanelActionButton:hover {
    background-color: #1E1E1E;
    border-color: #4b5563;
}

.LayerPanelActionButton[primary="true"] {
    background-color: rgba(51, 119, 255, 0.1);
    border: 1px solid rgba(51, 119, 255, 0.4);
    color: {{primary-100}};
}

.LayerPanelActionButton[primary="true"]:hover {
    background-color: {{primary-100}};
    border-color: {{primary-200}};
    color: white;
}

.LayerPanelActionButton QLabel {
    background: transparent;
    border: none;
    color: {{text-200}};
}

.LayerPanelCategoryTitle {
    color: #6b7280;
    font-weight: bold;
    padding: 0px 12px 2px 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    background: transparent;
}

.LayerPanelFooter {
    background-color: #151515; 
    border: none; 
    border-top: 1px solid {{border-100}};
}

.LayerPanelFooterLabel {
    color: #4b5563; 
    border: none; 
    background: transparent;
}

.LayerPanelStatusDot {
    background-color: rgba(34, 197, 94, 0.2); 
    border: 1px solid {{primary-100}}; 
    border-radius: 4px;
}

/* --- LayerItemWidget --- */

QFrame#LayerItem,
.LayerItem {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 0px;
}

QFrame#LayerItem:hover,
.LayerItem:hover {
    background-color: #1E1E1E;
    border: 1px solid #4b5563;
}

QFrame#LayerItem[selected="true"],
.LayerItem[selected="true"] {
    background-color: rgba(51, 119, 255, 0.1);
    border-left: 3px solid {{primary-100}};
    border-top: 1px solid rgba(51, 119, 255, 0.3);
    border-right: 1px solid rgba(51, 119, 255, 0.3);
    border-bottom: 1px solid rgba(51, 119, 255, 0.3);
}

.LayerItemIconButton {
    color: #6b7280;
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
}

.LayerItemIconButton:hover { 
    background: rgba(255, 255, 255, 0.08); 
    color: white; 
}

.LayerItemIconButton[active="true"] {
    color: {{primary-100}};
}

.LayerItemTypeIcon {
    color: {{text-100}};
    background: transparent;
    border: none;
}

.LayerItemTypeIcon[user="true"] {
    color: #eab308;
}

.LayerItem[selected="true"] .LayerItemTypeIcon {
    color: {{primary-100}};
}

.LayerItemNameLabel {
    color: {{text-200}};
    background: transparent;
    border: none;
}

.LayerItem[selected="true"] .LayerItemNameLabel {
    color: white;
    font-weight: bold;
}

.LayerItemNameInput {
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0px;
    color: {{text-200}};
    font-weight: 500;
    padding: 2px 0;
}

.LayerItemNameInput:hover { 
    border-bottom: 1px solid #4b5563; 
}

.LayerItemNameInput:focus { 
    border-bottom: 1px solid {{primary-100}}; 
}

.LayerItemIndexTag {
    color: {{text-100}};
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    padding: 1px 4px;
}

.LayerItem[selected="true"] .LayerItemIndexTag {
    color: {{primary-100}};
    background-color: rgba(51, 119, 255, 0.1);
    border: 1px solid rgba(51, 119, 255, 0.2);
}

/* --- InspSubItemWidget --- */

.InspSubPanel {
    background-color: transparent;
    border: none;
}

.InspSubItem:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.InspSubItemViewButton {
    color: #6b7280;
    background: transparent;
    border: none;
    padding: 0px;
    text-transform: none;
}

.InspSubItemViewButton:hover { 
    color: white; 
}

.InspSubItemViewButton[active="true"] {
    color: {{primary-100}};
}

.InspSubItemNameButton {
    color: {{text-100}};
    text-align: left;
    background: transparent;
    border: none;
    padding-left: 4px;
}

.InspSubItemNameButton:checked {
    color: white;
    font-weight: bold;
}

.InspSubItemNameButton:hover { 
    color: white; 
}

/* --- DrawingInfoSidePanel --- */

.DrawingInfoPanel {
    background-color: {{bg-200}};
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
}

.DrawingInfoPanel[read_only="true"] {
    background-color: {{bg-300}};
}

.DrawingInfoPanelHeader {
    border-bottom: 1px solid {{border-100}};
    background-color: {{bg-200}};
}

.DrawingInfoIconBg {
    background-color: transparent;
    border: none;
}

.DrawingInfoIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 18pt;
    color: {{primary-100}};
    background-color: transparent;
}

.DrawingInfoTitle {
    font-family: "{{font-sans-bold}}";
    color: {{text-200}};
    font-weight: bold;
    font-size: 14pt;
    background-color: transparent;
}

.DrawingInfoScrollArea {
    background: transparent;
    border: none;
}

.DrawingInfoContent {
    background-color: {{bg-200}};
}

.DrawingInfoInputLabel {
    font-family: "{{font-sans-bold}}";
    font-size: 8pt;
    font-weight: bold;
    color: {{text-200}};
    text-transform: uppercase;
    background: transparent;
}

.DrawingInfoInputLabel[highlight="true"] {
    color: {{primary-100}};
}

.DrawingInfoToggleBtn {
    background-color: rgba(51, 119, 255, 0.05); /* 5% primary-100 */
    border: 1px solid rgba(51, 119, 255, 0.2); /* 20% primary-100 */
    border-radius: 6px;
    height: 36px;
    font-size: 11pt;
}

.DrawingInfoToggleBtn:hover {
    background-color: rgba(51, 119, 255, 0.1); /* 10% primary-100 */
}

.DrawingInfoToggleBtn:checked {
    background-color: rgba(51, 119, 255, 0.15); /* 15% primary-100 */
}

.DrawingInfoToggleText {
    font-family: "{{font-sans-bold}}";
    font-size: 13pt;
    font-weight: bold;
    color: {{text-300}};
    background: transparent;
    letter-spacing: 1px;
}

.DrawingInfoToggleIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 18pt;
    color: {{text-300}};
    background: transparent;
}

.DrawingInfoSectionNum {
    font-family: "{{font-sans-bold}}";
    font-size: 10pt;
    font-weight: 900;
    color: rgba(51, 119, 255, 0.6); /* 60% primary-100 */
    background: transparent;
}

.DrawingInfoSectionTitle {
    font-family: "{{font-sans-bold}}";
    font-size: 10pt;
    font-weight: bold;
    color: {{text-200}};
    text-transform: uppercase;
    background: transparent;
}

.DrawingInfoSectionDivider {
    background-color: rgba(255, 255, 255, 0.05);
}

.DrawingInfoSwitchLabel {
    color: rgba(255, 255, 255, 0.5);
    font-size: 9pt;
    background: transparent;
}

.DrawingInfoFooter {
    background-color: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

/* ============ IntegratedWeldLogView ============ */

.WeldLogTopCard {
    background-color: {{bg-300}};
    border-bottom: 1px solid {{border-100}};
}

.WeldLogTitle {
    color: {{text-200}};
    font-size: 18pt;
    font-weight: 700;
}

.WeldLogStatusLabel {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    color: #FF9D56; /* text-orange fallback */
    padding: 6px 12px;
    border-radius: 8px;
    font-weight: 700;
}

.WeldLogExportButton {
    background-color: {{primary-100}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 10px;
    padding: 7px 16px 7px 12px;
    font-weight: 700;
    min-width: 136px;
}
.WeldLogExportButton:hover {
    background-color: {{primary-200}};
}
.WeldLogExportButton:pressed {
    background-color: {{primary-200}};
    padding-top: 8px;
    padding-bottom: 6px;
}
.WeldLogExportButton:disabled {
    background-color: {{bg-200}};
    color: {{text-100}};
}

.WeldLogTableFrame {
    background-color: {{bg-100}};
}

/* IntegratedWeldLogView - ProgressBar (StatusBar) */
QProgressBar#IntegratedWeldLogExportProgress {
    background-color: {{bg-200}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    text-align: center;
    padding: 1px;
}
QProgressBar#IntegratedWeldLogExportProgress::chunk {
    background-color: {{primary-100}};
    border-radius: 4px;
}

/* IntegratedWeldLogView - Table Internal Styles */
#mainTable, #frozenTable { 
    border: none; 
    background-color: transparent;
    color: {{text-100}};
    font-size: 9pt;
}

#mainTable {
    background-color: {{bg-100}};
}

#frozenTable {
    background-color: {{bg-200}};
}

#frozenSeparator {
    background-color: {{primary-100}};
    min-width: 3px;
    border-left: 1px solid #7cc2ff;
    border-right: 1px solid #0b3c66;
}

QLabel[type="group"], QLabel[type="detail"], ClickableHeaderLabel[type="detail"] {
    background-color: {{bg-200}};
    color: #FF9D56; /* text-orange fallback */
    font-weight: 700;
    font-size: 9pt;
    border: none;
    border-right: 1px solid {{border-100}};
    padding: 0px;
    margin: 0px;
}
QLabel[type="group"] { 
    border-bottom: 1px solid {{border-100}}; 
}

QLabel[type="detail"], ClickableHeaderLabel[type="detail"] {
    border-bottom: 3px solid {{border-100}};
}

/* ============ WeldJointEditor ============ */

.WeldJointEditorContainer {
    background-color: {{bg-100}};
    border-radius: 12px;
    border: 1px solid {{border-100}};
}

.WeldJointEditorContainer[docked="true"] {
    border-radius: 0px;
    border: none;
}

.WeldJointEditorHeader {
    background-color: {{bg-100}};
    border-bottom: 1px solid {{border-100}};
}

.WeldJointEditorTitle {
    color: {{text-200}};
    font-size: 12pt;
    font-weight: bold;
    border: none;
}

.WeldJointEditorScrollArea {
    background-color: {{bg-300}};
    background: {{bg-300}};
    border: none;
}

#WeldJointEditorContent {
    background-color: {{bg-300}};
    background: {{bg-300}};
}

.WeldJointEditorSectionTitle {
    color: {{text-300}};
    background: {{bg-300}};
    font-weight: bold;
    padding: 10px 14px;
    font-size: 12pt;
    border-left: 4px solid {{primary-100}};
    border-radius: 2px;
    margin-top: 12px;
    margin-bottom: 4px;
}

.WeldJointEditorRowLabel {
    color: {{text-100}};
    font-weight: bold;
    font-size: 9pt;
    border: none;
}

.WeldJointEditorValueLabel {
    color: {{text-200}};
    font-style: italic;
    font-size: 10pt;
    border: none;
    font-weight: normal;
}

.WeldJointEditorInput {
    background: {{bg-300}};
    font-size: 10pt;
    border: 1px solid {{border-100}};
    border-radius: 6px;
    padding: 6px 6px;
    color: {{text-200}};
    min-width: 0px;
}
.WeldJointEditorInput:focus {
    border: 1px solid {{accent-100}};
    background: {{bg-300}};
}
.WeldJointEditorInput:hover {
    border: 1px solid {{accent-100}};
}

.WeldJointEditorReadOnlyInput {
    background: {{bg-100}};
    color: {{text-100}};
}

.WeldJointEditorCombo {
    background: {{bg-300}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 10pt;
}
.WeldJointEditorCombo:hover {
    border: 1px solid {{bg-200}};
}
.WeldJointEditorCombo::drop-down {
    border: none;
    width: 24px;
}
.WeldJointEditorCombo::down-arrow {
    image: none;
}
.WeldJointEditorCombo QAbstractItemView {
    background-color: {{bg-200}};
    color: {{text-200}};
    selection-background-color: {{primary-100}};
    outline: none;
    border: 1px solid {{border-100}};
}

.CalendarIconLabel {
    font-family: "{{font-icon}}";
    color: {{text-200}};
}

.WeldJointEditorFooter {
    background-color: {{bg-100}};
    border-top: 1px solid {{border-100}};
}

.WeldJointEditorHint {
    color: {{primary-100}};
    font-size: 11pt;
    border: none;
    background: transparent;
}

.WeldJointEditorCancelBtn {
    background: transparent;
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    font-size: 10pt;
    font-weight: bold;
}
.WeldJointEditorCancelBtn:hover {
    background: rgba(255, 255, 255, 0.05);
}

.WeldJointEditorSaveBtn {
    background: {{primary-100}};
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 10pt;
    font-weight: bold;
}
.WeldJointEditorSaveBtn:hover {
    background: {{primary-200}};
}


/* ============ DataMigrationForm (Web) ============ */

.DataMigrationFormWrapper {
    background: transparent;
}

.DataMigrationFormContainer {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 20px;
}

/* ============ LoginDialog ============ */

.LoginDialogWidget {
    background: transparent;
}

.LoginDialogContainer {
    background-color: transparent;
    border: none;
}

.LoginDialogLeft {
    background-color: #000000;
    border-radius: 0px;
}


.LoginDialogRight {
    background-color: {{bg-100_op80}};
    border-radius: 0px;
}

.LoginDialogDesc {
    color: {{text-200}};
    font-size: 10pt;
    border: none;
    background: transparent;
}

.DialogInput {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 6px 6px;
    color: {{text-100}};
    font-size: 10pt;
    selection-background-color: {{primary-100}};
}

.DialogInput:focus {
    border: 1px solid {{primary-100}};
    background-color: {{bg-300}};
    color: white;
}

.DialogLineEditInner {
    background-color: rgba(15, 35, 35, 0.5);
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-200}};
}
.DialogLineEditInner[state="focus"] {
    border: 2px solid {{primary-100}};
    background-color: rgba(15, 35, 35, 0.8);
}

.DialogLineEditIcon {
    background: transparent;
    color: {{text-200}};
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
    border: none;
}


.LoginDialogStatus {
    font-size: 9pt;
    background: transparent;
}

.LoginDialogStatus[state="success"] {
    color: #10b981;
}

.LoginDialogStatus[state="error"] {
    color: #ef4444;
}

.LoginDialogStatus[state="info"] {
    color: {{primary-100}};
}

.CopyBtn {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 4px;
}

.CopyBtn:hover {
    background-color: {{bg-300}};
    border: 1px solid {{primary-100}};
}

.DialogCheckbox {
    color: {{text-100}};
    font-size: 11pt;
    padding-left: 2px;
}


/* ============ Common Dialog Styles ============ */

.PlusDialogWidget {
    background: transparent;
}

.PlusDialogContainer {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

.PlusDialogHeader {
    background-color: {{bg-300}};
    border-radius: 0px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid {{border-100}};
}

.PlusDialogTitle {
    color: {{text-100}};
    font-size: 12pt;
    font-weight: bold;
    border: none;
    background: transparent;
}

.PlusDialogBody {
    border: none;
    background: transparent;
}

.PlusDialogText {
    color: {{text-200}};
    font-size: 12pt;
    border: none;
    background: transparent;
}

.PlusDialogIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 34pt;
    border: none;
    background: transparent;
}

.PlusDialogIcon[type="info"] { color: {{primary-100}}; }
.PlusDialogIcon[type="warning"] { color: #F59E0B; }
.PlusDialogIcon[type="critical"] { color: #EF4444; }
.PlusDialogIcon[type="question"] { color: {{primary-100}}; }

.PlusDialogFooter {
    border-radius: 0px;
    border-top: 1px solid {{border-100}};
    background: {{bg-100}};
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.PlusDialogInput {
    background-color: rgba(255, 255, 255, 0.05);
    color: white;
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 8px;
    font-size: 12pt;
}

.PlusDialogInput:focus {
    border: 1px solid {{primary-100}};
}

/* QSpinBox specific in PlusDialog */
QSpinBox.PlusDialogInput::up-button, 
QSpinBox.PlusDialogInput::down-button {
    width: 20px;
    border: none;
    background: transparent;
}

/* ============ PlusSnakeBar ============ */

.PlusSnakeBarWidget {
    background: transparent;
}

.PlusSnakeBarContainer {
    background: {{bg-100}};
    color: {{text-200}};
    border-radius: 12px;
}

.PlusSnakeBarTitle {
    color: {{text-200}};
    font-weight: bold;
}

.PlusSnakeBarLabel {
    color: {{text-200}};
}

.PlusSnakeBarCloseIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
    color: {{text-200}};
    background: transparent;
    border: none;
}

/* ============ PlusDrawingToolbar ============ */

.DrawingToolbarContainer {
    background: transparent;
}

.ToolbarSeparator {
    background-color: transparent;
    border: none;
}

.ToolbarSeparatorLine {
    background-color: {{border-100}};
    border: none;
}

.ShapeSelectButton {
    background-color: transparent;
    border: none;
}

.ShapeSelectButtonCaption {
    color: {{text-100}};
    background-color: transparent;
    border: none;
}

.ShapeSelectButtonCaption[unfocused="true"] {
    color: rgba(255, 255, 255, 0.6);
}

.ShapeSelectButtonSeparator {
    background-color: {{border-100}};
    border: none;
}

.ShapeSelectButtonSeparator[unfocused="true"] {
    background-color: rgba({{border-100-rgb}}, 0.6);
}

.ToolbarWeldNoEdit {
    background-color: transparent;
    border: none;
}


.ToolbarWeldNoEditFrame {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.ToolbarWeldNoEditFrame[focus="true"] {
    border: 1px solid {{accent-100}};
}

.ToolbarWeldNoEditSpinBox {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    padding: 1px;
    margin: 0px;
}

/* Hide spinbox buttons as they are replaced by custom buttons */
.ToolbarWeldNoEditSpinBox::up-button, 
.ToolbarWeldNoEditSpinBox::down-button {
    width: 0px;
}

.ToolbarWeldNoEditButton {
    background-color: {{bg-100}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    border-radius: 3px;
    font-weight: bold;
    font-size: 10pt;
    padding: 2px;
}

.ToolbarWeldNoEditButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid {{accent-100}};
}

.ToolbarWeldNoEditButton:pressed {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid {{accent-100}};
}

.ToolbarWeldNoEditPrefix {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    padding: 0px;
    margin: 0px;
}

/* Prefix ComboBox special styling */
QComboBox.ToolbarWeldNoEditPrefix {
    padding-right: 0px;
}

QComboBox.ToolbarWeldNoEditPrefix::drop-down {
    width: 0;
    border: none;
}

QComboBox.ToolbarWeldNoEditPrefix::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

QComboBox.ToolbarWeldNoEditPrefix QAbstractItemView {
    background-color: {{bg-100}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    selection-background-color: {{primary-100}};
    min-width: 200px;
}

/* ============ ToolbarSpinEdit ============ */

.ToolbarSpinEdit {
    background-color: transparent;
    border: none;
}

.ToolbarSpinEditFrame {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.ToolbarSpinEditFrame[focus="true"] {
    border: 1px solid {{accent-100}};
}

.ToolbarSpinEditFrame[unfocused="true"] {
    background-color: rgba({{bg-200-rgb}}, 0.6);
    border: 1px solid rgba({{border-100-rgb}}, 0.6);
}

.ToolbarSpinEditSpinBox {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    padding: 4px;
    margin: 0px;
}

.ToolbarSpinEditSpinBox[unfocused="true"] {
    color: rgba(255, 255, 255, 0.6);
}

/* Hide spinbox buttons */
.ToolbarSpinEditSpinBox::up-button, 
.ToolbarSpinEditSpinBox::down-button {
    width: 0px;
}

.ToolbarSpinEditButton {
    background-color: {{bg-100}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    border-radius: 3px;
    font-weight: bold;
    font-size: 10pt;
    padding: 2px;
}

.ToolbarSpinEditButton[unfocused="true"] {
    background-color: rgba({{bg-100-rgb}}, 0.6);
    color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba({{border-100-rgb}}, 0.6);
}

.ToolbarSpinEditButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid {{accent-100}};
}

.ToolbarSpinEditButton:pressed {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid {{accent-100}};
}

/* ============ PlusBasicWidget components ============ */

.PlusBasicLabel {
    color: {{text-100}};
    background-color: transparent;
    border: none;
}

.PlusBasicLabel[unfocused="true"] {
    color: rgba(255, 255, 255, 0.6);
}

.PlusBasicSeparatorContainer {
    background-color: transparent;
    border: none;
}

.PlusBasicSeparatorContainer[unfocused="true"] {
    background-color: rgba({{bg-100-rgb}}, 0.6);
}

.PlusBasicSeparator {
    background-color: {{border-100}};
    border: none;
}

.PlusBasicSeparator[unfocused="true"] {
    background-color: rgba({{border-100-rgb}}, 0.6);
}

/* ============ PlusCanvasToolbar ============ */

.PlusCanvasToolbar {
    background-color: {{bg-200}};
    border-left: 1px solid {{border-100}};
    width: 32px;
}

.CanvasToolbarSeparator {
    background-color: #555555;
}

.IconFontButton {
    background-color: transparent;
    color: {{text-100}};
    font-family: "{{font-icon}}";
    border-radius: 4px;
    border: none;
    outline: none;
    padding: 0px;
    margin: 0px;
    min-width: 32px;
    min-height: 32px;
}

.IconFontButton:hover {
    background-color: #3a3a3e;
}

.IconFontButton:pressed {
    background-color: {{bg-300}};
    padding-top: 2px;
    padding-left: 2px;
}

.IconFontButton:checked {
    background-color: rgba({{primary-100-rgb}}, 0.25);
    border: 1px solid {{primary-100}};
    color: {{primary-100}};
}

.ShapeToolButton {
    background-color: transparent;
    border-radius: 8px;
    border: none;
    outline: none;
    min-height: 48px;
}

.ShapeToolButton:hover {
    background-color: #3a3a3e;
}

.ShapeToolButton:pressed {
    background-color: {{bg-300}};
    padding-top: 2px;
    padding-left: 2px;
}

.ShapeToolButton:checked {
    background-color: rgba({{primary-100-rgb}}, 0.25);
    border: 1px solid {{primary-100}};
}

.ShapeToolButtonIcon {
    font-family: "{{font-icon}}";
    font-size: 18pt;
    color: {{text-100}};
    background-color: transparent;
}

.ShapeToolButtonLabel {
    font-family: "{{font-sans}}";
    font-size: 10pt !important;
    color: {{text-200}};
    background-color: transparent;
}

.ShapeToolButton:checked .ShapeToolButtonLabel {
    color: {{text-100}};
}

.FloatingShapeToolbar {
    background-color: transparent;
    border: none;
}

.FloatingShapeToolbarContainer {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

.CanvasScaleLabel {
    color: white;
    font-size: 6pt;
    font-weight: bold;
    background-color: transparent;
}

/* DatePicker */
.DatePickerButton {
    background-color: transparent;
    color: {{text-200}};
    padding: 6px 10px;
    border: 1px solid {{border-100}};
    border-radius: 6px;
    font-family: "{{font-sans}}";
    font-size: 10pt;
    text-align: left;
}

/* ============ Floating Shadow Container Zeroing ============ */
#ShadowContainer {
    background-color: rgba(0, 0, 0, 0) !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0px !important;
    margin: 0px !important;
    padding: 0px !important;
}

.DatePickerButton:hover {
    border: 1px solid {{border-100}};
    background-color: {{bg-300}};
}

.DatePickerButton:pressed {
    border: 1px solid {{accent-100}};
    background-color: {{bg-200}};
}

.CalendarPopup {
    background-color: transparent;
    border: none;
}

.CalendarContent {
    background-color: {{bg-100}};
    border-radius: 10px;
}

.CalendarHeader {
    background-color: transparent;
}

.CalendarYearLabel {
    color: {{text-100}};
    padding-right: 6px;
    background-color: transparent;
}

.CalendarMonthLabel {
    color: {{text-100}};
    background-color: transparent;
}

.CalendarTodayButton {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    padding: 2px 6px;
}

.CalendarTodayButton:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.CalendarNavButton {
    color: {{text-100}};
    background-color: transparent;
    border: none;
    padding: 2px;
}

.CalendarNavButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.CalendarHelpContainer {
    background-color: transparent;
    border: none;
}

.CalendarHelpIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
    color: {{text-200}};
    border: none;
    background-color: transparent;
}

.CalendarHelpLabel {
    color: {{text-200}};
    font-family: "{{font-sans}}";
    font-size: 9pt;
    border: none;
    background-color: transparent;
}

/* Custom Calendar Base Styling */
QCalendarWidget.CustomCalendar {
    background: transparent;
    color: {{text-100}};
    border: none;
    font-size: 9pt;
}

QCalendarWidget.CustomCalendar QAbstractItemView:enabled {
    background-color: {{bg-100}};
    color: {{text-100}};
    selection-background-color: #ffffff;
    selection-color: #222222;
}

QCalendarWidget.CustomCalendar QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

QCalendarWidget.CustomCalendar QAbstractItemView::item {
    min-width: 40px;
    min-height: 34px;
    margin: 2px;
    padding: 2px;
    text-align: center;
    border-radius: 18px;
    font-size: 9pt;
}

QCalendarWidget.CustomCalendar QHeaderView::section { 
    color: {{text-200}}; 
    font-size: 8pt; 
    min-width: 40px;
    background-color: transparent;
    border: none;
}

QCalendarWidget.CustomCalendar QToolButton {
    font-size: 8pt;
}

QCalendarWidget.CustomCalendar QPushButton {
    font-size: 8pt;
}

/* Process Widgets (BackDropProgress, WaitingProcess) */
.ProcessBrand {
    font-family: "{{font-sans}}";
    font-size: 10pt;
    font-weight: normal;
    letter-spacing: 5px;
    color: {{text-100}};
    background: transparent;
    text-transform: uppercase;
}

.ProcessTitle {
    font-family: "{{font-sans}}";
    font-size: 22pt;
    font-weight: bold;
    letter-spacing: 2px;
    color: #ffffff;
    background: transparent;
}

.ProcessStatusText {
    font-family: "{{font-sans}}";
    font-size: 38pt;
    font-weight: 900;
    color: #ffffff;
    background: transparent;
}

.ProcessStatusText[state="error"] {
    color: #ff5252;
    font-size: 26pt;
}

.ProcessSubText {
    font-family: "{{font-sans}}";
    font-size: 8pt;
    letter-spacing: 2px;
    color: #00e5ff;
    background: transparent;
}

.ProcessSubText[state="error"] {
    color: #ff5252;
}

.ProcessBar {
    background-color: #1e293b;
    border: none;
    border-radius: 3px;
}

.ProcessBar::chunk {
    background-color: #00e5ff;
    border-radius: 3px;
}

.ProcessLogConsole {
    background-color: rgba(0, 0, 0, 160);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 6px;
}

.ProcessLogHeaderTitle {
    font-family: "{{font-gothic}}";
    font-size: 9pt;
    color: #64748b;
    font-weight: bold;
    background: transparent;
}

.ProcessLogHeaderStatus {
    font-family: "{{font-gothic}}";
    font-size: 9pt;
    color: #00e5ff;
    font-weight: bold;
    background: transparent;
}

.ProcessLogHeaderStatus[state="done"] {
    color: #4ade80;
}

.ProcessLogHeaderStatus[state="failed"] {
    color: #ff5252;
}

.ProcessLogSep {
    background-color: rgba(255, 255, 255, 0.08);
    border: none;
}

.ProcessLogScroll {
    background: transparent;
}

.ProcessLogRowDot {
    background-color: #00e5ff;
    border-radius: 3px;
    border: none;
}

.ProcessLogRowDot[state="pulse"] {
    background-color: #334155;
}

.ProcessLogRowText {
    font-family: "{{font-sans}}";
    font-size: 10pt;
    color: rgba(0, 229, 255, 0.7);
    border: none;
    background: transparent;
}

.ProcessLogRowText[state="pulse"] {
    font-size: 9pt;
    color: #475569;
}

.ProcessLogRowStatus {
    font-family: "{{font-sans}}";
    font-size: 10pt;
    color: #ffffff;
    font-weight: bold;
    border: none;
    background: transparent;
}

.ProcessLogRowStatus[state="active"] {
    color: #00e5ff;
}

.ProcessLogRowStatus[state="error"] {
    color: #ff5252;
}

.ProcessActionButton {
    border-radius: 22px;
    font-weight: bold;
    min-height: 45px;
    font-family: "{{font-sans}}";
    font-size: 11pt;
}

.ProcessActionButton[type="main"] {
    background-color: rgba(0, 229, 255, 0.12);
    border: 1px solid #00e5ff;
    color: #00e5ff;
}

.ProcessActionButton[type="main"]:hover {
    background-color: #00e5ff;
    color: #121212;
}

.ProcessActionButton[type="secondary"] {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: {{text-200}};
}

.ProcessActionButton[type="secondary"]:hover {
    background-color: rgba(0, 229, 255, 0.1);
    border-color: #00e5ff;
    color: #00e5ff;
}

.BackDropFooterLine {
    background-color: rgba(255, 255, 255, 0.15);
    border: none;
}

/* RevisionBackdrop */
.RevisionBackdrop {
    qproperty-overlay_color: rgba(0, 0, 0, 180);
    qproperty-text_color: #ffffff;
    qproperty-notice_color: rgba(255, 255, 255, 180);
}

/* ============ TabManager & DrawingTabs ============ */
#tabContainer {
    background-color: {{bg-300}};
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
    /* 만약 하단까지 필요하시면 아래 추가 */
    /* border-bottom: 1px solid {{border-100}}; */
}

QTabWidget#DrawingTabWidget {
    background: {{bg-300}};
    border: none !important;
    margin: 0px;
    padding: 0px;
}

QTabWidget#DrawingTabWidget::pane {
    background: {{bg-300}};
    border: none !important;
    border-top: 1px solid {{border-100}};
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
    top: -1px;
    margin-right: 0px;
    padding: 0px;
}

QTabBar {
    left: 2px;
    right: 2px;
}

QTabWidget#DrawingTabWidget QTabBar::tab {
    background: {{bg-300}};
    border: none;
    border-right: 1px solid {{border-100}};
    border-bottom: 1px solid {{border-100}};
    min-height: 25px;
    min-width: 60px;
    padding: 4px 15px;
    margin-left: 1px;
    margin-right: 0px;
    color: {{text-100}};
}

QTabWidget#DrawingTabWidget QTabBar::tab[isDirty="true"] {
    border-bottom: 3px solid {{text-300}};
}

QTabWidget#DrawingTabWidget QTabBar::tab:selected {
    background: {{bg-100}};
    border-bottom: 1px solid {{border-100}};
    color: {{primary-100}};
}

QTabWidget#DrawingTabWidget QTabBar::tab:selected[isDirty="true"] {
    border-bottom: 3px solid {{text-300}};
}

QTabWidget#DrawingTabWidget QTabBar::tab:hover:!selected {
    background: {{bg-200}};
}


QTabWidget#DrawingTabWidget QTabBar::close-button {
    image: none;
    width: 0px;
    height: 0px;
}

.TabCloseButton {
    color: {{text-100}};
    background: transparent;
    border-radius: 2px;
    padding: 0px;
    margin: 0px;
    font-family: "{{font-icon}}" !important;
    font-size: 9pt;
}

.TabCloseButton:hover {
    background: {{bg-300}};
    color: {{text-200}};
}

.TabCloseButton[pressed="true"] {
    background: {{primary-100}};
    color: white;
}

.TabStatusIndicator {
    background: transparent;
    padding: 0px;
    margin: 0px;
    font-family: "{{font-sans}}";
    font-size: 12pt;
    font-weight: bold;
}

.TabStatusIndicator[status="running"] { color: #ef4444; }
.TabStatusIndicator[status="ready"]   { color: #ef4444; }
.TabStatusIndicator[status="hidden"]  { color: transparent; }

.TabContextMenuFrame {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 10px;
}

.TabContextMenuButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px 14px;
    text-align: left;
    color: {{text-200}};
    font-size: 10pt;
    min-height: 36px;
    max-height: 36px;
}

.TabContextMenuButton:hover {
    background: {{primary-100}};
    color: {{text-200}};
    font-weight: 600;
}

.TabContextMenuButton:pressed {
    background: {{primary-100}};
    color: {{text-200}};
    font-weight: 700;
}

.TabContextMenuButton:disabled {
    background: transparent;
    color: {{text-100}};
}

#TabContextPopupMenu {
    background: transparent;
    border: none;
}

/* ============ QGraphicsView ============ */

QGraphicsView {
    border: none !important;
    border-radius: 0px !important; /* 둥근 모서리 제거 */
    background-color: {{bg-100}};
    outline: none;
}

/* ============ ShapeSelectButton ============ */
.ShapeSelectButtonContainer {
    background-color: transparent;
    border: none;
}

.ShapeSelectButtonIconArea {
    background-color: {{bg-100}};
    border: none;
    border-radius: 0px;
}

.ShapeSelectButtonIconArea:hover {
    background-color: {{bg-100_op55}}; /* Fallback for MOUSEOVER_OPACITY 0.7 */
}

/* Checked state */
.ShapeSelectButtonIconArea[active="true"] {
    background-color: {{accent-100}};
}

.ShapeSelectButtonArrowArea {
    background-color: {{bg-200}};
    border: none;
}

.ShapeSelectSeparatorContainer {
    background-color: transparent;
}

.ShapeSelectSeparatorLine {
    background-color: {{border-200}};
    border: none;
}

.ShapeSelectSeparatorLine[unfocused="true"] {
    background-color: rgba(127, 127, 127, 153); /* 0.6 opacity fallback */
}

.ShapeSelectButtonCaption {
    color: {{text-100}};
    background-color: transparent;
    border: none;
}

.ShapeSelectButtonCaption[unfocused="true"] {
    color: rgba(255, 255, 255, 153); /* 0.6 opacity fallback */
}

/* ShapeSelectPopupMenu */
.ShapeSelectPopupMenu {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
}

/* --- ToolbarWeldNoEdit Styles --- */
QWidget[class="ToolbarWeldNoEdit"] {
    background-color: transparent;
    border: none;
}

QFrame[class="ToolbarWeldNoEditFrame"] {
    background-color: #14171F; /* bg-100 */
    border: 1px solid #333947; /* bg-300 */
    border-radius: 8px;
}

QFrame[class="ToolbarWeldNoEditFrame"][focus="true"] {
    border: 1px solid #3ED973; /* green-medium */
}

QFrame[class="ToolbarWeldNoEditFrame"][unfocused="true"] {
    opacity: 0.6;
}

QSpinBox[class="ToolbarWeldNoEditSpinBox"] {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    padding: 1px;
    margin: 0px;
    font-size: 11pt;
}

QSpinBox[class="ToolbarWeldNoEditSpinBox"]::up-button, 
QSpinBox[class="ToolbarWeldNoEditSpinBox"]::down-button {
    width: 0px;
}

QLabel[class="ToolbarWeldNoEditPrefix"] {
    border: none;
    background: transparent;
    color: #9e9e9e; /* text-200 */
    font-size: 11pt;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QComboBox[class="ToolbarWeldNoEditPrefix"] {
    border: none;
    background: transparent;
    color: #9e9e9e; /* text-200 */
    font-size: 11pt;
    text-align: center;
    padding: 0px;
    margin: 0px;
}

QComboBox[class="ToolbarWeldNoEditPrefix"]::drop-down { width: 0; border: none; }
QComboBox[class="ToolbarWeldNoEditPrefix"]::down-arrow { image: none; width: 0; height: 0; }                                   
QComboBox[class="ToolbarWeldNoEditPrefix"] QAbstractItemView {
    background-color: #14171F;
    border: 1px solid #333947;
    border-radius: 4px;
    min-width: 150px;
}

QPushButton[class="ToolbarWeldNoEditButton"] {
    background-color: #1c212b; /* bg-200 */
    color: #9e9e9e;
    border: 1px solid #333947;
    border-radius: 2px;
    font-weight: bold;
    font-size: 10pt;
}

QPushButton[class="ToolbarWeldNoEditButton"]:hover {
    background-color: rgba(62, 217, 115, 0.2);
    border: 1px solid #3ED973;
    color: #FFFFFF;
}

QPushButton[class="ToolbarWeldNoEditButton"]:pressed {
    background-color: rgba(62, 217, 115, 0.4);
    border: 1px solid #3ED973;
}

/* ============ InsertStampWidget ============ */
.InsertStampWidget {
    background: transparent;
    border: none;
}

QFrame#StampMainContainer {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

.StampHeader {
    background-color: rgba(0,0,0,0.2);
    border: none;
    border-bottom: 1px solid {{border-100}};
}

.StampHeaderIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 18pt;
    color: {{accent-100}};
    border: none;
}

.StampHeaderTitle {
    font-family: "{{font-sans-bold}}";
    font-size: 10pt;
    font-weight: bold;
    color: {{text-200}};
    letter-spacing: 1px;
    border: none;
}

.StampActionsFrame {
    background-color: rgba(0,0,0,0.1);
    border: none;
    border-bottom: 1px solid {{border-100}};
}

.StampActionBtn {
    background-color: #2A2A2A;
    border: 1px solid #444444;
    border-radius: 4px;
}

.StampActionBtn:hover {
    background-color: #353535;
}

.StampActionIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 14pt;
    color: white;
    border: none;
}

.StampActionLabel {
    font-family: "{{font-sans}}";
    font-size: 9pt;
    color: white;
    border: none;
}

.StampScrollArea {
    border: none;
    background: transparent;
}

.StampScrollWidget {
    background: transparent;
}

.StampSectionTitle {
    font-family: "{{font-sans-bold}}";
    font-size: 8pt;
    font-weight: bold;
    color: {{text-100}};
    letter-spacing: 1.5px;
    border: none;
    margin-bottom: 5px;
}

.StampPreviewItem {
    background-color: #FFFFFF;
    border: 2px solid {{border-100}};
    border-radius: 4px;
}

.StampPreviewItem:hover {
    border-color: {{accent-100}};
    background-color: #F8F8F8;
}

.StampFooter {
    background-color: rgba(0,0,0,0.2);
    border: none;
    border-top: 1px solid {{border-100}};
}

.StampFooterTip {
    font-family: "{{font-sans}}";
    font-size: 8pt;
    color: {{text-100}};
    border: none;
}

.StampEmptyLabel {
    color: {{text-100}};
    font-size: 9pt;
}

/* ============ FloatingTextToolbar Figma Style ============ */
#FloatingTextToolbarContainer {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    padding: 0px 0px;
}

#FloatingTextToolbarContainer QFrame {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
}

#FloatingTextToolbarContainer QLabel {
    color: {{text-200}};
    background-color: transparent;
    border: none;
    font-size: 10pt;
    font-weight: bold;
    letter-spacing: 0.5px;
}

.FloatingGrip {
    color: {{text-100}};
    background-color: transparent;
    font-size: 22pt;
    padding-left: 4px;
}

.FloatingCapsule {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 17px; /* For height 34px */
    padding: 1px 4px;
    color: {{text-200}};
    font-size: 10pt;
}

.FloatingCapsule QAbstractItemView {
    background-color: {{bg-200}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    selection-background-color: {{primary-100}};
    outline: none;
    padding: 2px;
}

.FloatingCapsule QAbstractItemView::item {
    height: 28px;
    padding: 4px;
}

.FloatingCapsule QAbstractItemView::item:selected {
    background-color: {{primary-100}};
    border: 1px solid {{border-100}};
    color: {{text-200}};
}

.FloatingCapsule:hover {
    background-color: #323238;
    border-color: {{accent-100}};
}

.SegmentedControl {
    background-color: {{bg-100}};
    border-radius: 8px;
    padding: 0px;
    border: none;
}

.SegmentedButton {
    background-color: {{bg-100}};
    border: none;
    border-radius: 8px;
    color: {{text-100}};
    min-width: 24px;
    min-height: 24px;
    font-family: {{font-icon}};
    font-size: 12pt;
}

.SegmentedButton:hover {
    background-color: #3a3a3e;
    color: {{text-200}};
}

.SegmentedButton:checked {
    background-color: {{accent-100}};
    color: {{text-300}};
}

.FloatingSlider::groove:horizontal {
    border: none;
    height: 2px;
    background: {{border-100}};
    margin: 0px;
    border-radius: 1px;
}

.FloatingSlider::handle:horizontal {
    background: {{accent-100}};
    border: 2px solid {{border-100}};
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

.FloatingSlider::handle:horizontal:hover {
    background: {{text-300}};
}

.DigitalValue {
    background-color: #2a2a2e;
    border-radius: 4px;
    color: {{accent-100}};
    font-size: 10pt;
    font-weight: bold;
    padding: 1px 2px;
    min-width: 32px;
}

.FloatingSeparator {
    background-color: {{border-100}};
    width: 1px;
    max-width: 1px;
    margin: 2px 2px; 
}

.ColorIcon {
    border-radius: 12px;
    border: 2px solid #444448;
}

.FloatingModernLabel {
    color: {{text-200}};
    background-color: transparent;
    border: none;
    font-size: 10pt;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

/* Modern Widgets Classes */
.ModernDatePickerButton {
    background-color: rgba(15, 35, 35, 0.5);
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-200}};
    padding: 0;
}
.ModernDatePickerButton[state="focus"] {
    border: 2px solid {{primary-100}};
    background-color: rgba(15, 35, 35, 0.8);
}
.ModernDatePickerButton:hover {
    border: 1px solid {{primary-100}};
}

.DatePickerText {
    background: transparent;
    border: none;
    color: {{text-200}};
    font-size: 12pt;
    padding: 0;
}

.DatePickerIcon {
    background: transparent;
    border: none;
    color: {{text-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 14pt;
}

.DatePickerButton[iconMode="true"] {
    font-family: "{{font-icon}}" !important;
    font-size: 11pt;
    min-width: 60px;
    color: {{text-100}};
    letter-spacing: 0px;
    text-align: center;
    padding: 0px 0px;
}

.DatePickerButton[iconMode="false"] {
    font-family: "{{font-sans}}" !important;
    font-size: 10pt !important;
    color: {{text-200}};
    letter-spacing: 0px;
    text-align: left;
    padding: 6px 10px;
}

.DatePickerButton[hasPrefixIcon="true"] {
    text-align: left;
    padding-left: 28px;
}

.DatePickerPrefixIcon {
    background: transparent;
    border: none;
    color: {{text-100}};
    font-family: "{{font-icon}}" !important;
}

QLineEdit#WeldJointEditor_DateInput {
    font-family: "{{font-sans}}" !important;
    font-size: 9pt !important;
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    color: {{text-200}};
    padding: 2px 6px;
}

QLabel#WeldJointEditor_CalendarIcon {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    color: {{text-100}};
    margin-bottom: 1px;
    font-family: "{{font-icon}}" !important;
    font-size: 11pt;
    qproperty-alignment: AlignCenter;
}

QComboBox#WeldJointEditor_ComboBox QAbstractItemView {
    background-color: {{bg-200}} !important;
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    selection-background-color: {{bg-300}};
    selection-color: {{primary-100}};
}

QPushButton#WeldJointEditor_DateButton {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    color: {{text-200}};
    padding: 2px 6px;
    font-size: 10pt;
    font-family: "{{font-sans}}";
    letter-spacing: 0px;
    text-align: left;
}

QPushButton#WeldJointEditor_DateButton[iconMode="true"] {
    font-family: "{{font-icon}}" !important;
    font-size: 11pt;
    min-width: 60px;
    color: {{text-100}};
    letter-spacing: 0px;
    text-align: center;
    padding: 0px;
}

QPushButton#WeldJointEditor_DateButton[iconMode="false"] {
    font-family: "{{font-sans}}" !important;
    font-size: 10pt !important;
    color: {{text-200}};
    letter-spacing: 0px;
    text-align: left;
    padding: 6px 10px;
}

/* ============ ProjectEditForm & Sub-widgets ============ */

.InfoBox {
    background-color: rgba(0, 224, 224, 0.05);
    border: 1px solid rgba(0, 224, 224, 0.1);
    border-radius: 8px;
}

.InfoText {
    color: {{text-100}};
    font-size: 9pt;
}

.FieldLabel {
    color: {{text-100}};
    font-size: 10pt;
    font-weight: bold;
    padding: 0px 0px 5px 0px;
    text-transform: uppercase;
}


/* OrderEditForm Styles */
.SettingFormIconBg {
    background-color: rgba(0, 224, 224, 0.2);
    border-radius: 8px;
}


.SettingFormProjectText {
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 14pt;
    font-weight: bold;
    border: none;
}

QScrollArea#ContentScroll,
.SettingFormScrollArea {
    background: transparent;
    border: none;
}

QWidget#ContentViewport,
QWidget#ContentWidget,
.SettingFormScrollArea QWidget {
    background: transparent;
}

.AccordionSection {
    background-color: rgba(41, 52, 56, 0.2); 
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

.AccordionHeader {
    border: none;
    background: transparent;
}

.AccordionTitle {
    color: {{text-200}};
    font-family: "{{font-sans}}";
    font-size: 14pt;
    font-weight: bold;
    border: none;
}

.AccordionArrow {
    color: {{text-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
    border: none;
}

.AccordionContent {
    background: transparent;
}

.AccordionSeparator {
    background-color: {{border-100}};
    border: none;
}

.SectionHeaderIcon {
    color: {{primary-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 14pt;
    border: none;
}

.SectionHeaderTitle {
    color: {{text-100}};
    font-family: "{{font-sans}}";
    font-size: 12pt;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.InfoBox {
    background-color: rgba(0, 224, 224, 0.05);
    border: 1px solid rgba(0, 224, 224, 0.1);
    border-radius: 8px;
}

.InfoBoxText {
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 10pt;
}

.OrderFormFooter {
    border: none;
    background-color: {{bg-200}};
}

/* ============ WelderListForm (용접사 현황 양식) ============ */
#WelderListContainer {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

#WelderListSidebar {
    background-color: {{bg-100}};
    border-right: 1px solid {{border-100}};
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

/* ── WelderListSidebarHeader: PageWidgetHeader 스타일로 실제 IsometricDrawingList Header와 동일 ── */
#WelderListSidebarHeader {
    background-color: {{bg-200}};
    border-bottom: 1px solid {{border-100}};
}

#WelderListSearchWrap {
    background-color: {{bg-100}};
    border: none;
}

#WelderListProfileCard {
    background-color: {{bg-200}};
    border-top: 1px solid {{border-100}};
    border-bottom: 1px solid {{border-100}};
}

#WelderListSidebarFooter {
    background-color: rgba(30, 30, 30, 0.3);
    border: none;
    border-top: 1px solid {{border-100}};
    border-radius: 0px;
    border-bottom-left-radius: 12px;
}


#WelderListMainArea {
    background-color: {{bg-100}};
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

#WelderListScroll,
#WelderListScroll > QWidget,
#WelderListScroll QWidget#qt_scrollarea_viewport,
#WelderListScrollContent {
    background-color: {{bg-100}};
    border: none;
}

/* Sidebar Search – SearchInput 클래스 사용 (IsometricDrawingList 와 동일) */
#WelderListSearchInput {
    background: transparent;
    border: none;
    color: {{text-200}};
    font-size: 10pt;
    padding: 0px;
}
#WelderListSearchInput:focus {
    border: none;
    outline: none;
}

#WelderListSortMode {
    background-color: {{bg-200}};
    border: none;
    border-radius: 8px;
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 10pt;
    padding: 0 8px;
    margin-left: 6px;
    min-width: 86px;
}

#WelderListSortMode:hover {
    background-color: {{bg-300}};
}

#WelderListSortMode:focus {
    border: 1px solid {{primary-100}};
}

#WelderListSortMode::drop-down {
    border: none;
    width: 18px;
}

#WelderListSortMode QAbstractItemView {
    background-color: {{bg-200}};
    color: {{text-200}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
    outline: none;
    padding: 4px;
    selection-background-color: {{primary-100}};
    selection-color: white;
}

#WelderListSortMode QAbstractItemView::item {
    background: transparent;
    color: {{text-200}};
    border-radius: 4px;
    padding: 6px 8px;
    min-height: 24px;
}

#WelderListSortMode QAbstractItemView::item:hover {
    background-color: {{bg-300}};
    color: {{text-300}};
}

#WelderListSortMode QAbstractItemView::item:selected {
    background-color: {{primary-100}};
    color: white;
}

#WelderListSearchIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 18pt;
    color: {{text-100}};
    background: transparent;
    border: none;
}

#WelderListSidebarIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
    color: {{primary-100}};
    background: transparent;
    border: none;
}

#WelderListSidebarTitle {
    font-family: "{{font-sans}}";
    font-size: 16pt;
    font-weight: 700;
    color: {{text-100}};
    background: transparent;
    border: none;
    padding-left: 4px;
}

/* Welder List Item */
WelderItemWidget {
    background-color: transparent;
    border-radius: 0px;
    border-bottom: 1px solid {{border-100}};
    border-left: 4px solid transparent;
}
WelderItemWidget:hover {
    background-color: {{bg-300}};
}
WelderItemWidget[active="true"] {
    background-color: {{bg-200}};
    border-left: 4px solid {{primary-100}};
}

WelderItemWidget QLabel#WelderID {
    font-family: "{{font-sans}}";
    font-size: 9pt;
    font-weight: 500;
    color: {{text-100}};
    border: none;
    background: transparent;
    opacity: 0.7;
}

WelderItemWidget QLabel#WelderName {
    font-family: "{{font-sans}}";
    font-size: 12pt;
    font-weight: 600;
    color: #E0E0E0;
    border: none;
    background: transparent;
}
WelderItemWidget[active="true"] QLabel#WelderName {
    color: {{text-300}};
}

WelderItemWidget QLabel#WelderMeta {
    font-family: "{{font-sans}}";
    font-size: 9pt;
    font-weight: 500;
    color: {{text-100}};
    border: none;
    background: transparent;
}

WelderItemWidget[active="true"] QLabel#WelderMeta {
    color: {{text-300}};
}

WelderItemWidget[expiry_state="soon"] QLabel#WelderMeta {
    color: #FB923C;
}

WelderItemWidget[expiry_state="expired"] QLabel#WelderMeta {
    color: #EF4444;
    font-weight: 700;
}

WelderItemWidget[expiry_state="expired"] {
    border-left: 4px solid #EF4444;
    background-color: rgba(239, 68, 68, 0.08);
}

WelderItemWidget[expiry_state="expired"][active="true"] {
    background-color: rgba(239, 68, 68, 0.14);
    border-left: 4px solid #EF4444;
}

/* 2행 날짜 정보 스타일 */
WelderItemWidget QLabel#WelderBirthDate,
WelderItemWidget QLabel#WelderExpiryDate {
    font-family: "{{font-sans}}";
    font-size: 8pt;
    font-weight: 500;
    color: {{text-100}};
    border: none;
    background: transparent;
}

WelderItemWidget[active="true"] QLabel#WelderBirthDate,
WelderItemWidget[active="true"] QLabel#WelderExpiryDate {
    color: {{text-100}};
}

WelderItemWidget QLabel#WelderExpiryDate {
    color: {{accent-100}};
}

WelderItemWidget QLabel#WelderExpiryDate[expiry_state="soon"] {
    color: #EF4444;
    font-weight: 700;
}

WelderItemWidget QLabel#WelderExpiryDate[expiry_state="expired"] {
    color: #EF4444;
    font-weight: 700;
}

WelderItemWidget QLabel#WelderDateSep {
    font-size: 8pt;
    color: {{border-100}};
    background: transparent;
    border: none;
}

QFrame#WelderGroupHeader {
    background-color: rgba(255, 255, 255, 0.03);
    border: none;
    border-top: 1px solid {{border-100}};
}

QLabel#WelderGroupHeaderLabel {
    font-family: "{{font-sans}}";
    font-size: 9pt;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: {{text-100}};
    border: none;
    background: transparent;
}

QDialog#WelderEditDialog {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 10px;
}

QFrame#WelderEditDialogHeader {
    background-color: {{bg-200}};
    border: none;
    border-bottom: 1px solid {{border-100}};
    border-radius: 0px;
}

QLabel#WelderEditDialogTitle {
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 12pt;
    font-weight: 700;
    border: none;
    background: transparent;
}

QDialog#WelderEditDialog QLabel {
    color: {{text-200}};
    font-family: "{{font-sans}}";
}

QDialog#WelderEditDialog QLabel[class~="MaterialIcon"],
QDialog#WelderEditDialog QLabel[class~="WelderSectionIcon"],
QDialog#WelderEditDialog QLabel[class~="Icon_16"] {
    font-family: "{{font-icon}}" !important;
}

QDialog#WelderEditDialog QDialogButtonBox#WelderEditButtonBox QPushButton#WelderEditSaveBtn {
    background-color: {{primary-100}};
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 10pt;
    min-height: 36px;
    padding: 0 14px;
}

QDialog#WelderEditDialog QDialogButtonBox#WelderEditButtonBox QPushButton#WelderEditSaveBtn:hover {
    background-color: {{primary-200}};
}

QDialog#WelderEditDialog QDialogButtonBox#WelderEditButtonBox QPushButton#WelderEditCancelBtn {
    background-color: transparent;
    color: {{text-100}};
    border: 1px solid {{primary-100}};
    border-radius: 6px;
    font-weight: bold;
    font-size: 10pt;
    min-height: 36px;
    padding: 0 14px;
}

QDialog#WelderEditDialog QDialogButtonBox#WelderEditButtonBox QPushButton#WelderEditCancelBtn:hover {
    background-color: {{bg-100}};
}

#WelderEditMediaRow {
    background: transparent;
}

QFrame#WelderEditPhotoDropPanel,
QFrame#WelderEditResumeDropPanel {
    background-color: {{bg-200}};
    border: 1px dashed {{border-100}};
    border-radius: 8px;
}

QLabel#WelderEditMediaTitle {
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 10pt;
    font-weight: 700;
    border: none;
    background: transparent;
}

QLabel#WelderEditMediaHint {
    color: {{text-100}};
    font-family: "{{font-sans}}";
    font-size: 9pt;
    border: none;
    background: transparent;
}

#WelderEditPhotoThumb {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 10px;
}

#WelderEditResumeDropWidget {
    background-color: {{bg-100}};
    border: 1px dashed {{primary-100}};
    border-radius: 8px;
}

WelderItemWidget QLabel#WelderChevron {
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
    color: {{text-100}};
    border: none;
    background: transparent;
}

QPushButton#WelderFormAddBtn {
    background-color: rgba(69, 142, 142, 0.15);
    border: 1px dashed {{primary-100}};
    border-radius: 12px;
}

QPushButton#WelderFormAddBtn:hover {
    background-color: rgba(69, 142, 142, 0.25);
    border: 1px solid {{primary-100}};
}

QPushButton#WelderFormAddBtn QLabel {
    color: {{primary-100}} !important;
    background: transparent;
    border: none;
    font-family: "{{font-sans}}";
    font-size: 14pt;
    font-weight: 700;
}

QPushButton#WelderFormAddBtn QLabel[class="Icon"] {
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
}

QPushButton.WelderAssignBtn {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 11pt;
    font-weight: 600;
}
QPushButton.WelderAssignBtn:hover {
    background-color: {{primary-100}};
    color: white;
    border: none;
}

/* Form Layout */
#WelderFormHeader {
    border-top-right-radius: 12px;
    border-bottom: 1px solid {{border-100}};
    padding-bottom: 16px;
}

#WelderStatusTag {
    background-color: rgba(34, 115, 195, 0.2);
    color: {{primary-100}};
    font-family: "{{font-sans}}";
    font-size: 10pt;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 12px;
    border: none;
}

#WelderFormTitleInput {
    background: transparent;
    border: none;
    border-radius: 0px;
    border-bottom: 1px solid transparent;
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 38pt;
    font-weight: 700;
    padding-top: 15px;
    padding-bottom: 2px;
}
#WelderFormTitleInput[sub="true"] {
    color: {{text-100}};
    font-size: 22pt;
    font-weight: normal;
}
#WelderFormTitleInput[skill="true"] {
    color: {{text-100}};
    font-size: 18pt;
    font-weight: normal;
}
#WelderFormTitleInput:focus:!readOnly {
    border-bottom: 1px solid {{primary-100}};
}

#WelderCloseBtn {
    background-color: transparent;
    color: {{text-100}};
    border: none;
    border-radius: 4px;
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
    padding-bottom: 2px;
}
#WelderCloseBtn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: {{text-300}};
}

/* Sections */
QLabel.WelderSectionHeader {
    font-family: "{{font-sans}}";
    font-size: 12pt;
    font-weight: 700;
    color: {{text-100}};
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
}

QLabel.WelderSectionIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 12pt;
    color: {{text-100}};
    border: none;
}

QFrame.WelderInfoCard {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

/* Photo Widget */
WelderPhotoWidget {
    background-color: {{bg-200}};
    border: 1px solid transparent;
    border-radius: 12px;
}
WelderPhotoWidget[editMode="true"] {
    border: 2px dashed {{primary-100}};
}

WelderPhotoWidget QLabel#PhotoIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 34pt;
    color: {{text-100}};
    border: none;
}

WelderPhotoWidget QPushButton#RotateBtn {
    background-color: rgba(0, 0, 0, 0.6);
    color: white;
    border-radius: 15px;
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
    border: 1px solid {{border-100}};
    padding: 0px;
    margin: 0px;
}
WelderPhotoWidget QPushButton#RotateBtn:hover {
    background-color: {{primary-100}};
    border: 1px solid {{primary-100}};
}

/* Resume Widget */
WelderResumeWidget {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}

WelderResumeWidget QLabel#ResumeIcon {
    font-family: "{{font-icon}}" !important;
    font-size: 30pt;
    color: {{primary-100}}; 
    padding: 10px;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 8px;
}

WelderResumeWidget QLabel#ResumeName { 
    color: {{text-300}}; 
    font-weight: 700; 
    font-size: 14pt; 
    border: none; 
}
WelderResumeWidget QLabel#ResumeDesc { 
    color: {{text-100}}; 
    font-size: 12pt; 
    border: none; 
}
WelderResumeWidget QLabel#ResumeAction {
    font-family: "{{font-icon}}" !important;
    font-size: 22pt;
    color: {{text-100}};
}
WelderResumeWidget[editMode="true"] QLabel#ResumeAction {
    color: {{primary-100}};
}

/* Timeline/Fields */
WelderEditableField QLabel.WelderFieldTitle {
    color: {{text-100}};
    font-size: 12pt;
    border: none;
}

/* Styled for View Mode by default */
WelderEditableField QLineEdit.WelderFieldValue {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 14pt;
    font-weight: 500;
    text-align: right;
    padding: 0;
}

/* Edit Mode border if not readOnly */
WelderEditableField QLineEdit.WelderFieldValue:focus:!readOnly {
    border-bottom: 1px solid {{primary-100}};
}

TimelineItemWidget QLabel.TimelineTitle {
    color: {{text-100}};
    font-weight: 700;
    font-size: 11pt;
    border: none;
}

TimelineItemWidget QLabel.TimelineBadge {
    background-color: rgba(249, 115, 22, 0.1);
    color: #FB923C;
    font-family: "{{font-sans}}";
    font-weight: 700;
    font-size: 10pt;
    padding: 4px 8px;
    border-radius: 4px;
    border: none;
}

/* DatePicker Inside Timeline */
ModernDatePicker QLabel#DatePickerText {
    color: {{text-300}};
    font-family: "{{font-sans}}";
    font-size: 9pt;
    background: transparent;
    border: none;
}
ModernDatePicker[editMode="true"] QLabel#DatePickerText {
    font-weight: bold;
}

ModernDatePicker QLabel#DatePickerIcon {
    color: {{text-100}};
    font-family: "{{font-icon}}" !important;
    font-size: 16pt;
    background: transparent;
    border: none;
}

ModernDatePicker QPushButton {
    background-color: rgba(15, 35, 35, 0.5);
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-200}};
}
ModernDatePicker QPushButton:hover {
    border: 1px solid {{primary-100}};
}
ModernDatePicker QPushButton:focus {
    border: 2px solid {{primary-100}};
}

/* Action Buttons in Header */
QPushButton.WelderFormBtn {
    border-radius: 8px;
    font-family: "{{font-sans}}";
    font-size: 12pt;
    font-weight: 600;
    padding-bottom: 2px;
}

QPushButton.WelderFormBtn[class*="Primary"] { 
    background-color: {{primary-100}}; 
    color: white; 
    border: none; 
}
QPushButton.WelderFormBtn[class*="Primary"]:hover { 
    background-color: {{primary-200}}; 
}

QPushButton.WelderFormBtn[class*="Danger"] { 
    background-color: transparent; 
    color: #EF4444; 
    border: none; 
}
QPushButton.WelderFormBtn[class*="Danger"]:hover { 
    background-color: rgba(239, 68, 68, 0.1); 
}

QPushButton.WelderFormBtn[class*="Secondary"] { 
    background-color: {{bg-200}}; 
    color: {{text-200}}; 
    border: 1px solid {{border-100}}; 
}
QPushButton.WelderFormBtn[class*="Secondary"]:hover { 
    background-color: {{border-100}}; 
}

/* ============ StatusBar & IP Highlight ============ */
QStatusBar#MainStatusBar {
    background-color: #25282E;
    color: #A0A8B4;
}

#HighlightIP {
    color: #FFD700; /* 황금색으로 강조 */
    font-weight: bold;
    text-decoration: underline;
}

/* ============ PlusHelpPage Styles ============ */
#HelpPageContainer {
    background-color: #1A1C1E;
    color: #E1E2E5;
}

#HelpPageHeader {
    background-color: #121416;
    border-bottom: 1px solid #2D3139;
}

#HelpPageTitle {
    color: #E1E2E5;
    font-size: 22pt;
    font-weight: bold;
}

#HelpPageSubtitle {
    color: #94A3B8;
    font-size: 11pt;
}

#HelpPageBadge {
    background-color: rgba(34, 197, 94, 0.15);
    color: #22C55E;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 8pt;
    font-weight: bold;
}

#HelpBackBtn {
    background-color: #5C829D;
    color: white;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}

#HelpBackBtn:hover {
    background-color: #4A90E2;
}

.HelpCard {
    background-color: #25282E;
    border: 1px solid #2D3139;
    border-radius: 12px;
}

.HelpCardTitle {
    color: #5C829D;
    font-size: 14pt;
    font-weight: bold;
}

.HelpCardDivider {
    background-color: rgba(92, 130, 157, 0.2);
}

.HelpItemLabel {
    color: #22C55E;
    font-size: 11pt;
}

.HelpShortcutLabel {
    background-color: rgba(92, 130, 157, 0.1);
    border: 1px solid rgba(92, 130, 157, 0.3);
    border-radius: 4px;
    color: #5C829D;
    padding: 4px 10px;
    font-weight: bold;
}

.HelpMouseTitle {
    color: #E1E2E5;
    font-size: 12pt;
    font-weight: bold;
}

.HelpMouseDesc {
    color: #94A3B8;
    font-size: 10pt;
}

.MaterialIcon {
    font-family: '{{font-icon}}';
    color: {{primary-100}};
}

#HelpPageTitleIcon {
    color: {{primary-100}};
}

.HelpTechLabel {
    color: {{text-100}};
    font-size: 8pt;
    letter-spacing: 1px;
}

.HelpTechLabelReady {
    color: {{accent-100}};
    font-size: 8pt;
    letter-spacing: 1px;
}

#HelpCopyrightLabel {
    color: {{text-100}};
    font-size: 7pt;
    margin-top: 10px;
}

/* ============ Data & Report Integration Styles ============ */
.DataFormGroup {
    background-color: {{bg-300}};
    border-radius: 8px;
    padding: 15px;
    border: 1px solid {{border-100}};
}

#DataGroup {
    margin: 10px;
}

.ReportTable {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    alternate-background-color: {{bg-200}};
    gridline-color: {{border-100}};
    color: {{text-200}};
    border-radius: 8px;
}

.ReportTable::item {
    padding: 10px;
    border-bottom: 1px solid {{border-100}};
}

.ReportTable::item:selected {
    background-color: rgba(59, 131, 247, 0.2);
    color: {{primary-100}};
    border-left: 3px solid {{border-100}};
}

#HeaderTitle {
    color: {{text-200}};
    font-size: 22pt;
    font-weight: bold;
}

#HeaderSubTitle {
    color: {{text-100}};
    font-size: 9pt;
    letter-spacing: 1px;
}

#TabContainer {
    background-color: {{bg-300}};
    border-radius: 8px;
    border: 1px solid {{border-100}};
}

#TabButton {
    background-color: transparent;
    color: {{text-100}};
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

#TabButton:checked {
    background-color: {{primary-100}};
    color: white;
}

#PathEdit {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
    color: {{text-200}};
    padding: 8px;
}

#PathEdit:hover {
    border-color: {{primary-100}};
}

#LogView {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    color: {{text-100}};
    font-family: 'Consolas', monospace;
    padding: 10px;
}

/* ============ Dialog Specific Styles ============ */
.PathEdit {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
    color: {{text-200}};
    padding-left: 12px;
    font-size: 11pt;
}

.PathEdit:hover {
    border-color: {{primary-100}};
}

.PathEdit:focus {
    border-color: {{primary-100}};
    background-color: {{bg-300}};
}

#BackupListWidget {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
    outline: none;
}

#BackupListItemLabel {
    color: {{text-200}};
    font-weight: bold;
    padding: 2px 0;
}

/* Material Icon 표준 크기 (24px) */
#IconLabel {
    font-size: 22pt;
    color: {{text-100}};
    padding: 0;
    margin: 0;
}

/* 경로 입력 필드 스타일 통합 */
#path_edit {
    background-color: {{bg-300}}; /* 앱 표준 LineEdit 배경색 */
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 5px 10px;
    color: {{text-200}};
}

#path_edit:focus {
    border: 1px solid {{primary-100}};
}

#FolderBrowseButton {
    background-color: {{bg-300}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    color: {{text-100}};
    padding: 0;
}

#FolderBrowseButton:hover {
    border: 1px solid {{primary-100}};
    color: {{text-200}};
    background-color: {{bg-300}};
}

#FolderBrowseButton:pressed {
    background-color: {{bg-100}};
}

#BackupListWidget::item {
    background-color: transparent;
    border-bottom: 1px solid {{border-100}};
}

#BackupListWidget::item:hover {
    background-color: {{bg-300}};
}

#BackupListWidget::item:selected {
    background-color: {{bg-300}};
    border-left: 3px solid {{primary-100}};
}

#EmptyStateLabel {
    color: {{text-100}};
    font-size: 12pt;
    font-weight: bold;
}

#DetailInfoLabel {
    color: {{text-100}};
    font-size: 10pt;
    padding: 5px;
}

/* ============ QMenu (Selector Button) ============ */
QMenu {
    background-color: {{bg-100}};       /* 앱 메인 어두운 배경색 */
    border: 1px solid {{border-100}};       /* 연한 경계선 */
    border-radius: 6px;              /* 부드러운 라운드 처리 */
    padding: 5px 0px;                /* 위아래 여백 */
}

QMenu::item {
    background-color: transparent;
    padding: 8px 32px 8px 20px;      /* 텍스트 아이템 기본 좌측 간격 유지 */
    color: {{text-100}};                  /* 부드러운 화이트/그레이 */
    font-size: 10pt;
}

QMenu::icon {
    padding-left: 24px;               /* 아이콘만 좌측에서 24px 안쪽으로 이동 */
}

QMenu::item:selected {
    background-color: {{primary-100}};       /* 호버 시 부드러운 하이라이트 색상 */
    color: #ffffff;                  /* 포인트 컬러 (블루 계열 테마색) */
}

QMenu::separator {
    height: 1px;
    background: {{border-100}};             /* 구분선 스타일 */
    margin: 4px 0px;
}

/* ============ Footer Button (Direct Mode) ============ */
QPushButton#footer_complete_btn[activeMode="direct"] {
    background-color: {{accent-100}};
    padding: 8px 20px;
    font-weight: bold;
    font-size: 11pt;
}

#SecondaryButton:hover {
    background-color: {{bg-300}};
    color: {{text-100}};
    border-color: {{border-100}};
}


.MaterialIcon {
    font-family: 'Material Symbols Outlined Medium';
