    color: {{text-100}};
}

#HeaderTitle {
    color: {{text-200}};
    font-size: 22pt;
    font-weight: bold;
}

#HeaderSubTitle {
    color: {{text-100}};
    font-size: 9pt;
    letter-spacing: 1px;
}

#TabContainer {
    background-color: {{bg-300}};
    border-radius: 8px;
    border: 1px solid {{border-100}};
}

#TabButton {
    background-color: transparent;
    color: {{text-100}};
    border-radius: 6px;
    padding: 8px 16px;
