/* ============ QMenu (Selector Button) ============ */
QMenu {
    background-color: {{bg-100}};       /* 앱 메인 어두운 배경색 */
    border: 1px solid {{border-100}};       /* 연한 경계선 */
    border-radius: 6px;              /* 부드러운 라운드 처리 */
    padding: 5px 0px;                /* 위아래 여백 */
}

QMenu::item {
    background-color: transparent;
    padding: 8px 32px 8px 20px;      /* 텍스트 아이템 기본 좌측 간격 유지 */
    color: {{text-100}};                  /* 부드러운 화이트/그레이 */
    font-size: 10pt;
}

QMenu::icon {
    padding-left: 8px;               /* 아이콘만 좌측에서 8px 안쪽으로 이동 */
}

QMenu::item:selected {
    background-color: {{primary-100}};       /* 호버 시 부드러운 하이라이트 색상 */
    color: #ffffff;                  /* 포인트 컬러 (블루 계열 테마색) */
}

QMenu::separator {
    height: 1px;
    background: {{border-100}};             /* 구분선 스타일 */
    margin: 4px 0px;
}

/* ============ Footer Button (Direct Mode) ============ */
QPushButton#footer_complete_btn[activeMode="direct"] {
    background-color: {{accent-100}};
    border: 2px solid {{accent-100}};
    color: {{text-200}};
    font-weight: bold;
}

QPushButton#footer_complete_btn[activeMode="direct"]:hover {
    opacity: 0.9;
}

/* Hide default menu indicator because we use custom icon with RightToLeft layout */
QPushButton#footer_complete_btn::menu-indicator {
    image: none;
    width: 0px;
}

/* ============ ReportCenterPage ============ */
#ReportCenterPage {
    background-color: {{bg-300}};
    border: none;
    border-left: 1px solid {{border-100}};
    border-right: 1px solid {{border-100}};
    border-radius: 0px;
}

.ContentHeader {
    background-color: {{bg-200}};
    border-radius: 0px;
}

.PageHeaderIcon {
    color: {{primary-100}};
    font-family: "{{font-icon}}" !important;
}


.VersionBadge {
    background-color: rgba(0, 133, 255, 0.2);
    color: {{primary-100}};
    border: 1px solid rgba(0, 133, 255, 0.3);
    border-radius: 4px;
    padding: 2px 6px;
}

.PrimaryActionBtn {
    background-color: {{primary-100}};
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    padding-left: 32px;
}
.PrimaryActionBtn:hover { background-color: {{primary-200}}; }

.SecondaryActionBtn {
    background-color: {{bg-400}};
    color: {{text-100}};
    border: 1px solid {{border-200}};
    border-radius: 8px;
    padding-left: 28px;
}
.SecondaryActionBtn:hover { color: {{primary-100}}; }

.FilterLabel {
    color: {{text-100}};
    letter-spacing: 1px;
}

.FilterCombo, .FilterInput {
    background-color: {{bg-400}};
    border: 1px solid {{border-200}};
    border-radius: 8px;
    color: {{text-200}};
    padding: 4px 12px;
}
.FilterCombo:focus, .FilterInput:focus {
    border: 1px solid {{primary-100}};
}

/* Stat Cards */
.StatCard {
    background-color: {{bg-100}};
    border-radius: 12px;
}
.StatCard[state="primary"] {
    background-color: rgba(0, 133, 255, 0.1);
    border: 1px solid rgba(0, 133, 255, 0.2);
}

.StatCardTitle { color: {{text-100}}; }
.StatCard[state="primary"] .StatCardTitle { color: {{primary-100}}; }

.StatCardValue { color: {{text-200}}; }
.StatCard[state="primary"] .StatCardValue { color: {{text-200}}; }

.StatCardIcon { color: {{text-100}}; font-family: "{{font-icon}}" !important; }
.StatCard[state="primary"] .StatCardIcon { color: {{primary-100}}; }

/* Report Item */
.ReportListContainer {
    border: none;
    background-color: transparent;
}

.ReportItem {
    background-color: {{bg-100}};
    border: 1px solid {{border-100}};
    border-radius: 12px;
}
.ReportItem:hover {
    border: 1px solid rgba(0, 133, 255, 0.3);
}
.ReportItem[state="closed"] {
    opacity: 0.6;
}

.ItemCheckContainer {
    background-color: rgba(41, 46, 59, 0.3);
    border-right: 1px solid {{border-100}};
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

.ItemActionContainer {
    background-color: rgba(41, 46, 59, 0.3);
    border-left: 1px solid {{border-100}};
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

.DataLabel { color: {{text-100}}; letter-spacing: 0.5px; }
.ReportNoText { color: {{primary-100}}; font-family: "Consolas", monospace; }
.ProjectTitleText { color: {{text-200}}; }
.WOText, .MetaText, .AreaText { color: {{text-100}}; }

.ItemRowSeparator { background-color: rgba(255, 255, 255, 0.05); }

.StakeAvatar {
    border-radius: 10px;
    border: 1px solid {{border-100}};
    background-color: {{bg-400}};
}
.StakeAvatar[state="primary"] { color: {{primary-100}}; }
.StakeAvatar[state="muted"] { color: {{text-100}}; }
.StakeAvatar[state="warn"] { color: {{text-300}}; }

.StakeName { color: {{text-200}}; }

.StatusTag {
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 8pt;
    font-weight: bold;
}
.StatusTag[state="ok"] { background-color: rgba(74, 222, 128, 0.1); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.2); }
.StatusTag[state="fail"] { background-color: rgba(248, 113, 113, 0.1); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.2); }
.StatusTag[state="pending"] { background-color: rgba(251, 191, 36, 0.1); color: {{text-300}}; border: 1px solid rgba(251, 191, 36, 0.2); }

.ApprovalText { color: {{text-100}}; }

.ItemActionBtn {
    background-color: {{bg-400}};
    color: {{text-100}};
    border: 1px solid {{border-200}};
    border-radius: 8px;
    font-weight: 900;
}
.ItemActionBtn[state="locked"] { background-color: rgba(248, 113, 113, 0.1); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.2); }
.ItemActionBtn[state="locked"]:hover { background-color: #f87171; color: white; }

.BtnIcon { font-family: "{{font-icon}}" !important; color: inherit; }

/* Footer */
.ContentFooter {
    background-color: rgba(20, 23, 31, 0.95);
    border-top: 1px solid {{border-100}};
}

.FooterAvatar {
    border-radius: 12px;
    border: 2px solid {{bg-300}};
}
.FooterAvatar[state="user1"] { background-color: {{primary-100}}; color: white; }
.FooterAvatar[state="user2"] { background-color: {{bg-400}}; color: {{text-100}}; }
.FooterAvatar[state="user3"] { background-color: {{text-300}}; color: {{bg-100}}; }

.FooterStatus { color: {{text-100}}; }

.FooterActionBtn {
    background-color: {{bg-400}};
    color: {{text-200}};
    border: 1px solid {{border-200}};
    border-radius: 8px;
    font-weight: bold;
}
.FooterActionBtn:hover { background-color: {{bg-200}}; }

.FooterCloseBtn {
    background-color: {{bg-400}};
    color: {{text-100}};
    border: 1px solid {{border-200}};
    border-radius: 8px;
    font-weight: bold;
}
.FooterCloseBtn:hover { color: white; }

.FooterSep { background-color: {{border-100}}; }

.FAB {
    background-color: {{primary-100}};
    color: white;
    border-radius: 28px;
    font-size: 24pt;
    font-weight: normal;
}
.FAB:hover { background-color: {{primary-200}}; }

/* ============ QScrollArea & Container Transparency Fix ============ */
.ReportScrollArea, 
.ReportScrollArea > QWidget > QWidget,
#list_container {
    background-color: transparent !important;
    border: none !important;
    background: none;
}

/* ============ PlusCheckBox Tristate Styles ============ */
/* Note: Since PlusCheckBox uses QPainter, QSS indicator styles are for fallback 
   or complementary styling if needed. However, per requirement, we define them. */
QCheckBox::indicator:indeterminate {
    /* the PLUS Piping Design System: Indeterminate state (-) */
    image: none;
    background-color: {{primary-100}};
    border: 1.5px solid {{primary-100}};
    border-radius: 4px;
    width: 20px;
    height: 20px;
}

/* ============ Report Center Joint Statistics ============ */
/* 윗줄 타이틀 스타일: 메인 텍스트보다 작고 직관적이게 세팅 */
QLabel.StatTitleLabel {
    font-family: {{font-sans-bold}};
    font-size: 9pt;            /* 타이틀은 한 텍스트 레벨 낮춰서 컴팩트하게 */
    color: {{text-100}};       /* 약간 더 차분한 그레이/뮤트 톤 */
    letter-spacing: 0.5px;
}

/* 아랫줄 수치 데이터 공통 스타일 */
QLabel[class^="StatValLabel_"] {
    font-family: {{font-grotesk}};
    font-size: 12pt;           /* 수치 데이터는 크게 강조 */
    font-weight: bold;
}

/* 개별 수치 색상 정의 */
QLabel[class="StatValLabel_Total"] {
    color: #FFFFFF;            /* 전체 수치는 선명한 화이트 */
}

QLabel[class="StatValLabel_Accept"] {
    color: #2ECC71;            /* 합격 수치는 모던 테마 그린 */
}

QLabel[class="StatValLabel_Reject"] {
    color: {{text-100}};       /* 기본 0개일 때는 비활성화 색상 */
}

/* 불합격(Reject)이 1개 이상 존재할 때 상단으로 강하게 강조 */
QLabel[class="StatValLabel_Reject"][hasWarning="true"] {
    color: #E74C3C;            /* 불합격 발생 시 선명한 경고 레드 */
}

/* ============ Report Right Info (Area & Location) ============ */
QLabel.AreaText {
    color: {{primary-100}};
    font-weight: bold;
}

QLabel.LocationText {
    color: {{text-200}};
    font-weight: bold;
}

/* ============ Report Center Filter Styles ============ */
QComboBox.FilterCombo {
    font-size: 10pt;
}

QComboBox.FilterCombo QAbstractItemView {
    font-size: 10pt;
}

/* ============ ThemeSkeletonCard ============ */
.ThemeSkeletonCard {
    background-color: {{bg-200}};
    border: 1px solid {{border-100}};
    border-radius: 8px;
}

/* ============ Dashboard Fixes ============ */
.DashboardTableHeader {
    background-color: {{bg-300}};
    border-bottom: 1px solid {{border-100}};
}

/* DashboardTable: 테이블 본체, 뷰포트, 헤더 뷰 배경 모두 bg-300 으로 통일 */
.DashboardTable,
.DashboardTable QWidget,
.DashboardTable QAbstractItemView,
QTableWidget.DashboardTable,
QTableWidget.DashboardTable QTableCornerButton::section {
    background-color: {{bg-300}};
    border: none;
}

/* 테이블 뷰포트(실제 셀 영역) 배경 */
QTableWidget.DashboardTable QAbstractScrollArea > QWidget,
.DashboardTable > QAbstractScrollArea > QWidget,
.DashboardTable QScrollArea > QWidget {
    background-color: {{bg-300}};
}

/* 헤더 뷰 배경 (object name 기반) */
QHeaderView#dashboard-header,
QHeaderView#dashboard-header::section {
    background-color: {{bg-200}};
    color: {{text-100}};
    font-weight: bold;
    font-size: 9pt;
    border: none;
    border-bottom: 1px solid {{border-100}};
    padding: 6px 8px;
}

/* 프로젝트 목록 스크롤 영역 배경 */
.DashboardScrollArea,
.DashboardScrollArea > QWidget,
.DashboardScrollArea QScrollArea > QWidget {
    background-color: {{bg-300}};
    border: none;
}

/* 스크롤 영역 뷰포트 명시적 배경 */
#DashboardProjectsScrollViewport,
#DashboardProjectsScrollArea > QWidget,
#DashboardProjectsContainer {
    background-color: {{bg-300}};
}

/* DashboardChartSurface: 차트 위젯 배경 (paintEvent에서 채우지만 QSS도 정의) */
.DashboardChartSurface {
    background-color: {{bg-300}};
    border: none;
}

/* DashboardCard: 내부 자식 위젯들의 배경이 투명하게 유지되도록 */
.DashboardCard > QWidget,
.DashboardCard QLabel,
.DashboardCard QFrame {
    background-color: transparent;
}

/* DashboardTitle, DashboardCardTitle */
.DashboardTitle {
    color: {{text-100}};
    font-weight: bold;
    font-size: 9pt;
    background: transparent;
    padding-left: 12px;
}
.DashboardCardTitle {
    color: {{text-200}};
    font-weight: bold;
    font-size: 12pt;
    background: transparent;
}

/* DashboardDateButton */
.DashboardDateButton {
    background-color: {{bg-200}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 9pt;
    font-weight: bold;
}
.DashboardDateButton:hover {
    background-color: {{bg-100}};
    border-color: {{primary-100}};
}

/* DashboardTableBtnPrimary / Secondary / Danger */
.DashboardTableBtnPrimary {
    background-color: {{primary-100}};
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 8pt;
    font-weight: bold;
}
.DashboardTableBtnPrimary:hover { background-color: {{accent-100}}; }

.DashboardTableBtnSecondary {
    background-color: {{bg-100}};
    color: {{text-100}};
    border: 1px solid {{border-100}};
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 8pt;
    font-weight: bold;
}
.DashboardTableBtnSecondary:hover { border-color: {{primary-100}}; color: {{primary-100}}; }

.DashboardTableBtnDanger {
    background-color: rgba(244, 63, 94, 0.15);
    color: #F43F5E;
    border: 1px solid rgba(244, 63, 94, 0.4);
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 8pt;
    font-weight: bold;
}
.DashboardTableBtnDanger:hover { background-color: rgba(244, 63, 94, 0.25); }

/* DashboardValueTiny */
.DashboardValueTiny {
    color: {{text-200}};
    font-size: 7pt;
    font-weight: bold;
    background: transparent;
}

/* DashboardSmallTitle */
.DashboardSmallTitle {
    color: {{text-100}};
    font-size: 9pt;
    background: transparent;
}

/* DashboardFooter */
