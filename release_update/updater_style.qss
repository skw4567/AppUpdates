#UpdaterWindow {
    background: transparent;
}

#BgFrame {
    background-color: #1a1c24;
    border-radius: 15px;
    border: 1px solid #33394d;
}

#TitleLabel {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 32pt;
    font-weight: bold;
    color: #ffffff;
}

#SubtitleLabel {
    font-size: 14pt;
    color: #3377ff;
    font-weight: 500;
}

#StatusLabel {
    color: #94a3b8;
    font-size: 10pt;
}

#UpdateProgressBar {
    min-height: 6px;
    background-color: #0f172a;
    border: none;
    border-radius: 3px;
}

#UpdateProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3377ff, stop:1 #60a5fa);
    border-radius: 3px;
}
